@model IEnumerable<InstituteOfFineArts.Models.Student>
@using InstituteOfFineArts.Models

@{
    ViewData["Title"] = "View Students";

    var students = Model?.ToList() ?? new List<Student>();
    var totalStudents = students.Count;
    var activeStudents = students.Count(s => s.IsActive);
    var totalSubmissions = students.Sum(s => s.Submissions?.Count ?? 0);
    var topPerformers = students.Count(s => (s.Submissions?.Count(x => x.Grade == SubmissionGrade.Best) ?? 0) > 0);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>View Students | Staff Panel | ARTISTIC Institute</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;400;500;600;700;800&family=Playfair+Display:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
