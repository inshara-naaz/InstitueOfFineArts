@model IEnumerable<InstituteOfFineArts.Models.Submission>
@using InstituteOfFineArts.Models

@{
    ViewData["Title"] = "View Postings";

    var submissions = Model?.ToList() ?? new List<Submission>();
    var total = submissions.Count;
    var pending = submissions.Count(s => s.Grade == SubmissionGrade.Pending);
    var evaluated = submissions.Count(s => s.Grade != SubmissionGrade.Pending);
    var best = submissions.Count(s => s.Grade == SubmissionGrade.Best);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Postings | Staff Panel</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body.dark-mode {
            background: #0A0A0A;
            color: #fff;
            font-family: 'Inter',sans-serif;
        }

        body.light-mode {
            background: #F0F2F5;
            color: #1A1A1A;
            font-family: 'Inter',sans-serif;
        }

        .app-wrapper {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            position: fixed;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            width: 70px;
            border-radius: 40px;
            transition: .3s;
            z-index: 1000;
            overflow: hidden;
            backdrop-filter: blur(12px);
            background: rgba(20,20,30,.9);
            border: 1px solid rgba(197,160,89,.15);
        }

            .sidebar:hover {
                width: 260px;
                border-radius: 28px;
            }

        .sidebar-inner {
            padding: 24px 0;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        .sidebar-profile {
            width: 100%;
            text-align: center;
            padding-bottom: 20px;
            margin-bottom: 20px;
            border-bottom: 1px solid rgba(255,255,255,.08);
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
        }

        .profile-avatar {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg,#C5A059,#E8C87A);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #000;
        }

        .profile-name, .profile-role, .nav-text, .logout-text {
            font-size: 0;
            opacity: 0;
            transition: .3s;
            white-space: nowrap;
        }

        .sidebar:hover .profile-name {
            font-size: .85rem;
            opacity: 1;
            margin-top: 12px;
        }

        .sidebar:hover .profile-role {
            font-size: .65rem;
            opacity: .6;
            margin-top: 4px;
        }

        .nav-menu {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 6px;
            padding: 0 12px;
        }

        .nav-item a, .logout-item a {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 12px;
            text-decoration: none;
            border-radius: 30px;
            color: rgba(255,255,255,.7);
            transition: .25s;
            white-space: nowrap;
        }

            .nav-item a i, .logout-item a i {
                width: 28px;
                display: flex;
                justify-content: center;
                color: #C5A059;
            }

        .sidebar:hover .nav-text, .sidebar:hover .logout-text {
            font-size: .85rem;
            opacity: 1;
        }

        .nav-item.active a, .nav-item:hover a {
            background: rgba(197,160,89,.15);
            color: #C5A059;
            transform: translateX(4px);
        }

        .nav-footer {
            width: 100%;
            margin-top: 30px;
            padding: 20px 12px 0;
            border-top: 1px solid rgba(255,255,255,.08);
        }

        .logout-item a i {
            color: #E53E3E;
        }

        .main-content {
            flex: 1;
            margin-left: 100px;
            padding: 24px 32px;
        }

        .top-header, .stat-card, .content-card, .posting-card {
            background: rgba(20,20,20,.7);
            border: 1px solid rgba(255,255,255,.06);
            border-radius: 24px;
        }

        .top-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            padding: 16px 24px;
            margin-bottom: 28px;
            flex-wrap: wrap;
        }

        .page-title h2 {
            font-family: 'Playfair Display',serif;
            font-size: 1.5rem;
            font-weight: 700;
            margin: 0;
        }

        .page-title p {
            font-size: .85rem;
            opacity: .7;
            margin: 0;
        }

        .theme-toggle, .user-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .theme-toggle {
            background: rgba(255,255,255,.08);
            color: #FFD700;
            cursor: pointer;
        }

        .user-avatar {
            background: linear-gradient(135deg,#C5A059,#E8C87A);
            color: #000;
        }

        .stat-card {
            padding: 1.5rem;
            height: 100%;
            transition: .3s;
        }

            .stat-card:hover, .posting-card:hover {
                transform: translateY(-4px);
                border-color: rgba(197,160,89,.45);
            }

        .stat-icon {
            font-size: 2rem;
            color: #C5A059;
            margin-bottom: .7rem;
        }

        .stat-value {
            font-size: 2rem;
            font-weight: 800;
        }

        .stat-label {
            font-size: .8rem;
            opacity: .75;
        }

        .content-card {
            padding: 1.5rem;
        }

        .chart-title {
            color: #C5A059;
            font-weight: 700;
            margin-bottom: 1rem;
            display: flex;
            gap: .5rem;
            align-items: center;
        }

        .filter-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
            margin-bottom: 1.2rem;
        }

        .search-box {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: .5rem 1rem;
            border-radius: 50px;
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.1);
        }

            .search-box input {
                background: transparent;
                border: none;
                outline: none;
                color: inherit;
                width: 250px;
            }

        .filter-select {
            background: rgba(255,255,255,.06);
            border: 1px solid #C5A059;
            border-radius: 50px;
            color: #fff;
            padding: .5rem 1rem;
        }

            .filter-select option {
                background: #1A1A2E;
                color: #fff;
            }

        .posting-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill,minmax(310px,1fr));
            gap: 1.2rem;
        }

        .posting-card {
            padding: 1rem;
            overflow: hidden;
        }

        .posting-img {
            width: 100%;
            height: 190px;
            object-fit: cover;
            border-radius: 18px;
            border: 1px solid rgba(197,160,89,.2);
            background: #222;
        }

        .posting-title {
            color: #E8C87A;
            font-family: 'Playfair Display',serif;
            font-size: 1.2rem;
            font-weight: 700;
            margin-top: .9rem;
        }

        .posting-meta {
            font-size: .82rem;
            opacity: .75;
            margin: .25rem 0;
        }

        .badge-grade {
            padding: .25rem .7rem;
            border-radius: 20px;
            font-size: .72rem;
            font-weight: 700;
            display: inline-block;
        }

        .grade-pending {
            background: #ffc107;
            color: #000;
        }

        .grade-best {
            background: #28a745;
            color: #fff;
        }

        .grade-disqualified {
            background: #dc3545;
            color: #fff;
        }

        .grade-other {
            background: #17a2b8;
            color: #fff;
        }

        .late-badge {
            background: #dc3545;
            color: #fff;
            padding: .2rem .6rem;
            border-radius: 20px;
            font-size: .68rem;
            font-weight: 700;
        }

        .btn-gold {
            background: linear-gradient(135deg,#C5A059,#E8C87A);
            color: #000;
            border: none;
            padding: .5rem 1rem;
            border-radius: 50px;
            font-weight: 700;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            cursor: pointer;
        }

            .btn-gold:hover {
                color: #000;
                transform: translateY(-1px);
            }

        .text-muted-custom {
            color: rgba(255,255,255,.65);
        }

        .modal-custom {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 2000;
            background: rgba(0,0,0,.72);
            backdrop-filter: blur(8px);
            align-items: center;
            justify-content: center;
        }

            .modal-custom.active {
                display: flex;
            }

        .modal-content-custom {
            width: 92%;
            max-width: 760px;
            max-height: 90vh;
            overflow-y: auto;
            border-radius: 28px;
            background: #1A1A2E;
            border: 1px solid rgba(197,160,89,.2);
            padding: 2rem;
            position: relative;
        }

        .modal-close {
            position: absolute;
            top: 15px;
            right: 20px;
            font-size: 1.6rem;
            color: #fff;
            background: none;
            border: none;
            cursor: pointer;
        }

        .detail-img {
            width: 100%;
            max-height: 360px;
            object-fit: contain;
            border-radius: 18px;
            border: 1px solid rgba(197,160,89,.25);
            background: #111;
            margin-bottom: 1rem;
        }

        .detail-box {
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 16px;
            padding: 1rem;
            margin: .7rem 0;
        }

        @@media(max-width:992px) {
            .main-content {
                margin-left: 0;
                padding: 16px;
            }

            .sidebar {
                left: -70px;
            }
        }

        @@media(max-width:768px) {
            .search-box, .search-box input, .filter-select {
                width: 100%;
            }

            .filter-row {
                align-items: stretch;
            }
        }
    </style>
</head>
<body class="dark-mode">
    <div class="app-wrapper">
        <div class="sidebar">
            <div class="sidebar-inner">
                <div class="sidebar-profile" onclick="goToHome()">
                    <div class="profile-avatar"><i class="fas fa-palette"></i></div>
                    <div class="profile-name">ARTISTIC</div>
                    <div class="profile-role">Staff Panel</div>
                </div>
                <div class="nav-menu">
                    <div class="nav-item"><a href="@Url.Action("Dashboard", "Staff")"><i class="fas fa-home"></i><span class="nav-text">Dashboard</span></a></div>
                    <div class="nav-item"><a href="@Url.Action("ViewStudents", "Staff")"><i class="fas fa-users"></i><span class="nav-text">View Students</span></a></div>
                    <div class="nav-item"><a href="@Url.Action("ManageCompetitions", "Staff")"><i class="fas fa-trophy"></i><span class="nav-text">Competitions</span></a></div>
                    <div class="nav-item"><a href="@Url.Action("ManageExhibitions", "Staff")"><i class="fas fa-building"></i><span class="nav-text">Exhibitions</span></a></div>
                    <div class="nav-item active"><a href="@Url.Action("ViewPostings", "Staff")"><i class="fas fa-clipboard-list"></i><span class="nav-text">View Postings</span></a></div>
                    <div class="nav-item"><a href="@Url.Action("MarkPostings", "Staff")"><i class="fas fa-check-double"></i><span class="nav-text">Mark Postings</span></a></div>
                    <div class="nav-item"><a href="@Url.Action("SendtoExhibition", "Staff")"><i class="fas fa-paper-plane"></i><span class="nav-text">Send to Exhibition</span></a></div>
                    <div class="nav-item"><a href="@Url.Action("ExhibitionStatus", "Staff")"><i class="fas fa-chart-line"></i><span class="nav-text">Exhibition Status</span></a></div>
                </div>
                <div class="nav-footer">
                    <div class="logout-item"><a href="@Url.Action("Login", "Account")"><i class="fas fa-sign-out-alt"></i><span class="logout-text">Logout</span></a></div>
                </div>
            </div>
        </div>

        <div class="main-content">
            <div class="top-header">
                <div class="page-title">
                    <h2><i class="fas fa-clipboard-list me-2" style="color:#C5A059"></i>Student Postings</h2>
                    <p>View all submitted artworks from students with grade, remarks and competition details.</p>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <a class="btn-gold" href="@Url.Action("MarkPostings", "Staff")"><i class="fas fa-check-double"></i> Mark Postings</a>
                    <div class="theme-toggle" id="themeToggle"><i class="fas fa-sun" id="themeIcon"></i></div>
                    <div class="user-avatar"><i class="fas fa-user-tie"></i></div>
                </div>
            </div>

            <div class="container-fluid mt-4">
                <div class="row g-4 mb-4">
                    <div class="col-xl-3 col-md-6"><div class="stat-card"><div class="stat-icon"><i class="fas fa-palette"></i></div><div class="stat-value">@total</div><div class="stat-label">Total Submissions</div></div></div>
                    <div class="col-xl-3 col-md-6"><div class="stat-card"><div class="stat-icon"><i class="fas fa-clock"></i></div><div class="stat-value">@pending</div><div class="stat-label">Pending</div></div></div>
                    <div class="col-xl-3 col-md-6"><div class="stat-card"><div class="stat-icon"><i class="fas fa-check-circle"></i></div><div class="stat-value">@evaluated</div><div class="stat-label">Evaluated</div></div></div>
                    <div class="col-xl-3 col-md-6"><div class="stat-card"><div class="stat-icon"><i class="fas fa-star"></i></div><div class="stat-value">@best</div><div class="stat-label">Best</div></div></div>
                </div>

                <div class="content-card">
                    <div class="chart-title"><i class="fas fa-list"></i> Recent Student Submissions</div>

                    <div class="filter-row">
                        <div class="search-box">
                            <i class="fas fa-search"></i>
                            <input type="text" id="searchInput" placeholder="Search title, student, competition...">
                        </div>

                        <select class="filter-select" id="gradeFilter">
                            <option value="all">All Grades</option>
                            <option value="pending">Pending</option>
                            <option value="best">Best</option>
                            <option value="better">Better</option>
                            <option value="good">Good</option>
                            <option value="moderate">Moderate</option>
                            <option value="normal">Normal</option>
                            <option value="disqualified">Disqualified</option>
                        </select>
                    </div>

                    @if (submissions.Any())
                    {
                        <div class="posting-grid" id="postingGrid">
                            @foreach (var item in submissions)
                            {
                                var gradeLower = item.Grade.ToString().ToLower();
                                var gradeClass = item.Grade == SubmissionGrade.Pending ? "grade-pending" :
                                item.Grade == SubmissionGrade.Best ? "grade-best" :
                                item.Grade == SubmissionGrade.Disqualified ? "grade-disqualified" :
                                "grade-other";

                                var studentName = item.Student == null ? "Student" : $"{item.Student.FirstName} {item.Student.LastName}";
                                var competitionTitle = item.Competition?.Title ?? "Competition";
                                var searchText = $"{item.PaintingTitle} {studentName} {competitionTitle} {item.TextType}".ToLower();

                                <div class="posting-card" data-grade="@gradeLower" data-search="@searchText">
                                    <img src="@item.ImageFilePath" class="posting-img" alt="@item.PaintingTitle" onerror="this.src='https://placehold.co/500x300/1A1A2E/C5A059?text=Artwork'" />

                                    <div class="posting-title">@item.PaintingTitle</div>
                                    <div class="posting-meta"><i class="fas fa-user me-1"></i> @studentName</div>
                                    <div class="posting-meta"><i class="fas fa-trophy me-1"></i> @competitionTitle</div>
                                    <div class="posting-meta"><i class="far fa-calendar-alt me-1"></i> @item.SubmittedAt.ToString("dd MMM yyyy")</div>

                                    <div class="mt-2">
                                        <span class="badge-grade @gradeClass">@item.Grade</span>
                                        @if (item.IsLateSubmission)
                                        {
                                            <span class="late-badge ms-1">Late</span>
                                        }
                                    </div>

                                    <p class="text-muted-custom mt-3 mb-2">
                                        @item.TextType:
                                        @(item.AccompanyingText?.Length > 120 ? item.AccompanyingText.Substring(0, 120) + "..." : item.AccompanyingText)
                                    </p>

                                    <div class="d-flex gap-2 flex-wrap mt-2">
                                        <button class="btn-gold" type="button" onclick="openModal('details_@item.SubmissionId')">
                                            <i class="fas fa-eye"></i> View
                                        </button>
                                        <a class="btn-gold" href="@Url.Action("MarkPostings", "Staff")">
                                            <i class="fas fa-marker"></i> Evaluate
                                        </a>
                                    </div>
                                </div>

                                <div class="modal-custom" id="details_@item.SubmissionId">
                                    <div class="modal-content-custom">
                                        <button class="modal-close" type="button" onclick="closeModal('details_@item.SubmissionId')">&times;</button>
                                        <h3 style="color:#C5A059;">@item.PaintingTitle</h3>

                                        <img src="@item.ImageFilePath" class="detail-img" onerror="this.src='https://placehold.co/800x450/1A1A2E/C5A059?text=Artwork'" />

                                        <div class="detail-box">
                                            <strong>Student:</strong> @studentName<br />
                                            <strong>Competition:</strong> @competitionTitle<br />
                                            <strong>Submitted At:</strong> @item.SubmittedAt.ToString("dd MMM yyyy hh:mm tt")<br />
                                            <strong>Grade:</strong> @item.Grade<br />
                                            <strong>File:</strong> @(item.OriginalFileName ?? "-")<br />
                                            <strong>Size:</strong> @(item.FileSizeInBytes > 0 ? $"{item.FileSizeInBytes / 1024} KB" : "-")
                                        </div>

                                        <div class="detail-box">
                                            <strong>@item.TextType:</strong><br />
                                            @item.AccompanyingText
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(item.CreativeDescription))
                                        {
                                            <div class="detail-box">
                                                <strong>Creative Description:</strong><br />
                                                @item.CreativeDescription
                                            </div>
                                        }

                                        @if (item.Evaluation != null)
                                        {
                                            <div class="detail-box">
                                                <strong>Staff Remarks:</strong><br />
                                                <strong>Positive:</strong> @(item.Evaluation.PositivePoints ?? "-")<br />
                                                <strong>Negative:</strong> @(item.Evaluation.NegativePoints ?? "-")<br />
                                                <strong>Improvement:</strong> @(item.Evaluation.AreasOfImprovement ?? "-")<br />
                                                <strong>General Remarks:</strong> @(item.Evaluation.GeneralRemarks ?? "-")
                                            </div>
                                        }

                                        <div class="mt-3">
                                            <a class="btn-gold" href="@Url.Action("MarkPostings", "Staff")">
                                                <i class="fas fa-marker"></i> Go to Mark Postings
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div id="noResults" class="text-center py-5" style="display:none;">
                            <i class="fas fa-search display-1" style="color:#C5A059"></i>
                            <h4 class="mt-3">No matching submissions found</h4>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-inbox display-1" style="color:#C5A059"></i>
                            <h4 class="mt-3">No submissions found</h4>
                            <p class="text-muted-custom">Student postings will appear here after upload.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <script>
        const body = document.body;
        const themeToggle = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');

        if (localStorage.getItem('staffTheme') === 'light') {
            body.classList.remove('dark-mode');
            body.classList.add('light-mode');
            if (themeIcon) {
                themeIcon.classList.remove('fa-sun');
                themeIcon.classList.add('fa-moon');
            }
        }

        if (themeToggle) {
            themeToggle.addEventListener('click', () => {
                if (body.classList.contains('dark-mode')) {
                    body.classList.remove('dark-mode');
                    body.classList.add('light-mode');
                    localStorage.setItem('staffTheme', 'light');
                    themeIcon.classList.remove('fa-sun');
                    themeIcon.classList.add('fa-moon');
                } else {
                    body.classList.remove('light-mode');
                    body.classList.add('dark-mode');
                    localStorage.setItem('staffTheme', 'dark');
                    themeIcon.classList.remove('fa-moon');
                    themeIcon.classList.add('fa-sun');
                }
            });
        }

        function goToHome() {
            window.location.href = '@Url.Action("Index", "Home")';
        }

        function openModal(id) {
            const modal = document.getElementById(id);
            if (modal) {
                modal.classList.add('active');
                document.body.style.overflow = 'hidden';
            }
        }

        function closeModal(id) {
            const modal = document.getElementById(id);
            if (modal) {
                modal.classList.remove('active');
                document.body.style.overflow = 'auto';
            }
        }

        const searchInput = document.getElementById('searchInput');
        const gradeFilter = document.getElementById('gradeFilter');

        function applyFilters() {
            const search = (searchInput?.value || '').toLowerCase().trim();
            const grade = gradeFilter?.value || 'all';
            const cards = document.querySelectorAll('.posting-card');
            let visibleCount = 0;

            cards.forEach(card => {
                const cardSearch = card.getAttribute('data-search') || '';
                const cardGrade = card.getAttribute('data-grade') || '';

                const matchesSearch = search === '' || cardSearch.includes(search);
                const matchesGrade = grade === 'all' || cardGrade === grade;

                if (matchesSearch && matchesGrade) {
                    card.style.display = '';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            const noResults = document.getElementById('noResults');
            if (noResults) noResults.style.display = visibleCount === 0 && cards.length > 0 ? 'block' : 'none';
        }

        if (searchInput) searchInput.addEventListener('input', applyFilters);
        if (gradeFilter) gradeFilter.addEventListener('change', applyFilters);
    </script>
</body>
</html>
