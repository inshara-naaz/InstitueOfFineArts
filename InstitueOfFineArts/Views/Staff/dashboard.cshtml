@{
    ViewData["Title"] = "Staff Dashboard";

    int studentCount = ViewBag.StudentCount == null ? 0 : Convert.ToInt32(ViewBag.StudentCount);
    int competitionCount = ViewBag.CompetitionCount == null ? 0 : Convert.ToInt32(ViewBag.CompetitionCount);
    int submissionCount = ViewBag.SubmissionCount == null ? 0 : Convert.ToInt32(ViewBag.SubmissionCount);
    int exhibitionCount = ViewBag.ExhibitionCount == null ? 0 : Convert.ToInt32(ViewBag.ExhibitionCount);

    int pendingSubmissionCount = ViewBag.PendingSubmissionCount == null ? 0 : Convert.ToInt32(ViewBag.PendingSubmissionCount);
    int reviewedSubmissionCount = ViewBag.ReviewedSubmissionCount == null ? 0 : Convert.ToInt32(ViewBag.ReviewedSubmissionCount);
    int bestSubmissionCount = ViewBag.BestSubmissionCount == null ? 0 : Convert.ToInt32(ViewBag.BestSubmissionCount);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Staff Dashboard | ARTISTIC Institute</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;400;500;600;700;800&family=Playfair+Display:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body.dark-mode {
            background: #0A0A0A;
            color: #FFFFFF;
        }

        body.light-mode {
            background: #F0F2F5;
            color: #1A1A1A;
        }

        .app-wrapper {
            display: flex;
            min-height: 100vh;
            position: relative;
        }

        /* ========== SIDEBAR ========== */
        .sidebar {
            position: fixed;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            width: 70px;
            border-radius: 40px;
            transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
            z-index: 1000;
            overflow: hidden;
            backdrop-filter: blur(12px);
        }

            .sidebar:hover {
                width: 260px;
                border-radius: 28px;
            }

        body.dark-mode .sidebar {
            background: rgba(20, 20, 30, 0.9);
            border: 1px solid rgba(197, 160, 89, 0.15);
            box-shadow: 0 20px 40px rgba(0,0,0,0.3);
        }

        body.light-mode .sidebar {
            background: rgba(255, 255, 255, 0.95);
            border: 1px solid rgba(0,0,0,0.08);
            box-shadow: 0 20px 40px rgba(0,0,0,0.08);
        }

        @@media (max-width: 992px) {
            .sidebar {
                left: -70px;
            }

                .sidebar.active {
                    left: 20px;
                }

            .menu-toggle {
                display: block !important;
            }

            .main-content {
                margin-left: 0 !important;
                width: 100%;
                padding: 16px !important;
            }
        }

        .sidebar-inner {
            padding: 24px 0;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        .sidebar-profile {
            width: 100%;
            text-align: center;
            padding: 0 0 20px 0;
            margin-bottom: 20px;
            border-bottom: 1px solid;
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .sidebar-profile:hover {
                opacity: 0.8;
            }

        body.dark-mode .sidebar-profile {
            border-color: rgba(255,255,255,0.08);
        }

        body.light-mode .sidebar-profile {
            border-color: rgba(0,0,0,0.06);
        }

        .profile-avatar {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg, #C5A059, #E8C87A);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            color: #000;
            transition: all 0.3s ease;
        }

        .sidebar:hover .profile-avatar {
            width: 50px;
            height: 50px;
            font-size: 1.4rem;
        }

        .profile-name {
            margin-top: 10px;
            font-size: 0;
            opacity: 0;
            transition: all 0.3s ease;
            white-space: nowrap;
        }

        .sidebar:hover .profile-name {
            font-size: 0.85rem;
            opacity: 1;
            margin-top: 12px;
        }

        .profile-role {
            margin-top: 4px;
            font-size: 0;
            opacity: 0;
            transition: all 0.3s ease;
            white-space: nowrap;
        }

        .sidebar:hover .profile-role {
            font-size: 0.65rem;
            opacity: 0.6;
        }

        .nav-menu {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 6px;
            padding: 0 12px;
        }

        .nav-item {
            width: 100%;
            border-radius: 30px;
            transition: all 0.25s ease;
        }

            .nav-item a {
                display: flex;
                align-items: center;
                gap: 16px;
                padding: 12px;
                text-decoration: none;
                border-radius: 30px;
                transition: all 0.25s ease;
                font-weight: 500;
                white-space: nowrap;
            }

                .nav-item a i {
                    width: 28px;
                    height: 28px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 1.1rem;
                    color: #C5A059;
                    flex-shrink: 0;
                }

        .nav-text {
            font-size: 0;
            opacity: 0;
            transition: all 0.3s ease;
            overflow: hidden;
        }

        .sidebar:hover .nav-text {
            font-size: 0.85rem;
            opacity: 1;
        }

        body.dark-mode .nav-item a {
            color: rgba(255,255,255,0.7);
        }

        body.light-mode .nav-item a {
            color: #4A5568;
        }

        .nav-item:hover a {
            transform: translateX(4px);
        }

        body.dark-mode .nav-item:hover a {
            background: rgba(197,160,89,0.12);
            color: #C5A059;
        }

        body.light-mode .nav-item:hover a {
            background: rgba(197,160,89,0.08);
            color: #C5A059;
        }

        body.dark-mode .nav-item.active a {
            background: rgba(197,160,89,0.15);
            color: #C5A059;
        }

        body.light-mode .nav-item.active a {
            background: rgba(197,160,89,0.1);
            color: #C5A059;
        }

        .nav-footer {
            width: 100%;
            margin-top: 30px;
            padding: 20px 12px 0;
            border-top: 1px solid;
        }

        body.dark-mode .nav-footer {
            border-color: rgba(255,255,255,0.08);
        }

        body.light-mode .nav-footer {
            border-color: rgba(0,0,0,0.06);
        }

        .logout-item {
            width: 100%;
            border-radius: 30px;
        }

            .logout-item a {
                display: flex;
                align-items: center;
                gap: 16px;
                padding: 12px;
                text-decoration: none;
                border-radius: 30px;
                transition: all 0.25s ease;
                white-space: nowrap;
            }

                .logout-item a i {
                    width: 28px;
                    font-size: 1.1rem;
                    flex-shrink: 0;
                }

        body.dark-mode .logout-item a {
            color: rgba(255,255,255,0.7);
        }

        body.light-mode .logout-item a {
            color: #E53E3E;
        }

        .logout-text {
            font-size: 0;
            opacity: 0;
            transition: all 0.3s ease;
        }

        .sidebar:hover .logout-text {
            font-size: 0.85rem;
            opacity: 1;
        }

        .logout-item:hover a {
            transform: translateX(4px);
        }

        body.dark-mode .logout-item:hover a {
            background: rgba(229,62,62,0.15);
            color: #E53E3E;
        }

        body.light-mode .logout-item:hover a {
            background: #FEE2E2;
            color: #E53E3E;
        }

        /* Main Content */
        .main-content {
            flex: 1;
            margin-left: 100px;
            padding: 24px 32px;
            overflow-x: hidden;
            transition: all 0.3s ease;
        }

        @@media (max-width: 992px) {
            .main-content {
                margin-left: 0;
            }
        }

        .top-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            padding: 12px 24px;
            border-radius: 24px;
            margin-bottom: 28px;
        }

        body.dark-mode .top-header {
            background: rgba(20,20,20,0.7);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.05);
        }

        body.light-mode .top-header {
            background: #FFFFFF;
            border: 1px solid #E8ECEF;
            box-shadow: 0 2px 8px rgba(0,0,0,0.02);
        }

        .menu-toggle {
            display: none;
            background: transparent;
            border: none;
            font-size: 1.4rem;
            cursor: pointer;
            padding: 8px 12px;
            border-radius: 12px;
        }

        body.dark-mode .menu-toggle {
            color: white;
        }

        body.light-mode .menu-toggle {
            color: #333;
        }

        .page-title h2 {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            font-weight: 700;
        }

        .page-title p {
            font-size: 0.8rem;
            opacity: 0.7;
        }

        .theme-toggle {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        body.dark-mode .theme-toggle {
            background: rgba(255,255,255,0.08);
            color: #FFD700;
        }

        body.light-mode .theme-toggle {
            background: #F0F2F5;
            color: #C5A059;
        }

        .theme-toggle:hover {
            transform: rotate(15deg);
        }

        .user-dropdown {
            position: relative;
            cursor: pointer;
        }

        .user-avatar {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg, #C5A059, #E8C87A);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            color: #000;
        }

        .dropdown-menu-custom {
            position: absolute;
            top: 50px;
            right: 0;
            min-width: 160px;
            border-radius: 16px;
            padding: 8px;
            display: none;
            z-index: 100;
        }

        body.dark-mode .dropdown-menu-custom {
            background: #1A1A2E;
            border: 1px solid rgba(197,160,89,0.2);
        }

        body.light-mode .dropdown-menu-custom {
            background: white;
            border: 1px solid #E8ECEF;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        .user-dropdown:hover .dropdown-menu-custom {
            display: block;
        }

        .dropdown-item {
            padding: 10px 14px;
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            border-radius: 12px;
            transition: 0.2s;
        }

        body.dark-mode .dropdown-item {
            color: white;
        }

        body.light-mode .dropdown-item {
            color: #333;
        }

        .dropdown-item:hover {
            background: rgba(197,160,89,0.15);
        }

        /* Cards */
        .stat-card, .chart-card, .recent-table {
            border-radius: 24px;
            padding: 1.5rem;
            transition: all 0.3s ease;
            height: 100%;
        }

        body.dark-mode .stat-card,
        body.dark-mode .chart-card,
        body.dark-mode .recent-table {
            background: rgba(20,20,20,0.7);
            border: 1px solid rgba(255,255,255,0.05);
        }

        body.light-mode .stat-card,
        body.light-mode .chart-card,
        body.light-mode .recent-table {
            background: #FFFFFF;
            border: 1px solid #E8ECEF;
            box-shadow: 0 2px 8px rgba(0,0,0,0.02);
        }

        .stat-card:hover, .chart-card:hover {
            transform: translateY(-3px);
        }

        .stat-icon {
            font-size: 2rem;
            color: #C5A059;
            margin-bottom: 0.8rem;
        }

        .stat-value {
            font-size: 2rem;
            font-weight: 700;
        }

        .stat-label {
            font-size: 0.8rem;
            opacity: 0.7;
        }

        .trend-up {
            color: #28a745;
            font-size: 0.7rem;
            margin-top: 0.5rem;
        }

        .chart-title {
            font-weight: 600;
            margin-bottom: 1rem;
            color: #C5A059;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .chart-container {
            position: relative;
            height: 250px;
        }

        /* Progress Bars */
        .category-list, .country-list {
            display: flex;
            flex-direction: column;
            gap: 0.8rem;
        }

        .category-item, .country-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .category-name, .country-name {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .category-color {
            width: 12px;
            height: 12px;
            border-radius: 3px;
        }

        .progress-bar-custom {
            background: rgba(0,0,0,0.08);
            border-radius: 10px;
            height: 6px;
            overflow: hidden;
        }

        body.dark-mode .progress-bar-custom {
            background: rgba(255,255,255,0.1);
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #C5A059, #E8C87A);
            border-radius: 10px;
        }

        /* Activity */
        .activity-timeline {
            display: flex;
            flex-direction: column;
            gap: 0.8rem;
        }

        .activity-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px;
            border-radius: 14px;
            transition: all 0.3s ease;
        }

            .activity-item:hover {
                background: rgba(197,160,89,0.06);
            }

        .activity-icon {
            width: 36px;
            height: 36px;
            background: rgba(197,160,89,0.12);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #C5A059;
        }

        .activity-detail {
            flex: 1;
        }

        .activity-title {
            font-size: 0.85rem;
            font-weight: 500;
        }

        .activity-time {
            font-size: 0.7rem;
            opacity: 0.6;
        }

        /* Quick Actions */
        .quick-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 0.8rem;
        }

        .quick-btn {
            border-radius: 40px;
            padding: 0.5rem 1.2rem;
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 0.8rem;
            font-weight: 500;
        }

        body.dark-mode .quick-btn {
            background: rgba(197,160,89,0.1);
            border: 1px solid rgba(197,160,89,0.2);
            color: white;
        }

        body.light-mode .quick-btn {
            background: #F0F2F5;
            border: 1px solid #E8ECEF;
            color: #333;
        }

        .quick-btn:hover {
            transform: translateY(-2px);
        }

        body.dark-mode .quick-btn:hover {
            background: rgba(197,160,89,0.2);
        }

        /* Table */
        .table-custom {
            width: 100%;
            border-collapse: collapse;
        }

            .table-custom th, .table-custom td {
                padding: 0.8rem 0.5rem;
                text-align: left;
                border-bottom: 1px solid;
            }

        body.dark-mode .table-custom th, body.dark-mode .table-custom td {
            border-color: rgba(255,255,255,0.06);
        }

        body.light-mode .table-custom th, body.light-mode .table-custom td {
            border-color: #E8ECEF;
        }

        .table-custom th {
            color: #C5A059;
            font-weight: 600;
        }

        .badge-status {
            padding: 0.2rem 0.7rem;
            border-radius: 30px;
            font-size: 0.7rem;
            font-weight: 600;
            display: inline-block;
        }

        .badge-pending {
            background: #ffc107;
            color: #000;
        }

        .badge-approved {
            background: #28a745;
            color: white;
        }

        .badge-reviewed {
            background: #17a2b8;
            color: white;
        }

        .btn-sm {
            background: linear-gradient(135deg, #C5A059, #E8C87A);
            border: none;
            padding: 0.25rem 0.8rem;
            border-radius: 20px;
            color: #000;
            font-weight: 600;
            cursor: pointer;
        }

        .footer {
            padding: 1rem;
            margin-top: 2rem;
            text-align: center;
            border-radius: 20px;
            font-size: 0.7rem;
        }

        body.dark-mode .footer {
            background: rgba(20,20,20,0.5);
            color: rgba(255,255,255,0.4);
        }

        body.light-mode .footer {
            background: #FFFFFF;
            color: #8A8A8A;
            border: 1px solid #E8ECEF;
        }

        .scroll-top {
            position: fixed;
            bottom: 20px;
            right: 20px;
            width: 45px;
            height: 45px;
            background: linear-gradient(135deg, #C5A059, #E8C87A);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
            border: none;
            z-index: 999;
        }

            .scroll-top.show {
                opacity: 1;
                visibility: visible;
            }

        /* Modal */
        .modal-custom {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.7);
            backdrop-filter: blur(8px);
            z-index: 2000;
            align-items: center;
            justify-content: center;
        }

            .modal-custom.active {
                display: flex;
            }

        .modal-content-custom {
            width: 90%;
            max-width: 500px;
            max-height: 85vh;
            overflow-y: auto;
            border-radius: 28px;
            padding: 2rem;
            position: relative;
        }

        body.dark-mode .modal-content-custom {
            background: #1A1A2E;
            border: 1px solid rgba(197,160,89,0.2);
        }

        body.light-mode .modal-content-custom {
            background: white;
            border: 1px solid #E8ECEF;
        }

        .modal-close {
            position: absolute;
            top: 15px;
            right: 20px;
            font-size: 1.5rem;
            cursor: pointer;
            background: none;
            border: none;
            transition: all 0.3s ease;
        }

            .modal-close:hover {
                transform: rotate(90deg);
                color: #C5A059;
            }

        .form-group {
            margin-bottom: 1rem;
        }

            .form-group label {
                display: block;
                margin-bottom: 0.4rem;
                font-size: 0.8rem;
                font-weight: 500;
            }

        .form-control, .form-select {
            width: 100%;
            padding: 0.7rem 1rem;
            border-radius: 14px;
            transition: all 0.3s ease;
        }

        .form-select {
            cursor: pointer;
            appearance: auto;
            -webkit-appearance: menulist;
            -moz-appearance: menulist;
        }

            .form-select option {
                padding: 10px;
                display: block;
            }

        body.dark-mode .form-control, body.dark-mode .form-select {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(197,160,89,0.3);
            color: white;
        }

            body.dark-mode .form-select option {
                background: #1A1A2E;
                color: white;
            }

        body.light-mode .form-control, body.light-mode .form-select {
            background: #F0F2F5;
            border: 1px solid #E8ECEF;
            color: #333;
        }

            body.light-mode .form-select option {
                background: white;
                color: #333;
            }

        .btn-gold {
            background: linear-gradient(135deg, #C5A059, #E8C87A);
            color: #000;
            border: none;
            padding: 0.6rem 1.5rem;
            border-radius: 50px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .btn-gold:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(197,160,89,0.3);
            }

        /* SweetAlert2 Dark Mode Fix */
        body.dark-mode .swal2-popup {
            background: #1A1A2E !important;
            color: #FFFFFF !important;
            border: 1px solid rgba(197,160,89,0.2) !important;
            border-radius: 24px !important;
        }

        body.dark-mode .swal2-title {
            color: #FFFFFF !important;
        }

        body.dark-mode .swal2-html-container {
            color: #CCCCCC !important;
        }

        body.dark-mode .swal2-input, body.dark-mode .swal2-textarea, body.dark-mode .swal2-select {
            background: rgba(255,255,255,0.08) !important;
            border: 1px solid rgba(197,160,89,0.3) !important;
            color: #FFFFFF !important;
            border-radius: 12px !important;
        }

            body.dark-mode .swal2-select option {
                background: #1A1A2E !important;
                color: #FFFFFF !important;
            }

        body.dark-mode .swal2-styled.swal2-cancel {
            background: #3A3A5E !important;
            color: #FFFFFF !important;
        }

        body.light-mode .swal2-popup {
            background: #FFFFFF !important;
            color: #1A1A1A !important;
            border: 1px solid #E8ECEF !important;
        }

        body.light-mode .swal2-input, body.light-mode .swal2-textarea, body.light-mode .swal2-select {
            background: #F0F2F5 !important;
            border: 1px solid #E8ECEF !important;
            color: #1A1A1A !important;
        }

        @@media (max-width: 768px) {
            .quick-actions {
                flex-direction: column;
            }
        }
    </style>
</head>
<body class="dark-mode">

    <div class="app-wrapper">
        <!-- SIDEBAR -->
        <div class="sidebar">
            <div class="sidebar-inner">
                <div class="sidebar-profile" onclick="goToHome()">
                    <div class="profile-avatar"><i class="fas fa-palette"></i></div>
                    <div class="profile-name">ARTISTIC</div>
                    <div class="profile-role">Staff Panel</div>
                </div>

                <div class="nav-menu">
