        </div>

        <div class="main-content">
            <div class="top-header">
                <button class="menu-toggle" id="menuToggle"><i class="fas fa-bars"></i></button>
                <div class="page-title">
                    <h2>Staff Dashboard</h2>
                    <p>Welcome back, Staff! Manage competitions, evaluate submissions, and organize exhibitions.</p>
                </div>
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <div class="theme-toggle" id="themeToggle"><i class="fas fa-sun" id="themeIcon"></i></div>
                    <div class="user-dropdown">
                        <div class="user-avatar"><i class="fas fa-user-tie"></i></div>
                        <div class="dropdown-menu-custom">
                            <a href="#" class="dropdown-item" onclick="logout()"><i class="fas fa-sign-out-alt"></i> Logout</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="container-fluid mt-4">
                <!-- Stats Cards -->
                <div class="row g-4 mb-4">
                    <div class="col-xl-3 col-md-6" data-aos="fade-up" data-aos-delay="100">
                        <div class="stat-card">
                            <div class="stat-icon"><i class="fas fa-user-graduate"></i></div>
                            <div class="stat-value">@studentCount</div>
                            <div class="stat-label">Total Students</div>
                            <div class="trend-up">Registered students in database</div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6" data-aos="fade-up" data-aos-delay="200">
                        <div class="stat-card">
                            <div class="stat-icon"><i class="fas fa-trophy"></i></div>
                            <div class="stat-value">@competitionCount</div>
                            <div class="stat-label">Total Competitions</div>
                            <div class="trend-up">Competitions in database</div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6" data-aos="fade-up" data-aos-delay="300">
                        <div class="stat-card">
                            <div class="stat-icon"><i class="fas fa-palette"></i></div>
                            <div class="stat-value">@submissionCount</div>
                            <div class="stat-label">Total Submissions</div>
                            <div class="trend-up">Submitted artworks in database</div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6" data-aos="fade-up" data-aos-delay="400">
                        <div class="stat-card">
                            <div class="stat-icon"><i class="fas fa-building"></i></div>
                            <div class="stat-value">@exhibitionCount</div>
                            <div class="stat-label">Total Exhibitions</div>
                            <div class="trend-up">Exhibitions in database</div>
                        </div>
                    </div>
                </div>

                <!-- Charts -->
                <div class="row g-4 mb-4">
                    <div class="col-lg-8">
                        <div class="chart-card">
                            <div class="chart-title"><i class="fas fa-chart-line"></i> Monthly Submissions Trend</div>
                            <div class="chart-container"><canvas id="submissionsChart"></canvas></div>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="chart-card">
                            <div class="chart-title"><i class="fas fa-chart-pie"></i> Submission Status</div>
                            <div class="chart-container"><canvas id="statusChart"></canvas></div>
                        </div>
                    </div>
                </div>

                <!-- Category & Evaluation Distribution -->
                <div class="row g-4 mb-4">
                    <div class="col-lg-6">
                        <div class="chart-card">
                            <div class="chart-title"><i class="fas fa-chart-simple"></i> Submissions by Category</div>
                            <div class="category-list">
                                <div><div class="category-item"><div class="category-name"><div class="category-color" style="background: #C5A059;"></div><span>Painting</span></div><div>38%</div></div><div class="progress-bar-custom"><div class="progress-fill" style="width: 38%;"></div></div></div>
                                <div><div class="category-item"><div class="category-name"><div class="category-color" style="background: #E8C87A;"></div><span>Digital Art</span></div><div>30%</div></div><div class="progress-bar-custom"><div class="progress-fill" style="width: 30%;"></div></div></div>
                                <div><div class="category-item"><div class="category-name"><div class="category-color" style="background: #A8883A;"></div><span>Animation</span></div><div>20%</div></div><div class="progress-bar-custom"><div class="progress-fill" style="width: 20%;"></div></div></div>
                                <div><div class="category-item"><div class="category-name"><div class="category-color" style="background: #8A8A8A;"></div><span>Sketches</span></div><div>12%</div></div><div class="progress-bar-custom"><div class="progress-fill" style="width: 12%;"></div></div></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="chart-card">
                            <div class="chart-title"><i class="fas fa-star"></i> Evaluation Status</div>
                            <div class="category-list">
                                <div><div class="category-item"><div class="category-name"><div class="category-color" style="background: #28a745;"></div><span>Best</span></div><div>@bestSubmissionCount</div></div><div class="progress-bar-custom"><div class="progress-fill" style="width: @(submissionCount == 0 ? 0 : (bestSubmissionCount * 100 / submissionCount))%; background: #28a745;"></div></div></div>
                                <div><div class="category-item"><div class="category-name"><div class="category-color" style="background: #ffc107;"></div><span>Pending</span></div><div>@pendingSubmissionCount</div></div><div class="progress-bar-custom"><div class="progress-fill" style="width: @(submissionCount == 0 ? 0 : (pendingSubmissionCount * 100 / submissionCount))%; background: #ffc107;"></div></div></div>
                                <div><div class="category-item"><div class="category-name"><div class="category-color" style="background: #17a2b8;"></div><span>Reviewed</span></div><div>@reviewedSubmissionCount</div></div><div class="progress-bar-custom"><div class="progress-fill" style="width: @(submissionCount == 0 ? 0 : (reviewedSubmissionCount * 100 / submissionCount))%; background: #17a2b8;"></div></div></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Pending Submissions Table -->
                <div class="row g-4 mb-4">
                    <div class="col-lg-12">
                        <div class="recent-table">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="chart-title"><i class="fas fa-clock"></i> Pending Submissions to Evaluate</div>
                                <a href="@Url.Action("ViewPostings", "Staff")" style="color: #C5A059; text-decoration: none;">View All <i class="fas fa-arrow-right"></i></a>
                            </div>
                            <div class="table-responsive">
                                <table class="table-custom">
                                    <thead><tr><th>Student</th><th>Competition</th><th>Title</th><th>Submitted On</th><th>Status</th><th>Action</th></tr></thead>
                                    <tbody>
                                        @if (submissionCount == 0)
                                        {
                                            <tr>
                                                <td colspan="6" class="text-center">No submissions found yet.</td>
                                            </tr>
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="5">There are @submissionCount submissions in the database.</td>
                                                <td>
                                                    <a class="btn-sm" href="@Url.Action("ViewPostings", "Staff")" style="text-decoration:none;">View</a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recent Activity & Quick Actions -->
                <div class="row g-4 mb-4">
                    <div class="col-lg-5">
                        <div class="chart-card">
                            <div class="chart-title"><i class="fas fa-history"></i> Recent Activity</div>
                            <div class="activity-timeline">
                                <div class="activity-item"><div class="activity-icon"><i class="fas fa-upload"></i></div><div class="activity-detail"><div class="activity-title">New submission received</div><div class="activity-time">2 minutes ago</div></div></div>
                                <div class="activity-item"><div class="activity-icon"><i class="fas fa-check-circle"></i></div><div class="activity-detail"><div class="activity-title">You evaluated 3 submissions</div><div class="activity-time">1 hour ago</div></div></div>
                                <div class="activity-item"><div class="activity-icon"><i class="fas fa-trophy"></i></div><div class="activity-detail"><div class="activity-title">Competition deadline approaching</div><div class="activity-time">3 hours ago</div></div></div>
                                <div class="activity-item"><div class="activity-icon"><i class="fas fa-building"></i></div><div class="activity-detail"><div class="activity-title">New exhibition announced</div><div class="activity-time">5 hours ago</div></div></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-7">
                        <div class="chart-card">
                            <div class="chart-title"><i class="fas fa-bolt"></i> Quick Actions</div>
                            <div class="quick-actions">
                                <div class="quick-btn" onclick="window.location.href='@Url.Action("MarkPostings", "Staff")'"><i class="fas fa-clipboard-list"></i> <span>Evaluate Submissions</span></div>
                                <div class="quick-btn" onclick="window.location.href='@Url.Action("ManageCompetitions", "Staff")'"><i class="fas fa-trophy"></i> <span>Manage Competitions</span></div>
                                <div class="quick-btn" onclick="window.location.href='@Url.Action("ManageExhibitions", "Staff")'"><i class="fas fa-building"></i> <span>Organize Exhibition</span></div>
                                <div class="quick-btn" onclick="window.location.href='@Url.Action("ViewStudents", "Staff")'"><i class="fas fa-users"></i> <span>View Students</span></div>
                                <div class="quick-btn" onclick="window.location.href='@Url.Action("ExhibitionStatus", "Staff")'"><i class="fas fa-chart-line"></i> <span>Exhibition Status</span></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="footer">
                <p>© 2025 ARTISTIC - Institute of Fine Arts. All rights reserved.</p>
            </div>
        </div>
    </div>

    <!-- Modals -->
    <div class="modal-custom" id="evaluateSubmissionModal">
        <div class="modal-content-custom">
            <button class="modal-close" onclick="closeModal('evaluateSubmissionModal')">&times;</button>
            <h3>Evaluate Submission</h3>
            <form id="evaluateForm">
                <div class="form-group"><label>Student Name</label><input type="text" class="form-control" id="studentName" placeholder="Enter student name" required></div>
                <div class="form-group"><label>Artwork Title</label><input type="text" class="form-control" id="artworkTitle" placeholder="Artwork title" required></div>
                <div class="form-group"><label>Marks (out of 100)</label><input type="number" class="form-control" id="marks" placeholder="Enter marks" min="0" max="100" required></div>
                <div class="form-group"><label>Remarks / Feedback</label><textarea class="form-control" id="remarks" rows="3" placeholder="Add your feedback..."></textarea></div>
                <div class="form-group"><label>Status</label><select class="form-select" id="evalStatus"><option>Approved</option><option>Pending Changes</option><option>Rejected</option></select></div>
                <button type="submit" class="btn-gold">Submit Evaluation</button>
            </form>
        </div>
    </div>

    <div class="modal-custom" id="addCompetitionModal">
        <div class="modal-content-custom">
            <button class="modal-close" onclick="closeModal('addCompetitionModal')">&times;</button>
            <h3>Manage Competition</h3>
            <form id="competitionForm">
                <div class="form-group"><label>Competition Title</label><input type="text" class="form-control" id="compTitle" required></div>
                <div class="form-group"><label>Theme</label><input type="text" class="form-control" id="compTheme"></div>
                <div class="form-group"><label>Start Date</label><input type="date" class="form-control" id="compStartDate" required></div>
                <div class="form-group"><label>End Date</label><input type="date" class="form-control" id="compEndDate" required></div>
                <div class="form-group"><label>Prize Details</label><textarea class="form-control" id="compPrize" rows="3"></textarea></div>
                <button type="submit" class="btn-gold">Save Competition</button>
            </form>
        </div>
    </div>

    <div class="modal-custom" id="addExhibitionModal">
        <div class="modal-content-custom">
            <button class="modal-close" onclick="closeModal('addExhibitionModal')">&times;</button>
            <h3>Organize Exhibition</h3>
            <form id="exhibitionForm">
                <div class="form-group"><label>Exhibition Title</label><input type="text" class="form-control" id="exhTitle" required></div>
                <div class="form-group"><label>Venue</label><input type="text" class="form-control" id="exhVenue" required></div>
                <div class="form-group"><label>Start Date</label><input type="date" class="form-control" id="exhStartDate" required></div>
                <div class="form-group"><label>End Date</label><input type="date" class="form-control" id="exhEndDate" required></div>
                <div class="form-group"><label>Description</label><textarea class="form-control" id="exhDesc" rows="3"></textarea></div>
                <button type="submit" class="btn-gold">Create Exhibition</button>
            </form>
        </div>
    </div>

    <div class="modal-custom" id="addPostingModal">
        <div class="modal-content-custom">
            <button class="modal-close" onclick="closeModal('addPostingModal')">&times;</button>
            <h3>Post Announcement</h3>
            <form id="postingForm">
                <div class="form-group"><label>Title</label><input type="text" class="form-control" id="postTitle" required></div>
                <div class="form-group"><label>Content</label><textarea class="form-control" id="postContent" rows="5" required></textarea></div>
                <div class="form-group"><label>Target Audience</label><select class="form-select" id="postAudience"><option>All Students</option><option>Competition Participants</option><option>Exhibition Visitors</option></select></div>
                <button type="submit" class="btn-gold">Post Announcement</button>
            </form>
        </div>
    </div>

    <button class="scroll-top" id="scrollTop"><i class="fas fa-arrow-up"></i></button>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        AOS.init({ duration: 800, once: true });

        // Dark/Light Mode
        const themeToggle = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');
        const body = document.body;

        if (localStorage.getItem('staffTheme') === 'light') {
            body.classList.remove('dark-mode');
            body.classList.add('light-mode');
            themeIcon.classList.remove('fa-sun');
            themeIcon.classList.add('fa-moon');
        } else {
            body.classList.add('dark-mode');
            body.classList.remove('light-mode');
            themeIcon.classList.remove('fa-moon');
            themeIcon.classList.add('fa-sun');
        }

        themeToggle.addEventListener('click', () => {
            if (body.classList.contains('dark-mode')) {
                body.classList.remove('dark-mode');
                body.classList.add('light-mode');
                localStorage.setItem('staffTheme', 'light');
                themeIcon.classList.remove('fa-sun');
                themeIcon.classList.add('fa-moon');
            } else {
                body.classList.remove('light-mode');
                body.classList.add('dark-mode');
                localStorage.setItem('staffTheme', 'dark');
                themeIcon.classList.remove('fa-moon');
                themeIcon.classList.add('fa-sun');
            }
        });

        const menuToggle = document.getElementById('menuToggle');
        const sidebar = document.querySelector('.sidebar');
        if (menuToggle) menuToggle.addEventListener('click', () => sidebar.classList.toggle('active'));

        const scrollBtn = document.getElementById('scrollTop');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 300) scrollBtn.classList.add('show');
            else scrollBtn.classList.remove('show');
        });
        scrollBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

        function goToHome() {
            window.location.href = '@Url.Action("Login", "Account")';
        }

        function openModal(id) {
            const modal = document.getElementById(id);
            if (modal) {
                modal.classList.add('active');
                document.body.style.overflow = 'hidden';
            }
        }

        function closeModal(id) {
            const modal = document.getElementById(id);
            if (modal) {
                modal.classList.remove('active');
                document.body.style.overflow = 'auto';
            }
        }

        function showSuccess(msg) {
            Swal.fire({
                title: 'Success!',
                text: msg,
                icon: 'success',
                confirmButtonColor: '#C5A059',
                background: body.classList.contains('dark-mode') ? '#1A1A2E' : '#FFFFFF',
                color: body.classList.contains('dark-mode') ? 'white' : '#333',
                timer: 2000,
                showConfirmButton: false
            });
        }

        function evaluateSubmission() {
            Swal.fire({
                title: 'Evaluate Submission',
                html: '<strong>Student:</strong> Fatima Akhtar<br><strong>Artwork:</strong> Whispers of Nature<br><br><input type="number" id="marks" class="swal2-input" placeholder="Marks (0-100)"><textarea id="remarks" class="swal2-textarea" placeholder="Remarks/Feedback"></textarea>',
                showCancelButton: true,
                confirmButtonColor: '#C5A059',
                confirmButtonText: 'Submit Evaluation',
                background: body.classList.contains('dark-mode') ? '#1A1A2E' : '#FFFFFF',
                color: body.classList.contains('dark-mode') ? 'white' : '#333',
                preConfirm: () => {
                    const marks = document.getElementById('marks').value;
                    const remarks = document.getElementById('remarks').value;
                    if (!marks) {
                        Swal.showValidationMessage('Please enter marks');
                    }
                    return { marks: marks, remarks: remarks };
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    showSuccess('Evaluation submitted successfully!');
                }
            });
        }

        function generateReport() {
            showSuccess('Report generated successfully!');
        }

        function logout() {
            Swal.fire({
                title: 'Logout?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#C5A059',
                confirmButtonText: 'Yes',
                background: body.classList.contains('dark-mode') ? '#1A1A2E' : '#FFFFFF',
                color: body.classList.contains('dark-mode') ? 'white' : '#333'
            }).then((r) => {
                if (r.isConfirmed) window.location.href = '@Url.Action("Login", "Account")';
            });
        }

        // Form submit handlers
        document.getElementById('evaluateForm')?.addEventListener('submit', (e) => {
            e.preventDefault();
            showSuccess('Evaluation submitted!');
            closeModal('evaluateSubmissionModal');
            e.target.reset();
        });

        document.getElementById('competitionForm')?.addEventListener('submit', (e) => {
            e.preventDefault();
            showSuccess('Competition saved!');
            closeModal('addCompetitionModal');
            e.target.reset();
        });

        document.getElementById('exhibitionForm')?.addEventListener('submit', (e) => {
            e.preventDefault();
            showSuccess('Exhibition created!');
            closeModal('addExhibitionModal');
            e.target.reset();
        });

        document.getElementById('postingForm')?.addEventListener('submit', (e) => {
            e.preventDefault();
            showSuccess('Announcement posted!');
            closeModal('addPostingModal');
            e.target.reset();
        });

        // Charts
        const ctx = document.getElementById('submissionsChart')?.getContext('2d');
        if (ctx) {
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
                    datasets: [{
                        label: 'Submissions',
                        data: [12, 19, 25, 32, 38, 45],
                        borderColor: '#C5A059',
                        backgroundColor: 'rgba(197, 160, 89, 0.05)',
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            labels: { color: body.classList.contains('dark-mode') ? 'white' : '#333' }
                        }
                    },
                    scales: {
                        y: {
                            grid: { color: 'rgba(0,0,0,0.05)' },
                            ticks: { color: body.classList.contains('dark-mode') ? 'white' : '#333' }
                        },
                        x: {
                            ticks: { color: body.classList.contains('dark-mode') ? 'white' : '#333' }
                        }
                    }
                }
            });
        }

        const ctxPie = document.getElementById('statusChart')?.getContext('2d');
        if (ctxPie) {
            new Chart(ctxPie, {
                type: 'pie',
                data: {
                    labels: ['Best', 'Pending', 'Reviewed'],
                    datasets: [{
                        data: [@bestSubmissionCount, @pendingSubmissionCount, @reviewedSubmissionCount],
                        backgroundColor: ['#28a745', '#ffc107', '#17a2b8']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { color: body.classList.contains('dark-mode') ? 'white' : '#333' }
                        }
                    }
                }
            });
        }
    </script>
</body>
</html>