@model IEnumerable<InstituteOfFineArts.Models.Competition>
@using InstituteOfFineArts.Models
@using System.Text.Encodings.Web

@{
    ViewData["Title"] = "Manage Competitions";
    var competitions = Model?.ToList() ?? new List<Competition>();
    var total = ViewBag.TotalCompetitions ?? competitions.Count;
    var ongoing = ViewBag.OngoingCount ?? competitions.Count(c => c.Status == CompetitionStatus.Ongoing);
    var upcoming = ViewBag.UpcomingCount ?? competitions.Count(c => c.Status == CompetitionStatus.Upcoming);
    var completed = ViewBag.CompletedCount ?? competitions.Count(c => c.Status == CompetitionStatus.Concluded);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Competitions | Staff Panel</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body.dark-mode {
            background: #0A0A0A;
            color: #fff;
            font-family: 'Inter',sans-serif;
        }

        body.light-mode {
            background: #F0F2F5;
            color: #1A1A1A;
            font-family: 'Inter',sans-serif;
        }

        .app-wrapper {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            position: fixed;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            width: 70px;
            border-radius: 40px;
            transition: .3s;
            z-index: 1000;
            overflow: hidden;
            backdrop-filter: blur(12px);
            background: rgba(20,20,30,.9);
            border: 1px solid rgba(197,160,89,.15);
        }

            .sidebar:hover {
                width: 260px;
                border-radius: 28px;
            }

        .sidebar-inner {
            padding: 24px 0;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        .sidebar-profile {
            width: 100%;
            text-align: center;
            padding-bottom: 20px;
            margin-bottom: 20px;
            border-bottom: 1px solid rgba(255,255,255,.08);
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
        }

        .profile-avatar {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg,#C5A059,#E8C87A);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #000;
        }

        .profile-name, .profile-role, .nav-text, .logout-text {
            font-size: 0;
            opacity: 0;
            transition: .3s;
            white-space: nowrap;
        }

        .sidebar:hover .profile-name {
            font-size: .85rem;
            opacity: 1;
            margin-top: 12px;
        }

        .sidebar:hover .profile-role {
            font-size: .65rem;
            opacity: .6;
            margin-top: 4px;
        }

        .nav-menu {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 6px;
            padding: 0 12px;
        }

        .nav-item a, .logout-item a {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 12px;
            text-decoration: none;
            border-radius: 30px;
            color: rgba(255,255,255,.7);
            transition: .25s;
            white-space: nowrap;
        }

            .nav-item a i, .logout-item a i {
                width: 28px;
                display: flex;
                justify-content: center;
                color: #C5A059;
            }

        .sidebar:hover .nav-text, .sidebar:hover .logout-text {
            font-size: .85rem;
            opacity: 1;
        }

        .nav-item.active a, .nav-item:hover a {
            background: rgba(197,160,89,.15);
            color: #C5A059;
            transform: translateX(4px);
        }

        .nav-footer {
            width: 100%;
            margin-top: 30px;
            padding: 20px 12px 0;
            border-top: 1px solid rgba(255,255,255,.08);
        }

        .logout-item a i {
            color: #E53E3E;
        }

        .main-content {
            flex: 1;
            margin-left: 100px;
            padding: 24px 32px;
            overflow-x: hidden;
        }

        .top-header, .stat-card, .chart-card, .competitions-table {
            background: rgba(20,20,20,.7);
            border: 1px solid rgba(255,255,255,.06);
            border-radius: 24px;
        }

        .top-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            padding: 16px 24px;
            margin-bottom: 28px;
            flex-wrap: wrap;
        }

        .page-title h2 {
            font-family: 'Playfair Display',serif;
            font-size: 1.5rem;
            font-weight: 700;
            margin: 0;
        }

        .page-title p {
            font-size: .85rem;
            opacity: .7;
            margin: 0;
        }

        .theme-toggle, .user-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .theme-toggle {
            background: rgba(255,255,255,.08);
            color: #FFD700;
            cursor: pointer;
        }

        .user-avatar {
            background: linear-gradient(135deg,#C5A059,#E8C87A);
            color: #000;
        }

        .stat-card {
            padding: 1.5rem;
            height: 100%;
        }

        .stat-icon {
            font-size: 2rem;
            color: #C5A059;
            margin-bottom: .8rem;
        }

        .stat-value {
            font-size: 2rem;
            font-weight: 700;
        }

        .stat-label {
            font-size: .85rem;
            opacity: .7;
        }

        .chart-card, .competitions-table {
            padding: 1.5rem;
        }

        .filter-bar {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
            align-items: center;
        }

        .filter-buttons {
            display: flex;
            gap: .5rem;
            flex-wrap: wrap;
        }

        .filter-btn {
            background: rgba(197,160,89,.1);
            border: 1px solid rgba(197,160,89,.2);
            color: #ccc;
            padding: .4rem 1rem;
            border-radius: 50px;
            cursor: pointer;
        }

            .filter-btn.active, .filter-btn:hover {
                background: #C5A059;
                color: #000;
            }

        .search-box {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: .45rem 1rem;
            border-radius: 50px;
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.1);
        }

            .search-box input {
                background: transparent;
                border: none;
                outline: none;
                color: inherit;
                width: 220px;
            }

        .btn-add, .btn-gold {
            background: linear-gradient(135deg,#C5A059,#E8C87A);
            color: #000;
            border: none;
            padding: .55rem 1.2rem;
            border-radius: 50px;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
        }

        .chart-title {
            font-weight: 600;
            margin-bottom: 1rem;
            color: #C5A059;
            display: flex;
            align-items: center;
            gap: .5rem;
        }

        .table-custom {
            width: 100%;
            border-collapse: collapse;
        }

            .table-custom th, .table-custom td {
                padding: 1rem .8rem;
                border-bottom: 1px solid rgba(255,255,255,.08);
                vertical-align: middle;
                font-size: .85rem;
            }

            .table-custom th {
                color: #C5A059;
                font-weight: 600;
            }

        .badge-status {
            padding: .25rem .7rem;
            border-radius: 30px;
            font-size: .7rem;
            font-weight: 600;
            display: inline-block;
        }

        .badge-ongoing {
            background: #28a745;
            color: #fff;
        }

        .badge-upcoming {
            background: #ffc107;
            color: #000;
        }

        .badge-closed {
            background: #6c757d;
            color: #fff;
        }

        .action-buttons {
            display: flex;
            gap: 8px;
            align-items: center;
            flex-wrap: wrap;
        }

        .btn-icon {
            background: transparent;
            border: none;
            cursor: pointer;
            padding: 6px 9px;
            border-radius: 8px;
            transition: .25s;
            color: #ccc;
            text-decoration: none;
            display: inline-flex;
        }

            .btn-icon:hover {
                background: rgba(197,160,89,.15);
                color: #C5A059;
                transform: translateY(-2px);
            }

            .btn-icon.delete:hover {
                background: rgba(229,62,62,.15);
                color: #E53E3E;
            }

        .footer {
            padding: 1rem;
            margin-top: 2rem;
            text-align: center;
            border-radius: 20px;
            font-size: .7rem;
            background: rgba(20,20,20,.5);
            color: rgba(255,255,255,.4);
        }

        .modal-custom {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,.7);
            backdrop-filter: blur(8px);
            z-index: 2000;
            align-items: center;
            justify-content: center;
        }

            .modal-custom.active {
                display: flex;
            }

        .modal-content-custom {
            width: 90%;
            max-width: 550px;
            max-height: 85vh;
            overflow-y: auto;
            border-radius: 28px;
            padding: 2rem;
            position: relative;
            background: #1A1A2E;
            border: 1px solid rgba(197,160,89,.2);
        }

        .modal-close {
            position: absolute;
            top: 15px;
            right: 20px;
            font-size: 1.5rem;
            cursor: pointer;
            background: none;
            border: none;
            color: white;
        }

        .form-group {
            margin-bottom: 1rem;
        }

            .form-group label {
                display: block;
                margin-bottom: .4rem;
                font-size: .85rem;
                font-weight: 500;
            }

        .form-control, .form-select {
            width: 100%;
            padding: .7rem 1rem;
            border-radius: 14px;
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.1);
            color: #fff;
        }

            .form-select option {
                background: #1A1A2E;
                color: #fff;
            }

        @@media(max-width:992px) {
            .main-content {
                margin-left: 0;
                padding: 16px;
            }

            .sidebar {
                left: -70px;
            }

                .sidebar.active {
                    left: 20px;
                }
        }
    </style>
</head>

<body class="dark-mode">
    <div class="app-wrapper">
        <div class="sidebar">
            <div class="sidebar-inner">
                <div class="sidebar-profile" onclick="goToHome()">
                    <div class="profile-avatar"><i class="fas fa-palette"></i></div>
                    <div class="profile-name">ARTISTIC</div>
                    <div class="profile-role">Staff Panel</div>
                </div>

                <div class="nav-menu">
                    <div class="nav-item"><a href="@Url.Action("Dashboard", "Staff")"><i class="fas fa-home"></i><span class="nav-text">Dashboard</span></a></div>
                    <div class="nav-item"><a href="@Url.Action("ViewStudents", "Staff")"><i class="fas fa-users"></i><span class="nav-text">View Students</span></a></div>
                    <div class="nav-item active"><a href="@Url.Action("ManageCompetitions", "Staff")"><i class="fas fa-trophy"></i><span class="nav-text">Competitions</span></a></div>
                    <div class="nav-item"><a href="@Url.Action("ManageExhibitions", "Staff")"><i class="fas fa-building"></i><span class="nav-text">Exhibitions</span></a></div>
                    <div class="nav-item"><a href="@Url.Action("ViewPostings", "Staff")"><i class="fas fa-clipboard-list"></i><span class="nav-text">View Postings</span></a></div>
                    <div class="nav-item"><a href="@Url.Action("MarkPostings", "Staff")"><i class="fas fa-check-double"></i><span class="nav-text">Mark Postings</span></a></div>
                    <div class="nav-item"><a href="@Url.Action("SendtoExhibition", "Staff")"><i class="fas fa-paper-plane"></i><span class="nav-text">Send to Exhibition</span></a></div>
                    <div class="nav-item"><a href="@Url.Action("ExhibitionStatus", "Staff")"><i class="fas fa-chart-line"></i><span class="nav-text">Exhibition Status</span></a></div>
                </div>

                <div class="nav-footer">
                    <div class="logout-item"><a href="@Url.Action("Login", "Account")"><i class="fas fa-sign-out-alt"></i><span class="logout-text">Logout</span></a></div>
                </div>
            </div>
        </div>

        <div class="main-content">
            <div class="top-header">
                <div class="page-title">
                    <h2><i class="fas fa-trophy me-2" style="color:#C5A059;"></i>Manage Competitions</h2>
                    <p>Create, edit, delete, search and retrieve competition records</p>
                </div>
                <div style="display:flex;align-items:center;gap:1rem;">
                    <div class="theme-toggle" id="themeToggle"><i class="fas fa-sun" id="themeIcon"></i></div>
                    <div class="user-avatar"><i class="fas fa-user-tie"></i></div>
                </div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <div class="container-fluid mt-4">
                <div class="row g-4 mb-4">
                    <div class="col-xl-3 col-md-6"><div class="stat-card"><div class="stat-icon"><i class="fas fa-trophy"></i></div><div class="stat-value">@total</div><div class="stat-label">Total Competitions</div></div></div>
                    <div class="col-xl-3 col-md-6"><div class="stat-card"><div class="stat-icon"><i class="fas fa-play-circle"></i></div><div class="stat-value">@ongoing</div><div class="stat-label">Ongoing</div></div></div>
                    <div class="col-xl-3 col-md-6"><div class="stat-card"><div class="stat-icon"><i class="fas fa-clock"></i></div><div class="stat-value">@upcoming</div><div class="stat-label">Upcoming</div></div></div>
                    <div class="col-xl-3 col-md-6"><div class="stat-card"><div class="stat-icon"><i class="fas fa-check-circle"></i></div><div class="stat-value">@completed</div><div class="stat-label">Completed</div></div></div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-12">
                        <div class="chart-card">
                            <div class="filter-bar">
                                <div class="filter-buttons">
                                    <button class="filter-btn active" type="button" data-filter="all">All</button>
                                    <button class="filter-btn" type="button" data-filter="ongoing">Ongoing</button>
                                    <button class="filter-btn" type="button" data-filter="upcoming">Upcoming</button>
                                    <button class="filter-btn" type="button" data-filter="concluded">Concluded</button>
                                </div>
                                <div class="d-flex gap-2 flex-wrap">
                                    <div class="search-box"><i class="fas fa-search"></i><input type="text" id="searchInput" placeholder="Search competitions..."></div>
                                    <button class="btn-add" type="button" onclick="openModal('addCompetitionModal')"><i class="fas fa-plus"></i> Add Competition</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-12">
                        <div class="competitions-table">
                            <div class="chart-title"><i class="fas fa-list"></i> Competitions List</div>

                            <div class="table-responsive">
                                <table class="table-custom" id="competitionsTable">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Competition</th>
                                            <th>Description / Theme</th>
                                            <th>Dates</th>
                                            <th>Conditions</th>
                                            <th>Submissions</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (competitions.Any())
                                        {
                                            var count = 1;
                                            foreach (var comp in competitions)
                                            {
                                                var statusText = comp.Status.ToString();
                                                var statusLower = statusText.ToLower();
                                                var badgeClass = comp.Status == CompetitionStatus.Ongoing ? "badge-ongoing" :
                                                comp.Status == CompetitionStatus.Upcoming ? "badge-upcoming" :
                                                "badge-closed";

                                                <tr data-status="@statusLower" data-title="@comp.Title.ToLower()" data-theme="@(comp.Description?.ToLower() ?? "")">
                                                    <td>@count</td>
                                                    <td><strong>@comp.Title</strong></td>
                                                    <td>@(comp.Description ?? "-")</td>
                                                    <td>
                                                        <small>
                                                            <strong>Start:</strong> @comp.StartDate.ToString("yyyy-MM-dd HH:mm")<br />
                                                            <strong>End:</strong> @comp.EndDate.ToString("yyyy-MM-dd HH:mm")
                                                        </small>
                                                    </td>
                                                    <td>@(comp.Conditions ?? "-")</td>
                                                    <td>@(comp.Submissions?.Count ?? 0) submissions</td>
                                                    <td><span class="badge-status @badgeClass">@statusText</span></td>
                                                    <td>
                                                        <div class="action-buttons">
                                                            <button class="btn-icon view" type="button"
                                                                    onclick="showInfo('@JavaScriptEncoder.Default.Encode(comp.Title)', '@JavaScriptEncoder.Default.Encode(comp.Description ?? "No description")', '@comp.StartDate.ToString("yyyy-MM-dd HH:mm")', '@comp.EndDate.ToString("yyyy-MM-dd HH:mm")', '@JavaScriptEncoder.Default.Encode(comp.Conditions ?? "-")', '@statusText')"
                                                                    title="View">
                                                                <i class="fas fa-eye"></i>
                                                            </button>

                                                            <a class="btn-icon edit"
                                                               href="@Url.Action("EditCompetition", "Staff", new { id = comp.CompetitionId })"
                                                               title="Edit">
                                                                <i class="fas fa-edit"></i>
                                                            </a>

                                                            <form asp-action="EditCompetition" asp-controller="Staff" method="post" enctype="multipart/form-data">
                                                                  onsubmit="return confirmDeleteCompetition('@JavaScriptEncoder.Default.Encode(comp.Title)', @(comp.Submissions?.Count ?? 0));">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="id" value="@comp.CompetitionId" />
                                                                <button class="btn-icon delete" type="submit" title="Delete">
                                                                    <i class="fas fa-trash-alt"></i>
                                                                </button>
                                                            </form>
                                                        </div>
                                                    </td>
                                                </tr>
                                                count++;
                                            }
                                        }
                                        else
                                        {
                                            <tr><td colspan="8" style="text-align:center;">No competitions found</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div id="noResultsRow" style="display:none;text-align:center;padding:2rem;">No matching competitions found</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="footer"><p>© 2025 ARTISTIC - Institute of Fine Arts. All rights reserved.</p></div>
        </div>
    </div>

    <div class="modal-custom" id="addCompetitionModal">
        <div class="modal-content-custom">
            <button class="modal-close" type="button" onclick="closeModal('addCompetitionModal')">&times;</button>
            <h3>Add Competition</h3>

            <form asp-controller="Staff" asp-action="CreateCompetition" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label>Competition Title *</label>
                    <input type="text" class="form-control" name="Title" required />
                </div>

                <div class="form-group">
                    <label>Description / Theme</label>
                    <textarea class="form-control" name="Description" rows="3" placeholder="Colors of Nature / competition details"></textarea>
                </div>

                <div class="form-group">
                    <label>Start Date *</label>
                    <input type="datetime-local" class="form-control" name="StartDate" required />
                </div>

                <div class="form-group">
                    <label>End Date *</label>
                    <input type="datetime-local" class="form-control" name="EndDate" required />
                </div>

                <div class="form-group">
                    <label>Conditions</label>
                    <textarea class="form-control" name="Conditions" rows="3" placeholder="Only JPEG files allowed. Submit before deadline."></textarea>
                </div>

                <div class="form-group">
                    <label>Status *</label>
                    <select class="form-select" name="Status" required>
                        <option value="1">Upcoming</option>
                        <option value="2" selected>Ongoing</option>
                        <option value="3">Concluded</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Competition Image (Optional)</label>
                    <input type="file" class="form-control" name="ImageFile" accept="image/*" />
                    <small class="text-muted">Upload JPG, JPEG or PNG image</small>
                </div>


                <button type="submit" class="btn-gold"><i class="fas fa-save"></i> Save Competition</button>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const themeToggle = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');
        const body = document.body;

        if (localStorage.getItem('staffTheme') === 'light') {
            body.classList.remove('dark-mode');
            body.classList.add('light-mode');
            themeIcon.classList.remove('fa-sun');
            themeIcon.classList.add('fa-moon');
        }

        themeToggle.addEventListener('click', () => {
            if (body.classList.contains('dark-mode')) {
                body.classList.remove('dark-mode');
                body.classList.add('light-mode');
                localStorage.setItem('staffTheme', 'light');
                themeIcon.classList.remove('fa-sun');
                themeIcon.classList.add('fa-moon');
            } else {
                body.classList.remove('light-mode');
                body.classList.add('dark-mode');
                localStorage.setItem('staffTheme', 'dark');
                themeIcon.classList.remove('fa-moon');
                themeIcon.classList.add('fa-sun');
            }
        });

        function goToHome() {
            window.location.href = '@Url.Action("Index", "Home")';
        }

        function openModal(id) {
            const modal = document.getElementById(id);
            if (modal) modal.classList.add('active');
        }

        function closeModal(id) {
            const modal = document.getElementById(id);
            if (modal) modal.classList.remove('active');
        }

        function showInfo(title, description, startDate, endDate, conditions, status) {
            Swal.fire({
                title: title,
                html: `
                    <div style="text-align:left">
                        <strong>Description / Theme:</strong><br>${description}<br><br>
                        <strong>Start Date:</strong> ${startDate}<br>
                        <strong>End Date:</strong> ${endDate}<br><br>
                        <strong>Conditions:</strong><br>${conditions}<br><br>
                        <strong>Status:</strong> ${status}
                    </div>
                `,
                icon: 'info',
                confirmButtonColor: '#C5A059',
                background: body.classList.contains('dark-mode') ? '#1A1A2E' : '#FFFFFF',
                color: body.classList.contains('dark-mode') ? 'white' : '#333'
            });
        }

        function confirmDeleteCompetition(title, submissionCount) {
            if (submissionCount > 0) {
                Swal.fire({
                    title: 'Cannot Delete',
                    text: 'This competition has submissions, so it cannot be deleted.',
                    icon: 'error',
                    confirmButtonColor: '#C5A059',
                    background: body.classList.contains('dark-mode') ? '#1A1A2E' : '#FFFFFF',
                    color: body.classList.contains('dark-mode') ? 'white' : '#333'
                });
                return false;
            }

            return confirm('Delete "' + title + '"? This action cannot be undone.');
        }

        const searchInput = document.getElementById('searchInput');
        const filterButtons = document.querySelectorAll('.filter-btn');
        let currentFilter = 'all';

        function applyFilters() {
            const search = (searchInput?.value || '').toLowerCase().trim();
            const rows = document.querySelectorAll('#competitionsTable tbody tr[data-status]');
            let visibleCount = 0;

            rows.forEach(row => {
                const status = row.getAttribute('data-status');
                const title = row.getAttribute('data-title') || '';
                const theme = row.getAttribute('data-theme') || '';

                const matchesFilter = currentFilter === 'all' || status === currentFilter;
                const matchesSearch = search === '' || title.includes(search) || theme.includes(search);

                if (matchesFilter && matchesSearch) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            const noResults = document.getElementById('noResultsRow');
            if (noResults) noResults.style.display = visibleCount === 0 && rows.length > 0 ? 'block' : 'none';
        }

        if (searchInput) searchInput.addEventListener('input', applyFilters);

        filterButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                filterButtons.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                currentFilter = btn.getAttribute('data-filter');
                applyFilters();
            });
        });
    </script>
</body>
</html>
