@model IEnumerable<InstituteOfFineArts.Models.Submission>
@using InstituteOfFineArts.Models

@{
    ViewData["Title"] = "Mark Postings";
    var total = Model?.Count() ?? 0;
    var pending = Model?.Count(s => s.Grade == SubmissionGrade.Pending) ?? 0;
    var reviewed = Model?.Count(s => s.Grade != SubmissionGrade.Pending) ?? 0;
    var best = Model?.Count(s => s.Grade == SubmissionGrade.Best) ?? 0;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mark Postings | Staff Panel</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body.dark-mode {
            background: #0A0A0A;
            color: #fff;
            font-family: 'Inter',sans-serif;
        }

        .app-wrapper {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            position: fixed;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            width: 70px;
            border-radius: 40px;
            transition: .3s;
            z-index: 1000;
            overflow: hidden;
            backdrop-filter: blur(12px);
            background: rgba(20,20,30,.9);
            border: 1px solid rgba(197,160,89,.15);
        }

            .sidebar:hover {
                width: 260px;
                border-radius: 28px;
            }

        .sidebar-inner {
            padding: 24px 0;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        .sidebar-profile {
            width: 100%;
            text-align: center;
            padding-bottom: 20px;
            margin-bottom: 20px;
            border-bottom: 1px solid rgba(255,255,255,.08);
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
        }

        .profile-avatar {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg,#C5A059,#E8C87A);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #000;
        }

        .profile-name, .profile-role, .nav-text, .logout-text {
            font-size: 0;
            opacity: 0;
            transition: .3s;
            white-space: nowrap;
        }

        .sidebar:hover .profile-name {
            font-size: .85rem;
            opacity: 1;
            margin-top: 12px;
        }

        .sidebar:hover .profile-role {
            font-size: .65rem;
            opacity: .6;
            margin-top: 4px;
        }

        .nav-menu {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 6px;
            padding: 0 12px;
        }

        .nav-item a, .logout-item a {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 12px;
            text-decoration: none;
            border-radius: 30px;
            color: rgba(255,255,255,.7);
            transition: .25s;
        }

            .nav-item a i, .logout-item a i {
                width: 28px;
                display: flex;
                justify-content: center;
                color: #C5A059;
            }

        .sidebar:hover .nav-text, .sidebar:hover .logout-text {
            font-size: .85rem;
            opacity: 1;
        }

        .nav-item.active a, .nav-item:hover a {
            background: rgba(197,160,89,.15);
            color: #C5A059;
            transform: translateX(4px);
        }

        .nav-footer {
            width: 100%;
            margin-top: 30px;
            padding: 20px 12px 0;
            border-top: 1px solid rgba(255,255,255,.08);
        }

        .logout-item a i {
            color: #E53E3E;
        }

        .main-content {
            flex: 1;
            margin-left: 100px;
            padding: 24px 32px;
        }

        .top-header, .stat-card, .content-card, .eval-card {
            background: rgba(20,20,20,.7);
            border: 1px solid rgba(255,255,255,.06);
            border-radius: 24px;
        }

        .top-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            padding: 16px 24px;
            margin-bottom: 28px;
        }

        .page-title h2 {
            font-family: 'Playfair Display',serif;
            font-size: 1.5rem;
            font-weight: 700;
        }

        .page-title p {
            font-size: .85rem;
            opacity: .7;
            margin: 0;
        }

        .stat-card {
            padding: 1.5rem;
            height: 100%;
            transition: .3s;
        }

            .stat-card:hover, .eval-card:hover {
                transform: translateY(-4px);
                border-color: rgba(197,160,89,.45);
            }

        .stat-icon {
            font-size: 2rem;
            color: #C5A059;
            margin-bottom: .7rem;
        }

        .stat-value {
            font-size: 2rem;
            font-weight: 800;
        }

        .stat-label {
            font-size: .8rem;
            opacity: .75;
        }

        .content-card {
            padding: 1.5rem;
        }

        .chart-title {
            color: #C5A059;
            font-weight: 700;
            margin-bottom: 1rem;
            display: flex;
            gap: .5rem;
            align-items: center;
        }

        .eval-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill,minmax(380px,1fr));
            gap: 1.2rem;
        }

        .eval-card {
            padding: 1rem;
        }

        .posting-img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            border-radius: 18px;
            border: 1px solid rgba(197,160,89,.2);
            background: #222;
        }

        .posting-title {
            color: #E8C87A;
            font-family: 'Playfair Display',serif;
            font-size: 1.2rem;
            font-weight: 700;
            margin-top: .9rem;
        }

        .posting-meta {
            font-size: .82rem;
            opacity: .75;
            margin: .25rem 0;
        }

        .form-control, .form-select {
            background: rgba(255,255,255,.08);
            border: 1px solid rgba(197,160,89,.25);
            color: #fff;
            border-radius: 14px;
        }

            .form-control:focus, .form-select:focus {
                background: rgba(255,255,255,.1);
                border-color: #C5A059;
                color: #fff;
                box-shadow: 0 0 0 .2rem rgba(197,160,89,.15);
            }

            .form-select option {
                background: #1A1A2E;
                color: #fff;
            }

        label {
            font-size: .8rem;
            color: #C5A059;
            margin-top: .7rem;
            margin-bottom: .25rem;
            font-weight: 700;
        }

        .btn-gold {
            background: linear-gradient(135deg,#C5A059,#E8C87A);
            color: #000;
            border: none;
            padding: .6rem 1rem;
            border-radius: 50px;
            font-weight: 800;
            text-decoration: none;
            display: inline-block;
        }

        .alert {
            border-radius: 16px;
        }

        .text-muted-custom {
            color: rgba(255,255,255,.65);
        }

        @@media (max-width:992px) {
            .main-content {
                margin-left: 0;
                padding: 16px;
            }

            .sidebar {
                left: -70px;
            }

            .eval-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body class="dark-mode">
    <div class="app-wrapper">
        <div class="sidebar">
            <div class="sidebar-inner">
                <div class="sidebar-profile" onclick="goToHome()">
                    <div class="profile-avatar"><i class="fas fa-palette"></i></div>
                    <div class="profile-name">ARTISTIC</div>
                    <div class="profile-role">Staff Panel</div>
                </div>
                <div class="nav-menu">
                    <div class="nav-item"><a href="@Url.Action("Dashboard", "Staff")"><i class="fas fa-home"></i><span class="nav-text">Dashboard</span></a></div>
                    <div class="nav-item"><a href="@Url.Action("ViewStudents", "Staff")"><i class="fas fa-users"></i><span class="nav-text">View Students</span></a></div>
                    <div class="nav-item"><a href="@Url.Action("ManageCompetitions", "Staff")"><i class="fas fa-trophy"></i><span class="nav-text">Competitions</span></a></div>
                    <div class="nav-item"><a href="@Url.Action("ManageExhibitions", "Staff")"><i class="fas fa-building"></i><span class="nav-text">Exhibitions</span></a></div>
                    <div class="nav-item"><a href="@Url.Action("ViewPostings", "Staff")"><i class="fas fa-clipboard-list"></i><span class="nav-text">View Postings</span></a></div>
                    <div class="nav-item active"><a href="@Url.Action("MarkPostings", "Staff")"><i class="fas fa-check-double"></i><span class="nav-text">Mark Postings</span></a></div>
                    <div class="nav-item"><a href="@Url.Action("SendtoExhibition", "Staff")"><i class="fas fa-paper-plane"></i><span class="nav-text">Send to Exhibition</span></a></div>
                    <div class="nav-item"><a href="@Url.Action("ExhibitionStatus", "Staff")"><i class="fas fa-chart-line"></i><span class="nav-text">Exhibition Status</span></a></div>
                </div>
                <div class="nav-footer"><div class="logout-item"><a href="#" onclick="logout()"><i class="fas fa-sign-out-alt"></i><span class="logout-text">Logout</span></a></div></div>
            </div>
        </div>

        <div class="main-content">
            <div class="top-header">
                <div class="page-title">
                    <h2><i class="fas fa-check-double me-2" style="color:#C5A059"></i>Evaluate Submissions</h2>
                    <p>Give grade and remarks to student artwork submissions.</p>
                </div>
                <a class="btn-gold" href="@Url.Action("ViewPostings", "Staff")"><i class="fas fa-eye me-1"></i> View Postings</a>
            </div>

            <div class="container-fluid mt-4">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }

                <div class="row g-4 mb-4">
                    <div class="col-xl-3 col-md-6"><div class="stat-card"><div class="stat-icon"><i class="fas fa-clock"></i></div><div class="stat-value">@pending</div><div class="stat-label">Pending</div></div></div>
                    <div class="col-xl-3 col-md-6"><div class="stat-card"><div class="stat-icon"><i class="fas fa-check-circle"></i></div><div class="stat-value">@reviewed</div><div class="stat-label">Reviewed</div></div></div>
                    <div class="col-xl-3 col-md-6"><div class="stat-card"><div class="stat-icon"><i class="fas fa-star"></i></div><div class="stat-value">@best</div><div class="stat-label">Best</div></div></div>
                    <div class="col-xl-3 col-md-6"><div class="stat-card"><div class="stat-icon"><i class="fas fa-palette"></i></div><div class="stat-value">@total</div><div class="stat-label">Total</div></div></div>
                </div>

                <div class="content-card">
                    <div class="chart-title"><i class="fas fa-list"></i> Student Submissions</div>
                    @if (Model != null && Model.Any())
                    {
                        <div class="eval-grid">
                            @foreach (var item in Model)
                            {
                                <div class="eval-card">
                                    <img src="@item.ImageFilePath" class="posting-img" alt="@item.PaintingTitle" onerror="this.src='https://placehold.co/500x300/1A1A2E/C5A059?text=Artwork'" />
                                    <div class="posting-title">@item.PaintingTitle</div>
                                    <div class="posting-meta"><i class="fas fa-user me-1"></i> @(item.Student == null ? "Student" : item.Student.FirstName + " " + item.Student.LastName)</div>
                                    <div class="posting-meta"><i class="fas fa-trophy me-1"></i> @(item.Competition?.Title ?? "Competition")</div>
                                    <div class="posting-meta"><i class="far fa-calendar-alt me-1"></i> @item.SubmittedAt.ToString("dd MMM yyyy")</div>
                                    <p class="text-muted-custom mt-2">@item.TextType: @(item.AccompanyingText?.Length > 140 ? item.AccompanyingText.Substring(0, 140) + "..." : item.AccompanyingText)</p>

                                    <form asp-controller="Staff" asp-action="EvaluateSubmission" method="post" class="mt-3">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="SubmissionId" value="@item.SubmissionId" />

                                        <label>Grade</label>
                                        <select name="Grade" class="form-select" required>
                                            @foreach (SubmissionGrade grade in Enum.GetValues(typeof(SubmissionGrade)))
                                            {
                                                if (grade != SubmissionGrade.Pending)
                                                {
                                                    if (item.Grade == grade)
                                                    {
                                                        <option value="@grade" selected>@grade</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@grade">@grade</option>
                                                    }
                                                }
                                            }
                                        </select>

                                        <label>Positive Points</label>
                                        <textarea name="PositivePoints" class="form-control" rows="2">@item.Evaluation?.PositivePoints</textarea>

                                        <label>Negative Points</label>
                                        <textarea name="NegativePoints" class="form-control" rows="2">@item.Evaluation?.NegativePoints</textarea>

                                        <label>Areas Of Improvement</label>
                                        <textarea name="AreasOfImprovement" class="form-control" rows="2">@item.Evaluation?.AreasOfImprovement</textarea>

                                        <label>General Remarks</label>
                                        <textarea name="GeneralRemarks" class="form-control" rows="2">@item.Evaluation?.GeneralRemarks</textarea>

                                        <button type="submit" class="btn-gold w-100 mt-3"><i class="fas fa-save me-1"></i> Save Evaluation</button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-inbox display-1" style="color:#C5A059"></i>
                            <h4 class="mt-3">No submissions to evaluate</h4>
                            <p class="text-muted-custom">Student postings will appear here after upload.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <script>
        function goToHome(){ window.location.href='@Url.Action("Index", "Home")'; }
        function logout(){ window.location.href='@Url.Action("Login", "Account")'; }
    </script>
</body>
</html>
