@model InstituteOfFineArts.Models.Competition
@using InstituteOfFineArts.Models

@{
    ViewData["Title"] = "Edit Competition";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Competition | Staff Panel | ARTISTIC Institute</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body.dark-mode {
            background: #0A0A0A;
            color: #FFFFFF;
            font-family: 'Inter', sans-serif;
        }

        body.light-mode {
            background: #F0F2F5;
            color: #1A1A1A;
            font-family: 'Inter', sans-serif;
        }

        .app-wrapper {
            display: flex;
            min-height: 100vh;
            position: relative;
        }

        .sidebar {
            position: fixed;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            width: 70px;
            border-radius: 40px;
            transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
            z-index: 1000;
            overflow: hidden;
            backdrop-filter: blur(12px);
            background: rgba(20, 20, 30, 0.9);
            border: 1px solid rgba(197, 160, 89, 0.15);
            box-shadow: 0 20px 40px rgba(0,0,0,0.3);
        }

            .sidebar:hover {
                width: 260px;
                border-radius: 28px;
            }

        .sidebar-inner {
            padding: 24px 0;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        .sidebar-profile {
            width: 100%;
            text-align: center;
            padding-bottom: 20px;
            margin-bottom: 20px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
        }

        .profile-avatar {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg, #C5A059, #E8C87A);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #000;
        }

        .profile-name, .profile-role, .nav-text, .logout-text {
            font-size: 0;
            opacity: 0;
            transition: all 0.3s ease;
            white-space: nowrap;
        }

        .sidebar:hover .profile-name {
            font-size: 0.85rem;
            opacity: 1;
            margin-top: 12px;
        }

        .sidebar:hover .profile-role {
            font-size: 0.65rem;
            opacity: 0.6;
            margin-top: 4px;
        }

        .nav-menu {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 6px;
            padding: 0 12px;
        }

        .nav-item a, .logout-item a {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 12px;
            text-decoration: none;
            border-radius: 30px;
            color: rgba(255,255,255,0.7);
            transition: all 0.25s ease;
            white-space: nowrap;
            font-weight: 500;
        }

            .nav-item a i, .logout-item a i {
                width: 28px;
                display: flex;
                justify-content: center;
                color: #C5A059;
            }

        .sidebar:hover .nav-text, .sidebar:hover .logout-text {
            font-size: 0.85rem;
            opacity: 1;
        }

        .nav-item.active a, .nav-item:hover a {
            background: rgba(197,160,89,0.15);
            color: #C5A059;
            transform: translateX(4px);
        }

        .nav-footer {
            width: 100%;
            margin-top: 30px;
            padding: 20px 12px 0;
            border-top: 1px solid rgba(255,255,255,0.08);
        }

        .logout-item a i {
            color: #E53E3E;
        }

        .main-content {
            flex: 1;
            margin-left: 100px;
            padding: 24px 32px;
            overflow-x: hidden;
        }

        .top-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            padding: 16px 24px;
            border-radius: 24px;
            margin-bottom: 28px;
            background: rgba(20,20,20,0.7);
            border: 1px solid rgba(255,255,255,0.05);
        }

        .page-title h2 {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            font-weight: 700;
            margin: 0;
        }

        .page-title p {
            font-size: 0.8rem;
            opacity: 0.7;
            margin: 4px 0 0;
        }

        .theme-toggle, .user-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .theme-toggle {
            background: rgba(255,255,255,0.08);
            color: #FFD700;
            cursor: pointer;
        }

        .user-avatar {
            background: linear-gradient(135deg, #C5A059, #E8C87A);
            color: #000;
        }

        .form-container {
            border-radius: 24px;
            padding: 2rem;
            background: rgba(20,20,20,0.7);
            border: 1px solid rgba(255,255,255,0.05);
        }

        .form-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.3rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
            color: #C5A059;
            border-left: 3px solid #C5A059;
            padding-left: 1rem;
        }

        .form-group {
            margin-bottom: 1.2rem;
        }

            .form-group label {
                display: block;
                margin-bottom: 0.5rem;
                font-weight: 500;
                font-size: 0.85rem;
            }

                .form-group label i {
                    color: #C5A059;
                    margin-right: 0.5rem;
                }

        .form-control, .form-select {
            width: 100%;
            padding: 0.75rem 1rem;
            border-radius: 12px;
            transition: all 0.3s ease;
            font-size: 0.9rem;
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(197,160,89,0.3);
            color: white;
        }

            .form-select option {
                background: #1A1A2E;
                color: white;
            }

            .form-control:focus, .form-select:focus {
                border-color: #C5A059;
                outline: none;
                box-shadow: 0 0 0 2px rgba(197,160,89,0.2);
                background: rgba(255,255,255,0.08);
                color: white;
            }

        .form-row {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
        }

        .button-group {
            display: flex;
            gap: 1rem;
            margin-top: 1.5rem;
        }

        .btn-submit {
            flex: 2;
            background: linear-gradient(135deg, #C5A059, #E8C87A);
            color: #000;
            border: none;
            padding: 0.75rem 1.5rem;
            border-radius: 50px;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .btn-submit:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(197,160,89,0.3);
            }

        .btn-cancel {
            flex: 1;
            background: transparent;
            border: 1px solid #C5A059;
            color: #C5A059;
            padding: 0.7rem 1.5rem;
            border-radius: 50px;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
            text-align: center;
        }

            .btn-cancel:hover {
                background: rgba(197,160,89,0.1);
                color: #C5A059;
                transform: translateY(-2px);
            }

        .footer {
            padding: 1rem;
            margin-top: 2rem;
            text-align: center;
            border-radius: 20px;
            font-size: 0.7rem;
            background: rgba(20,20,20,0.5);
            color: rgba(255,255,255,0.4);
        }

        @@media (max-width: 992px) {
            .main-content {
                margin-left: 0;
                padding: 16px;
            }

            .sidebar {
                left: -70px;
            }

                .sidebar.active {
                    left: 20px;
                }
        }

        @@media (max-width: 768px) {
            .form-row {
                grid-template-columns: 1fr;
            }

            .button-group {
                flex-direction: column;
            }
        }
    </style>
</head>

<body class="dark-mode">
    <div class="app-wrapper">
        <div class="sidebar">
            <div class="sidebar-inner">
                <div class="sidebar-profile" onclick="goToHome()">
                    <div class="profile-avatar"><i class="fas fa-palette"></i></div>
                    <div class="profile-name">ARTISTIC</div>
                    <div class="profile-role">Staff Panel</div>
                </div>

                <div class="nav-menu">
                    <div class="nav-item"><a href="@Url.Action("Dashboard", "Staff")"><i class="fas fa-home"></i><span class="nav-text">Dashboard</span></a></div>
                    <div class="nav-item"><a href="@Url.Action("ViewStudents", "Staff")"><i class="fas fa-users"></i><span class="nav-text">View Students</span></a></div>
                    <div class="nav-item active"><a href="@Url.Action("ManageCompetitions", "Staff")"><i class="fas fa-trophy"></i><span class="nav-text">Competitions</span></a></div>
                    <div class="nav-item"><a href="@Url.Action("ManageExhibitions", "Staff")"><i class="fas fa-building"></i><span class="nav-text">Exhibitions</span></a></div>
                    <div class="nav-item"><a href="@Url.Action("ViewPostings", "Staff")"><i class="fas fa-clipboard-list"></i><span class="nav-text">View Postings</span></a></div>
                    <div class="nav-item"><a href="@Url.Action("MarkPostings", "Staff")"><i class="fas fa-check-double"></i><span class="nav-text">Mark Postings</span></a></div>
                    <div class="nav-item"><a href="@Url.Action("SendtoExhibition", "Staff")"><i class="fas fa-paper-plane"></i><span class="nav-text">Send to Exhibition</span></a></div>
                    <div class="nav-item"><a href="@Url.Action("ExhibitionStatus", "Staff")"><i class="fas fa-chart-line"></i><span class="nav-text">Exhibition Status</span></a></div>
                </div>

                <div class="nav-footer">
                    <div class="logout-item"><a href="@Url.Action("Login", "Account")"><i class="fas fa-sign-out-alt"></i><span class="logout-text">Logout</span></a></div>
                </div>
            </div>
        </div>

        <div class="main-content">
            <div class="top-header">
                <div class="page-title">
                    <h2><i class="fas fa-edit me-2" style="color: #C5A059;"></i>Edit Competition</h2>
                    <p>Update existing competition details from database</p>
                </div>
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <div class="theme-toggle" id="themeToggle"><i class="fas fa-sun" id="themeIcon"></i></div>
                    <div class="user-avatar"><i class="fas fa-user-tie"></i></div>
                </div>
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <div class="container-fluid mt-4">
                <div class="row">
                    <div class="col-lg-8 mx-auto">
                        <div class="form-container">
                            <h3 class="form-title"><i class="fas fa-edit"></i> Edit Competition</h3>

                            <form asp-controller="Staff" asp-action="EditCompetition" method="post">
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="CompetitionId" value="@Model.CompetitionId" />

                                <div class="form-group">
                                    <label><i class="fas fa-heading"></i> Competition Title *</label>
                                    <input type="text" class="form-control" name="Title" value="@Model.Title" required>
                                </div>

                                <div class="form-group">
                                    <label><i class="fas fa-align-left"></i> Description / Theme</label>
                                    <textarea class="form-control" name="Description" rows="4" placeholder="Describe competition theme and details...">@Model.Description</textarea>
                                </div>

                                <div class="form-row">
                                    <div class="form-group">
                                        <label><i class="fas fa-calendar-alt"></i> Start Date *</label>
                                        <input type="datetime-local" class="form-control" name="StartDate" value="@Model.StartDate.ToString("yyyy-MM-ddTHH:mm")" required>
                                    </div>

                                    <div class="form-group">
                                        <label><i class="fas fa-calendar-check"></i> End Date *</label>
                                        <input type="datetime-local" class="form-control" name="EndDate" value="@Model.EndDate.ToString("yyyy-MM-ddTHH:mm")" required>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label><i class="fas fa-list-check"></i> Conditions / Rules</label>
                                    <textarea class="form-control" name="Conditions" rows="4" placeholder="Only JPEG files allowed. Students must submit before deadline.">@Model.Conditions</textarea>
                                </div>

                                <div class="form-group">
                                    <label><i class="fas fa-tag"></i> Status *</label>
                                    <select class="form-select" name="Status" required>
                                        @if (Model.Status == CompetitionStatus.Upcoming)
                                        {
                                            <option value="1" selected>Upcoming</option>
                                        }
                                        else
                                        {
                                            <option value="1">Upcoming</option>
                                        }

                                        @if (Model.Status == CompetitionStatus.Ongoing)
                                        {
                                            <option value="2" selected>Ongoing</option>
                                        }
                                        else
                                        {
                                            <option value="2">Ongoing</option>
                                        }

                                        @if (Model.Status == CompetitionStatus.Concluded)
                                        {
                                            <option value="3" selected>Concluded</option>
                                        }
                                        else
                                        {
                                            <option value="3">Concluded</option>
                                        }
                                    </select>
                                </div>

                                <div class="button-group">
                                    <a href="@Url.Action("ManageCompetitions", "Staff")" class="btn-cancel">
                                        <i class="fas fa-times"></i> Cancel
                                    </a>
                                    <button type="submit" class="btn-submit">
                                        <i class="fas fa-save"></i> Update Competition
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <div class="footer">
                <p>© 2025 ARTISTIC - Institute of Fine Arts. All rights reserved.</p>
            </div>
        </div>
    </div>

    <script>
        const themeToggle = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');
        const body = document.body;

        if (localStorage.getItem('staffTheme') === 'light') {
            body.classList.remove('dark-mode');
            body.classList.add('light-mode');
            themeIcon.classList.remove('fa-sun');
            themeIcon.classList.add('fa-moon');
        }

        themeToggle.addEventListener('click', () => {
            if (body.classList.contains('dark-mode')) {
                body.classList.remove('dark-mode');
                body.classList.add('light-mode');
                localStorage.setItem('staffTheme', 'light');
                themeIcon.classList.remove('fa-sun');
                themeIcon.classList.add('fa-moon');
            } else {
                body.classList.remove('light-mode');
                body.classList.add('dark-mode');
                localStorage.setItem('staffTheme', 'dark');
                themeIcon.classList.remove('fa-moon');
                themeIcon.classList.add('fa-sun');
            }
        });

        function goToHome() {
            window.location.href = '@Url.Action("Index", "Home")';
        }
    </script>
</body>
</html>
