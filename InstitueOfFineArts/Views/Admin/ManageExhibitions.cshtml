@model IEnumerable<InstituteOfFineArts.Models.Exhibition>
@using InstituteOfFineArts.Models

@{
    ViewData["Title"] = "Manage Exhibitions";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Manage Exhibitions | Admin Panel | ARTISTIC Institute</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;400;500;600;700;800&family=Playfair+Display:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body.dark-mode {
            background: #0A0A0A;
            color: #FFFFFF;
        }

        body.light-mode {
            background: #F0F2F5;
            color: #1A1A1A;
        }

        .app-wrapper {
            display: flex;
            min-height: 100vh;
            position: relative;
        }

        /* ========== SIDEBAR ========== */
        .sidebar {
            position: fixed;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            width: 70px;
            border-radius: 40px;
            transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
            z-index: 1000;
            overflow: hidden;
            backdrop-filter: blur(12px);
        }

            .sidebar:hover {
                width: 260px;
                border-radius: 28px;
            }

        body.dark-mode .sidebar {
            background: rgba(20, 20, 30, 0.9);
            border: 1px solid rgba(197, 160, 89, 0.15);
            box-shadow: 0 20px 40px rgba(0,0,0,0.3);
        }

        body.light-mode .sidebar {
            background: rgba(255, 255, 255, 0.95);
            border: 1px solid rgba(0,0,0,0.08);
            box-shadow: 0 20px 40px rgba(0,0,0,0.08);
        }

        @@media (max-width: 992px) {
            .sidebar {
                left: -70px;
            }

                .sidebar.active {
                    left: 20px;
                }

            .menu-toggle {
                display: block !important;
            }

            .main-content {
                margin-left: 0 !important;
                width: 100%;
                padding: 16px !important;
            }
        }

        .sidebar-inner {
            padding: 24px 0;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        .sidebar-profile {
            width: 100%;
            text-align: center;
            padding: 0 0 20px 0;
            margin-bottom: 20px;
            border-bottom: 1px solid;
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        body.dark-mode .sidebar-profile {
            border-color: rgba(255,255,255,0.08);
        }

        body.light-mode .sidebar-profile {
            border-color: rgba(0,0,0,0.06);
        }

        .profile-avatar {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg, #C5A059, #E8C87A);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            color: #000;
            transition: all 0.3s ease;
        }

        .sidebar:hover .profile-avatar {
            width: 50px;
            height: 50px;
            font-size: 1.4rem;
        }

        .profile-name {
            margin-top: 10px;
            font-size: 0;
            opacity: 0;
            transition: all 0.3s ease;
            white-space: nowrap;
        }

        .sidebar:hover .profile-name {
            font-size: 0.85rem;
            opacity: 1;
            margin-top: 12px;
        }

        .profile-role {
            margin-top: 4px;
            font-size: 0;
            opacity: 0;
            transition: all 0.3s ease;
            white-space: nowrap;
        }

        .sidebar:hover .profile-role {
            font-size: 0.65rem;
            opacity: 0.6;
        }

        .nav-menu {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 6px;
            padding: 0 12px;
        }

        .nav-item {
            width: 100%;
            border-radius: 30px;
            transition: all 0.25s ease;
        }

            .nav-item a {
                display: flex;
                align-items: center;
                gap: 16px;
                padding: 12px;
                text-decoration: none;
                border-radius: 30px;
                transition: all 0.25s ease;
                font-weight: 500;
                white-space: nowrap;
            }

                .nav-item a i {
                    width: 28px;
                    height: 28px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 1.1rem;
                    color: #C5A059;
                    flex-shrink: 0;
                }

        .nav-text {
            font-size: 0;
            opacity: 0;
            transition: all 0.3s ease;
            overflow: hidden;
        }

        .sidebar:hover .nav-text {
            font-size: 0.85rem;
            opacity: 1;
        }

        body.dark-mode .nav-item a {
            color: rgba(255,255,255,0.7);
        }

        body.light-mode .nav-item a {
            color: #4A5568;
        }

        .nav-item:hover a {
            transform: translateX(4px);
        }

        body.dark-mode .nav-item:hover a {
            background: rgba(197,160,89,0.12);
            color: #C5A059;
        }

        body.light-mode .nav-item:hover a {
            background: rgba(197,160,89,0.08);
            color: #C5A059;
        }

        body.dark-mode .nav-item.active a {
            background: rgba(197,160,89,0.15);
            color: #C5A059;
        }

        body.light-mode .nav-item.active a {
            background: rgba(197,160,89,0.1);
            color: #C5A059;
        }

        .nav-footer {
            width: 100%;
            margin-top: 30px;
            padding: 20px 12px 0;
            border-top: 1px solid;
        }

        body.dark-mode .nav-footer {
            border-color: rgba(255,255,255,0.08);
        }

        body.light-mode .nav-footer {
            border-color: rgba(0,0,0,0.06);
        }

        .logout-item {
            width: 100%;
            border-radius: 30px;
        }

            .logout-item a {
                display: flex;
                align-items: center;
                gap: 16px;
                padding: 12px;
                text-decoration: none;
                border-radius: 30px;
                transition: all 0.25s ease;
                white-space: nowrap;
            }

                .logout-item a i {
                    width: 28px;
                    font-size: 1.1rem;
                    flex-shrink: 0;
                }

        body.dark-mode .logout-item a {
            color: rgba(255,255,255,0.7);
        }

        body.light-mode .logout-item a {
            color: #E53E3E;
        }

        .logout-text {
            font-size: 0;
            opacity: 0;
            transition: all 0.3s ease;
        }

        .sidebar:hover .logout-text {
            font-size: 0.85rem;
            opacity: 1;
        }

        .logout-item:hover a {
            transform: translateX(4px);
        }

        body.dark-mode .logout-item:hover a {
            background: rgba(229,62,62,0.15);
            color: #E53E3E;
        }

        body.light-mode .logout-item:hover a {
            background: #FEE2E2;
            color: #E53E3E;
        }

        /* ========== MAIN CONTENT ========== */
        .main-content {
            flex: 1;
            margin-left: 100px;
            padding: 24px 32px;
            overflow-x: hidden;
            transition: all 0.3s ease;
        }

        @@media (max-width: 992px) {
            .main-content {
                margin-left: 0;
            }
        }

        .top-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            padding: 12px 24px;
            border-radius: 24px;
            margin-bottom: 28px;
        }

        body.dark-mode .top-header {
            background: rgba(20, 20, 20, 0.7);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.05);
        }

        body.light-mode .top-header {
            background: #FFFFFF;
            border: 1px solid #E8ECEF;
            box-shadow: 0 2px 8px rgba(0,0,0,0.02);
        }

        .menu-toggle {
            display: none;
            background: transparent;
            border: none;
            font-size: 1.4rem;
            cursor: pointer;
            padding: 8px 12px;
            border-radius: 12px;
        }

        body.dark-mode .menu-toggle {
            color: white;
        }

        body.light-mode .menu-toggle {
            color: #333;
        }

        .page-title h2 {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            font-weight: 700;
        }

        .page-title p {
            font-size: 0.8rem;
            opacity: 0.7;
        }

        .theme-toggle {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        body.dark-mode .theme-toggle {
            background: rgba(255,255,255,0.08);
            color: #FFD700;
        }

        body.light-mode .theme-toggle {
            background: #F0F2F5;
            color: #C5A059;
        }

        .theme-toggle:hover {
            transform: rotate(15deg);
        }

        .user-dropdown {
            position: relative;
            cursor: pointer;
        }

        .user-avatar {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg, #C5A059, #E8C87A);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            color: #000;
        }

        .dropdown-menu-custom {
            position: absolute;
            top: 50px;
            right: 0;
            min-width: 160px;
            border-radius: 16px;
            padding: 8px;
            display: none;
            z-index: 100;
        }

        body.dark-mode .dropdown-menu-custom {
            background: #1A1A2E;
            border: 1px solid rgba(197,160,89,0.2);
        }

        body.light-mode .dropdown-menu-custom {
            background: white;
            border: 1px solid #E8ECEF;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        .user-dropdown:hover .dropdown-menu-custom {
            display: block;
        }

        .dropdown-item {
            padding: 10px 14px;
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            border-radius: 12px;
            transition: 0.2s;
        }

        body.dark-mode .dropdown-item {
            color: white;
        }

        body.light-mode .dropdown-item {
            color: #333;
        }

        .dropdown-item:hover {
            background: rgba(197,160,89,0.15);
        }

        /* Stats Cards */
        .stat-card, .chart-card, .exhibitions-table {
            border-radius: 24px;
            padding: 1.5rem;
            transition: all 0.3s ease;
            height: 100%;
        }

        body.dark-mode .stat-card,
        body.dark-mode .chart-card,
        body.dark-mode .exhibitions-table {
            background: rgba(20, 20, 20, 0.7);
            border: 1px solid rgba(255,255,255,0.05);
        }

        body.light-mode .stat-card,
        body.light-mode .chart-card,
        body.light-mode .exhibitions-table {
            background: #FFFFFF;
            border: 1px solid #E8ECEF;
            box-shadow: 0 2px 8px rgba(0,0,0,0.02);
        }

        .stat-card:hover, .chart-card:hover {
            transform: translateY(-3px);
        }

        .stat-icon {
            font-size: 2rem;
            color: #C5A059;
            margin-bottom: 0.8rem;
        }

        .stat-value {
            font-size: 2rem;
            font-weight: 700;
        }

        .stat-label {
            font-size: 0.8rem;
            opacity: 0.7;
        }

        .chart-title {
            font-weight: 600;
            margin-bottom: 1rem;
            color: #C5A059;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        /* Filter Bar */
        .filter-bar {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            margin-bottom: 1.5rem;
            align-items: center;
            justify-content: space-between;
        }

        .search-box {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 0.4rem 1rem;
            border-radius: 50px;
        }

        body.dark-mode .search-box {
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.1);
        }

        body.light-mode .search-box {
            background: #F0F2F5;
            border: 1px solid #E8ECEF;
        }

        .search-box input {
            background: transparent;
            border: none;
            outline: none;
            color: inherit;
            width: 200px;
        }

        .filter-select {
            background: transparent;
            border: 1px solid #C5A059;
            border-radius: 50px;
            padding: 0.4rem 1rem;
            color: inherit;
        }

        body.dark-mode .filter-select option {
            background: #1A1A2E;
            color: #FFFFFF;
        }

        body.light-mode .filter-select option {
            background: white;
            color: #333;
        }

        /* Exhibitions Grid */
        .exhibitions-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 1.5rem;
            margin-top: 1rem;
        }

        .exhibition-card {
            background: var(--card-bg);
            border-radius: 20px;
            overflow: hidden;
            transition: all 0.3s ease;
            border: 1px solid var(--border-color);
        }

        body.dark-mode .exhibition-card {
            background: rgba(20, 20, 20, 0.7);
            border-color: rgba(255,255,255,0.06);
        }

        body.light-mode .exhibition-card {
            background: #FFFFFF;
            border-color: #E8ECEF;
            box-shadow: 0 2px 8px rgba(0,0,0,0.02);
        }

        .exhibition-card:hover {
            transform: translateY(-5px);
            border-color: #C5A059;
        }

        .exhibition-img {
            height: 160px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            color: white;
        }

        .exhibition-info {
            padding: 1.2rem;
        }

        .exhibition-title {
            font-size: 1.2rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            color: #C5A059;
        }

        .exhibition-meta {
            display: flex;
            gap: 0.8rem;
            font-size: 0.7rem;
            color: var(--gray);
            margin-bottom: 0.8rem;
            flex-wrap: wrap;
        }

        .exhibition-desc {
            font-size: 0.8rem;
            line-height: 1.4;
            margin-bottom: 1rem;
            color: var(--text-color);
        }

        .exhibition-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 1rem;
            padding-top: 0.5rem;
            border-top: 1px solid;
            border-color: inherit;
        }

        /* Status Badges */
        .badge-status {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 0.25rem 0.8rem;
            border-radius: 30px;
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .badge-current {
            background: #28a745;
            color: white;
        }

        .badge-upcoming {
            background: #ffc107;
            color: #000;
        }

        .badge-past {
            background: #6c757d;
            color: white;
        }

        .badge-status i {
            font-size: 0.65rem;
        }

        .btn-icon {
            background: transparent;
            border: none;
            cursor: pointer;
            padding: 5px 8px;
            border-radius: 8px;
            transition: all 0.3s ease;
            font-size: 0.85rem;
        }

        body.dark-mode .btn-icon {
            color: #ccc;
        }

        body.light-mode .btn-icon {
            color: #555;
        }

        .btn-icon:hover {
            background: rgba(197, 160, 89, 0.15);
            transform: translateY(-2px);
        }

        .btn-icon.edit:hover {
            color: #ffc107;
        }

        .btn-icon.delete:hover {
            color: #dc3545;
        }

        /* Pagination */
        .pagination {
            display: flex;
            justify-content: center;
            gap: 0.5rem;
            margin-top: 2rem;
            flex-wrap: wrap;
        }

        .page-btn {
            padding: 0.4rem 0.8rem;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        body.dark-mode .page-btn {
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.1);
            color: white;
        }

        body.light-mode .page-btn {
            background: #F0F2F5;
            border: 1px solid #E8ECEF;
            color: #333;
        }

        .page-btn.active {
            background: linear-gradient(135deg, #C5A059, #E8C87A);
            color: #000;
            border: none;
        }

        .page-btn:hover:not(.active) {
            transform: translateY(-2px);
        }

        /* Modal */
        .modal-custom {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.7);
            backdrop-filter: blur(8px);
            z-index: 2000;
            align-items: center;
            justify-content: center;
        }

            .modal-custom.active {
                display: flex;
            }

        .modal-content-custom {
            width: 90%;
            max-width: 550px;
            max-height: 85vh;
            overflow-y: auto;
            border-radius: 28px;
            padding: 2rem;
            position: relative;
        }

        body.dark-mode .modal-content-custom {
            background: #1A1A2E;
            border: 1px solid rgba(197,160,89,0.2);
        }

        body.light-mode .modal-content-custom {
            background: white;
            border: 1px solid #E8ECEF;
        }

        .modal-close {
            position: absolute;
            top: 15px;
            right: 20px;
            font-size: 1.5rem;
            cursor: pointer;
            background: none;
            border: none;
        }

        body.dark-mode .modal-close {
            color: white;
        }

        body.light-mode .modal-close {
            color: #333;
        }

        .modal-close:hover {
            color: #C5A059;
            transform: rotate(90deg);
        }

        .form-group {
            margin-bottom: 1.2rem;
        }

        body.dark-mode .form-group label {
            color: #C5A059 !important;
            font-weight: 500;
        }

        body.light-mode .form-group label {
            color: #4A148C;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.4rem;
            font-size: 0.8rem;
            font-weight: 500;
        }

        body.dark-mode .form-control,
        body.dark-mode .form-select,
        body.dark-mode textarea.form-control {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(197,160,89,0.3);
            color: #FFFFFF !important;
        }

            body.dark-mode .form-control::placeholder,
            body.dark-mode textarea.form-control::placeholder {
                color: rgba(255,255,255,0.6) !important;
            }

            body.dark-mode .form-select option {
                background: #1A1A2E;
                color: #FFFFFF;
            }

        body.light-mode .form-control,
        body.light-mode .form-select,
        body.light-mode textarea.form-control {
            background: #F0F2F5;
            border: 1px solid #E8ECEF;
            color: #333;
        }

            body.light-mode .form-select option {
                background: white;
                color: #333;
            }

        .btn-gold {
            background: linear-gradient(135deg, #C5A059, #E8C87A);
            color: #000;
            border: none;
            padding: 0.6rem 1.5rem;
            border-radius: 50px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .btn-gold:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(197,160,89,0.3);
            }

        .btn-secondary-custom {
            background: #6c757d;
            color: white;
            border: none;
            padding: 0.6rem 1.5rem;
            border-radius: 50px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .btn-secondary-custom:hover {
                transform: translateY(-2px);
            }

        /* SweetAlert2 Dark Mode Fix */
        body.dark-mode .swal2-popup {
            background: #1A1A2E !important;
            color: white !important;
            border: 1px solid rgba(197,160,89,0.2) !important;
        }

        body.light-mode .swal2-popup {
            background: white !important;
            color: #1A1A1A !important;
        }

        /* Footer */
        .footer {
            padding: 1rem;
            margin-top: 2rem;
            text-align: center;
            border-radius: 20px;
            font-size: 0.7rem;
        }

        body.dark-mode .footer {
            background: rgba(20, 20, 20, 0.5);
            color: rgba(255,255,255,0.4);
        }

        body.light-mode .footer {
            background: #FFFFFF;
            color: #8A8A8A;
            border: 1px solid #E8ECEF;
        }

        .scroll-top {
            position: fixed;
            bottom: 20px;
            right: 20px;
            width: 45px;
            height: 45px;
            background: linear-gradient(135deg, #C5A059, #E8C87A);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
            border: none;
            z-index: 999;
        }

            .scroll-top.show {
                opacity: 1;
                visibility: visible;
            }

        @@media (max-width: 768px) {
            .filter-bar {
                flex-direction: column;
                align-items: stretch;
            }

            .search-box {
                width: 100%;
            }

                .search-box input {
                    width: 100%;
                }

            .filter-select {
                width: 100%;
            }

            .exhibitions-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body class="dark-mode">

    <div class="app-wrapper">
        <!-- SIDEBAR -->
        <div class="sidebar">
            <div class="sidebar-inner">
                <div class="sidebar-profile" onclick="goToHome()">
                    <div class="profile-avatar"><i class="fas fa-palette"></i></div>
                    <div class="profile-name">ARTISTIC</div>
                    <div class="profile-role">Admin Panel</div>
                </div>
                <div class="nav-menu">
                    <div class="nav-item"><a href="@Url.Action("Dashboard", "Admin")"><i class="fas fa-home"></i><span class="nav-text">Dashboard</span></a></div>
                    <div class="nav-item"><a href="@Url.Action("ManageStaff", "Admin")"><i class="fas fa-users"></i><span class="nav-text">Manage Staff</span></a></div>
                    <div class="nav-item"><a href="@Url.Action("ManageStudents", "Admin")"><i class="fas fa-user-graduate"></i><span class="nav-text">Manage Students</span></a></div>
                    <div class="nav-item"><a href="@Url.Action("ManageCompetitions", "Admin")"><i class="fas fa-trophy"></i><span class="nav-text">Competitions</span></a></div>
                    <div class="nav-item"><a href="@Url.Action("ManageExhibitions", "Admin")"><i class="fas fa-building"></i><span class="nav-text">Exhibitions</span></a></div>
                    <div class="nav-item active"><a href="@Url.Action("Announcements", "Admin")"><i class="fas fa-bullhorn"></i><span class="nav-text">Announcements</span></a></div>
                    <div class="nav-item"><a href="@Url.Action("Reports", "Admin")"><i class="fas fa-chart-bar"></i><span class="nav-text">Reports</span></a></div>
                </div>

                <div class="nav-footer">
                    <div class="logout-item"><a href="#" onclick="logout()"><i class="fas fa-sign-out-alt"></i><span class="logout-text">Logout</span></a></div>
                </div>
            </div>
        </div>

        <div class="main-content">
            <div class="top-header">
                <button class="menu-toggle" id="menuToggle"><i class="fas fa-bars"></i></button>
                <div class="page-title">
                    <h2><i class="fas fa-building me-2" style="color: #C5A059;"></i>Manage Exhibitions</h2>
                    <p>Create, edit, and manage all art exhibitions</p>
                </div>
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <div class="theme-toggle" id="themeToggle"><i class="fas fa-sun" id="themeIcon"></i></div>
                    <div class="user-dropdown">
                        <div class="user-avatar"><i class="fas fa-user-tie"></i></div>
                        <div class="dropdown-menu-custom">
                            <a href="#" class="dropdown-item" onclick="logout()"><i class="fas fa-sign-out-alt"></i> Logout</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="container-fluid mt-4">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }

                <!-- Stats Cards -->
                <div class="row g-4 mb-4">
                    <div class="col-xl-3 col-md-6" data-aos="fade-up" data-aos-delay="100">
                        <div class="stat-card">
                            <div class="stat-icon"><i class="fas fa-building"></i></div>
                            <div class="stat-value" id="totalExhibitions">@ViewBag.TotalExhibitions</div>
                            <div class="stat-label">Total Exhibitions</div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6" data-aos="fade-up" data-aos-delay="200">
                        <div class="stat-card">
                            <div class="stat-icon"><i class="fas fa-play-circle"></i></div>
                            <div class="stat-value" id="currentExhibitions">@ViewBag.OngoingExhibitions</div>
                            <div class="stat-label">Current</div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6" data-aos="fade-up" data-aos-delay="300">
                        <div class="stat-card">
                            <div class="stat-icon"><i class="fas fa-clock"></i></div>
                            <div class="stat-value" id="upcomingExhibitions">@ViewBag.UpcomingExhibitions</div>
                            <div class="stat-label">Upcoming</div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6" data-aos="fade-up" data-aos-delay="400">
                        <div class="stat-card">
                            <div class="stat-icon"><i class="fas fa-check-circle"></i></div>
                            <div class="stat-value" id="pastExhibitions">@ViewBag.CompletedExhibitions</div>
                            <div class="stat-label">Completed</div>
                        </div>
                    </div>
                </div>

                <!-- Filter Bar -->
                <div class="row g-4 mb-4">
                    <div class="col-12">
                        <div class="chart-card">
                            <div class="filter-bar">
                                <div class="search-box">
                                    <i class="fas fa-search"></i>
                                    <input type="text" id="searchInput" placeholder="Search exhibitions by title, venue...">
                                </div>
                                <select class="filter-select" id="statusFilter">
                                    <option value="all">All Status</option>
                                    <option value="current">Current</option>
                                    <option value="upcoming">Upcoming</option>
                                    <option value="past">Past</option>
                                </select>
                                <button class="btn-gold" onclick="openAddExhibitionModal()" style="padding: 0.4rem 1rem;"><i class="fas fa-plus"></i> Add Exhibition</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Exhibitions Grid -->
                <div class="row g-4">
                    <div class="col-12">
                        <div class="exhibitions-table">
                            <div class="chart-title"><i class="fas fa-calendar-alt"></i> Exhibitions List</div>
                            <div class="exhibitions-grid" id="exhibitionsGrid">
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var exhibition in Model)
                                    {
                                        var statusText = exhibition.Status.ToString();
                                        var badgeClass = exhibition.Status == ExhibitionStatus.Ongoing ? "badge-current"
                                        : exhibition.Status == ExhibitionStatus.Upcoming ? "badge-upcoming"
                                        : "badge-past";

                                        var badgeIcon = exhibition.Status == ExhibitionStatus.Ongoing ? "fa-play"
                                        : exhibition.Status == ExhibitionStatus.Upcoming ? "fa-clock"
                                        : "fa-check-circle";

                                        <div class="exhibition-card" data-status="@statusText.ToLower()">
                                            <div class="exhibition-img">
                                                @if (!string.IsNullOrEmpty(exhibition.ImagePath))
                                                {
                                                    <img src="@exhibition.ImagePath" alt="@exhibition.ExhibitionName" style="width: 100%; height: 100%; object-fit: cover;">
                                                }
                                                else
                                                {
                                                    <i class="fas fa-palette"></i>
                                                }
                                            </div>
                                            <div class="exhibition-info">
                                                <div class="exhibition-title">@exhibition.ExhibitionName</div>
                                                <div class="exhibition-meta">
                                                    <span><i class="far fa-calendar-alt"></i> @exhibition.ExhibitionStartDate.ToString("MMM dd, yyyy") - @exhibition.ExhibitionEndDate.ToString("MMM dd, yyyy")</span>
                                                    <span><i class="fas fa-map-marker-alt"></i> @exhibition.Venue, @exhibition.City</span>
                                                </div>
                                                <div class="exhibition-desc">
                                                    @(string.IsNullOrWhiteSpace(exhibition.Description) ? "No description available." : exhibition.Description)
                                                </div>
                                                <div class="exhibition-footer">
                                                    <span class="badge-status @badgeClass"><i class="fas @badgeIcon"></i> @statusText</span>

                                                    <div>
                                                        <button class="btn-icon edit" type="button" title="Edit" onclick="openModal('editExhibitionModal_@exhibition.ExhibitionId')"><i class="fas fa-edit"></i></button>
                                                        <button class="btn-icon delete" type="button" title="Delete" onclick="openModal('deleteExhibitionModal_@exhibition.ExhibitionId')"><i class="fas fa-trash-alt"></i></button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Edit Exhibition Modal -->
                                        <div class="modal-custom" id="editExhibitionModal_@exhibition.ExhibitionId">
                                            <div class="modal-content-custom">
                                                <button class="modal-close" onclick="closeModal('editExhibitionModal_@exhibition.ExhibitionId')">&times;</button>
                                                <h3>Edit Exhibition</h3>

                                                <form asp-action="CreateExhibition" asp-controller="Admin" method="post" enctype="multipart/form-data">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="ExhibitionId" value="@exhibition.ExhibitionId" />

                                                    <div class="form-group">
                                                        <label>Exhibition Name *</label>
                                                        <input type="text" class="form-control" name="ExhibitionName" value="@exhibition.ExhibitionName" required>
                                                    </div>

                                                    <div class="form-group">
                                                        <label>Description</label>
                                                        <textarea class="form-control" name="Description" rows="3">@exhibition.Description</textarea>
                                                    </div>

                                                    <div class="form-group">
                                                        <label>Venue *</label>
                                                        <input type="text" class="form-control" name="Venue" value="@exhibition.Venue" required>
                                                    </div>

                                                    <div class="form-group">
                                                        <label>City</label>
                                                        <input type="text" class="form-control" name="City" value="@exhibition.City">
                                                    </div>

                                                    <div class="form-group">
                                                        <label>Country</label>
                                                        <input type="text" class="form-control" name="Country" value="@exhibition.Country">
                                                    </div>

                                                    <div class="form-group">
                                                        <label>Start Date *</label>
                                                        <input type="date" class="form-control" name="ExhibitionStartDate" value="@exhibition.ExhibitionStartDate.ToString("yyyy-MM-dd")" required>
                                                    </div>

                                                    <div class="form-group">
                                                        <label>End Date *</label>
                                                        <input type="date" class="form-control" name="ExhibitionEndDate" value="@exhibition.ExhibitionEndDate.ToString("yyyy-MM-dd")" required>
                                                    </div>

                                                    <div class="form-group">
                                                        <label>Status</label>
                                                        <select class="form-select" name="Status">
                                                            <option value="Upcoming" selected="@(exhibition.Status == ExhibitionStatus.Upcoming)">Upcoming</option>
                                                            <option value="Ongoing" selected="@(exhibition.Status == ExhibitionStatus.Ongoing)">Ongoing</option>
                                                            <option value="Concluded" selected="@(exhibition.Status == ExhibitionStatus.Concluded)">Concluded</option>
                                                        </select>
                                                    </div>


                                                    <div class="form-group">
                                                        <label>Additional Notes</label>
                                                        <textarea class="form-control" name="AdditionalNotes" rows="3">@exhibition.AdditionalNotes</textarea>
                                                    </div>

                                                    <div class="form-group">
                                                        <label>Exhibition Image (Optional)</label>
                                                        <input type="file" class="form-control" name="ImageFile" accept="image/*" />
                                                        <small class="text-muted">Upload JPG, JPEG or PNG image</small>
                                                    </div>

                                                    <div class="d-flex gap-2 mt-3">
                                                        <button type="button" class="btn-secondary-custom" style="flex:1;" onclick="closeModal('editExhibitionModal_@exhibition.ExhibitionId')">Cancel</button>
                                                        <button type="submit" class="btn-gold" style="flex:2;">Update Exhibition</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>

                                        <!-- Delete Exhibition Modal -->
                                        <div class="modal-custom" id="deleteExhibitionModal_@exhibition.ExhibitionId">
                                            <div class="modal-content-custom">
                                                <button class="modal-close" onclick="closeModal('deleteExhibitionModal_@exhibition.ExhibitionId')">&times;</button>
                                                <h3>Delete Exhibition</h3>
                                                <p>Are you sure you want to delete <strong>@exhibition.ExhibitionName</strong>?</p>

                                                <form asp-controller="Admin" asp-action="DeleteExhibition" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@exhibition.ExhibitionId" />

                                                    <div class="mt-3 d-flex gap-2">
                                                        <button type="submit" class="btn-gold">Yes, Delete</button>
                                                        <button type="button" class="btn-secondary-custom" onclick="closeModal('deleteExhibitionModal_@exhibition.ExhibitionId')">Cancel</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-center" style="grid-column:1/-1; padding: 3rem;">No exhibitions found</div>
                                }
                            </div>
                            <div class="pagination" id="pagination"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="footer">
                <p>© 2025 ARTISTIC - Institute of Fine Arts. All rights reserved.</p>
            </div>
        </div>
    </div>

    <!-- Add/Edit Exhibition Modal -->
    <div class="modal-custom" id="exhibitionModal">
        <div class="modal-content-custom">
            <button class="modal-close" onclick="closeModal('exhibitionModal')">&times;</button>
            <h3 id="modalTitle">Add New Exhibition</h3>
            <form asp-controller="Admin" asp-action="CreateExhibition" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label>Exhibition Name *</label>
                    <input type="text" class="form-control" name="ExhibitionName" placeholder="e.g., Summer Art Exhibition 2026" required>
                </div>

                <div class="form-group">
                    <label>Description</label>
                    <textarea class="form-control" name="Description" rows="3" placeholder="Describe the exhibition..."></textarea>
                </div>

                <div class="form-group">
                    <label>Venue *</label>
                    <input type="text" class="form-control" name="Venue" placeholder="e.g., Institute Art Gallery" required>
                </div>

                <div class="form-group">
                    <label>City</label>
                    <input type="text" class="form-control" name="City" placeholder="e.g., Karachi">
                </div>

                <div class="form-group">
                    <label>Country</label>
                    <input type="text" class="form-control" name="Country" value="Pakistan">
                </div>

                <div class="form-group">
                    <label>Start Date *</label>
                    <input type="date" class="form-control" name="ExhibitionStartDate" required>
                </div>

                <div class="form-group">
                    <label>End Date *</label>
                    <input type="date" class="form-control" name="ExhibitionEndDate" required>
                </div>

                <div class="form-group">
                    <label>Status</label>
                    <select class="form-select" name="Status">
                        <option value="Upcoming">Upcoming</option>
                        <option value="Ongoing">Ongoing</option>
                        <option value="Concluded">Concluded</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Additional Notes</label>
                    <textarea class="form-control" name="AdditionalNotes" rows="3" placeholder="Any extra notes..."></textarea>
                </div>

                <div class="form-group">
                    <label>Exhibition Image (Optional)</label>
                    <input type="file" class="form-control" name="ImageFile" accept="image/*" />
                    <small class="text-muted">Upload JPG, JPEG or PNG image</small>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button type="button" class="btn-secondary-custom" style="flex:1;" onclick="closeModal('exhibitionModal')">Cancel</button>
                    <button type="submit" class="btn-gold" style="flex:2;">Save Exhibition</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal-custom" id="deleteModal">
        <div class="modal-content-custom">
            <button class="modal-close" onclick="closeModal('deleteModal')">&times;</button>
            <h3>Delete Exhibition</h3>
            <p id="deleteMessage">Are you sure you want to delete this exhibition? This action cannot be undone.</p>
            <div class="mt-3 d-flex gap-2">
                <button class="btn-gold" onclick="confirmDelete()">Yes, Delete</button>
                <button class="btn-secondary-custom" onclick="closeModal('deleteModal')">Cancel</button>
            </div>
        </div>
    </div>

    <button class="scroll-top" id="scrollTop"><i class="fas fa-arrow-up"></i></button>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        AOS.init({ duration: 800, once: true });

        // Dark/Light Mode
        const themeToggle = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');
        const body = document.body;

        if (localStorage.getItem('adminTheme') === 'light') {
        body.classList.remove('dark-mode');
        body.classList.add('light-mode');
        themeIcon.classList.remove('fa-sun');
        themeIcon.classList.add('fa-moon');
        } else {
        body.classList.add('dark-mode');
        body.classList.remove('light-mode');
        themeIcon.classList.remove('fa-moon');
        themeIcon.classList.add('fa-sun');
        }

        themeToggle.addEventListener('click', () => {
        if (body.classList.contains('dark-mode')) {
        body.classList.remove('dark-mode');
        body.classList.add('light-mode');
        localStorage.setItem('adminTheme', 'light');
        themeIcon.classList.remove('fa-sun');
        themeIcon.classList.add('fa-moon');
        } else {
        body.classList.remove('light-mode');
        body.classList.add('dark-mode');
        localStorage.setItem('adminTheme', 'dark');
        themeIcon.classList.remove('fa-moon');
        themeIcon.classList.add('fa-sun');
        }
        });

        const menuToggle = document.getElementById('menuToggle');
        const sidebar = document.querySelector('.sidebar');
        if (menuToggle) menuToggle.addEventListener('click', () => sidebar.classList.toggle('active'));

        const scrollBtn = document.getElementById('scrollTop');
        window.addEventListener('scroll', () => {
        if (window.scrollY > 300) scrollBtn.classList.add('show');
        else scrollBtn.classList.remove('show');
        });
        scrollBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

        function goToHome() {
        window.location.href = '@Url.Action("Dashboard", "Admin")';
        }

        function openModal(id) {
        document.getElementById(id).classList.add('active');
        document.body.style.overflow = 'hidden';
        }

        function closeModal(id) {
        document.getElementById(id).classList.remove('active');
        document.body.style.overflow = 'auto';
        }

        function showSuccess(msg) {
        Swal.fire({
        title: 'Success!',
        text: msg,
        icon: 'success',
        confirmButtonColor: '#C5A059',
        background: body.classList.contains('dark-mode') ? '#1A1A2E' : '#FFFFFF',
        color: body.classList.contains('dark-mode') ? 'white' : '#333',
        timer: 2000,
        showConfirmButton: false
        });
        }

        function logout() {
        Swal.fire({
        title: 'Logout?',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#C5A059',
        confirmButtonText: 'Yes',
        background: body.classList.contains('dark-mode') ? '#1A1A2E' : '#FFFFFF',
        color: body.classList.contains('dark-mode') ? 'white' : '#333'
        }).then((r) => { if (r.isConfirmed) window.location.href = '@Url.Action("Dashboard", "Admin")'; });
        }

        function openAddExhibitionModal() {
            const modalTitle = document.getElementById('modalTitle');
            if (modalTitle) modalTitle.innerText = 'Add New Exhibition';
            openModal('exhibitionModal');
        }

        // Search is client-side visual helper only. It hides/shows cards already loaded from database.
        const searchInput = document.getElementById('searchInput');
        const statusFilter = document.getElementById('statusFilter');

        function filterCards() {
            const search = searchInput ? searchInput.value.toLowerCase() : '';
            const status = statusFilter ? statusFilter.value : 'all';

            document.querySelectorAll('.exhibition-card').forEach(card => {
                const text = card.innerText.toLowerCase();
                let statusMatch = true;

                if (status === 'current') statusMatch = text.includes('current');
                else if (status === 'upcoming') statusMatch = text.includes('upcoming');
                else if (status === 'past') statusMatch = text.includes('concluded');

                const searchMatch = search === '' || text.includes(search);
                card.style.display = (searchMatch && statusMatch) ? '' : 'none';
            });
        }

        if (searchInput) searchInput.addEventListener('input', filterCards);
        if (statusFilter) statusFilter.addEventListener('change', filterCards);
    </script>
</body>
</html>