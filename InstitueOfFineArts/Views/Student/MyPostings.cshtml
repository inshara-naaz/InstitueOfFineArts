@model IEnumerable<InstituteOfFineArts.Models.Submission>
@using InstituteOfFineArts.Models

@{
    ViewData["Title"] = "My Postings";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>My Postings | ARTISTIC Institute</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;400;500;600;700;800&family=Playfair+Display:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <style>
        /* ============ 100% SAME CSS AS DASHBOARD ============ */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body.dark-mode {
            background: #0A0A0A;
            color: #FFFFFF;
        }

        body.light-mode {
            background: #F0F2F5;
            color: #1A1A1A;
        }

        .app-wrapper {
            display: flex;
            min-height: 100vh;
            position: relative;
        }

        .sidebar {
            position: fixed;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            width: 70px;
            border-radius: 40px;
            transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
            z-index: 1000;
            overflow: hidden;
            backdrop-filter: blur(12px);
        }

            .sidebar:hover {
                width: 260px;
                border-radius: 28px;
            }

        body.dark-mode .sidebar {
            background: rgba(20, 20, 30, 0.9);
            border: 1px solid rgba(197, 160, 89, 0.15);
            box-shadow: 0 20px 40px rgba(0,0,0,0.3);
        }

        body.light-mode .sidebar {
            background: rgba(255, 255, 255, 0.95);
            border: 1px solid rgba(0,0,0,0.08);
            box-shadow: 0 20px 40px rgba(0,0,0,0.08);
        }

        @@media (max-width: 992px) {
            .sidebar {
                left: -70px;
                top: 50%;
                transform: translateY(-50%);
            }

                .sidebar.active {
                    left: 20px;
                }

            .menu-toggle {
                display: block !important;
            }

            .main-content {
                margin-left: 0 !important;
                width: 100%;
                padding: 16px !important;
            }
        }

        .sidebar-inner {
            padding: 24px 0;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        .sidebar-profile {
            width: 100%;
            text-align: center;
            padding: 0 0 20px 0;
            margin-bottom: 20px;
            border-bottom: 1px solid;
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .sidebar-profile:hover {
                opacity: 0.8;
            }

        body.dark-mode .sidebar-profile {
            border-color: rgba(255,255,255,0.08);
        }

        body.light-mode .sidebar-profile {
            border-color: rgba(0,0,0,0.06);
        }

        .profile-avatar {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg, #C5A059, #E8C87A);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            color: #000;
            transition: all 0.3s ease;
        }

        .sidebar:hover .profile-avatar {
            width: 50px;
            height: 50px;
            font-size: 1.4rem;
        }

        .profile-name {
            margin-top: 10px;
            font-size: 0;
            opacity: 0;
            transition: all 0.3s ease;
            white-space: nowrap;
        }

        .sidebar:hover .profile-name {
            font-size: 0.85rem;
            opacity: 1;
            margin-top: 12px;
        }

        .profile-role {
            font-size: 0;
            opacity: 0;
            transition: all 0.3s ease;
            white-space: nowrap;
        }

        .sidebar:hover .profile-role {
            font-size: 0.65rem;
            opacity: 0.6;
            margin-top: 4px;
        }

        .nav-menu {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 6px;
            padding: 0 12px;
        }

        .nav-item {
            width: 100%;
            border-radius: 30px;
            transition: all 0.25s ease;
        }

            .nav-item a {
                display: flex;
                align-items: center;
                gap: 16px;
                padding: 12px;
                text-decoration: none;
                border-radius: 30px;
                transition: all 0.25s ease;
                font-weight: 500;
                white-space: nowrap;
            }

                .nav-item a i {
                    width: 28px;
                    height: 28px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 1.1rem;
                    color: #C5A059;
                    flex-shrink: 0;
                }

        .nav-text {
            font-size: 0;
            opacity: 0;
            transition: all 0.3s ease;
            overflow: hidden;
        }

        .sidebar:hover .nav-text {
            font-size: 0.85rem;
            opacity: 1;
        }

        body.dark-mode .nav-item a {
            color: rgba(255,255,255,0.7);
        }

        body.light-mode .nav-item a {
            color: #4A5568;
        }

        .nav-item:hover a {
            transform: translateX(4px);
        }

        body.dark-mode .nav-item:hover a {
            background: rgba(197, 160, 89, 0.12);
            color: #C5A059;
        }

        body.light-mode .nav-item:hover a {
            background: rgba(197, 160, 89, 0.08);
            color: #C5A059;
        }

        body.dark-mode .nav-item.active a {
            background: rgba(197,160,89,0.18);
            color: #C5A059;
        }

        body.light-mode .nav-item.active a {
            background: rgba(197,160,89,0.12);
            color: #C5A059;
        }

        .nav-footer {
            width: 100%;
            margin-top: 30px;
            padding: 20px 12px 0;
            border-top: 1px solid;
        }

        body.dark-mode .nav-footer {
            border-color: rgba(255,255,255,0.08);
        }

        body.light-mode .nav-footer {
            border-color: rgba(0,0,0,0.06);
        }

        .logout-item {
            width: 100%;
            border-radius: 30px;
        }

            .logout-item a {
                display: flex;
                align-items: center;
                gap: 16px;
                padding: 12px;
                text-decoration: none;
                border-radius: 30px;
                transition: all 0.25s ease;
                white-space: nowrap;
            }

                .logout-item a i {
                    width: 28px;
                    font-size: 1.1rem;
                    flex-shrink: 0;
                    color: #E53E3E;
                }

        body.dark-mode .logout-item a {
            color: rgba(255,255,255,0.7);
        }

        body.light-mode .logout-item a {
            color: #E53E3E;
        }

        .logout-text {
            font-size: 0;
            opacity: 0;
            transition: all 0.3s ease;
        }

        .sidebar:hover .logout-text {
            font-size: 0.85rem;
            opacity: 1;
        }

        .logout-item:hover a {
            transform: translateX(4px);
        }

        .main-content {
            flex: 1;
            margin-left: 100px;
            padding: 24px 32px;
            overflow-x: hidden;
            transition: all 0.3s ease;
        }

        @@media (max-width: 992px) {
            .main-content {
                margin-left: 0;
            }
        }

        .top-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            padding: 12px 24px;
            border-radius: 24px;
            margin-bottom: 28px;
        }

        body.dark-mode .top-header {
            background: rgba(20, 20, 20, 0.7);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.05);
        }

        body.light-mode .top-header {
            background: #FFFFFF;
            border: 1px solid #E8ECEF;
            box-shadow: 0 2px 8px rgba(0,0,0,0.02);
        }

        .menu-toggle {
            display: none;
            background: transparent;
            border: none;
            font-size: 1.4rem;
            cursor: pointer;
            padding: 8px 12px;
            border-radius: 12px;
        }

        body.dark-mode .menu-toggle {
            color: white;
        }

        body.light-mode .menu-toggle {
            color: #333;
        }

        .page-title h2 {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            font-weight: 700;
        }

        .page-title p {
            font-size: 0.8rem;
            opacity: 0.7;
        }

        .theme-toggle {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        body.dark-mode .theme-toggle {
            background: rgba(255,255,255,0.08);
            color: #FFD700;
        }

        body.light-mode .theme-toggle {
            background: #F0F2F5;
            color: #C5A059;
        }

        .theme-toggle:hover {
            transform: rotate(15deg);
        }

        .user-dropdown {
            position: relative;
            cursor: pointer;
        }

        .user-avatar {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg, #C5A059, #E8C87A);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            color: #000;
        }

        .dropdown-menu-custom {
            position: absolute;
            top: 50px;
            right: 0;
            min-width: 160px;
            border-radius: 16px;
            padding: 8px;
            display: none;
            z-index: 100;
        }

        body.dark-mode .dropdown-menu-custom {
            background: #1A1A2E;
            border: 1px solid rgba(197,160,89,0.2);
        }

        body.light-mode .dropdown-menu-custom {
            background: white;
            border: 1px solid #E8ECEF;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        .user-dropdown:hover .dropdown-menu-custom {
            display: block;
        }

        .dropdown-item {
            padding: 10px 14px;
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            border-radius: 12px;
            transition: 0.2s;
        }

        body.dark-mode .dropdown-item {
            color: white;
        }

        body.light-mode .dropdown-item {
            color: #333;
        }

        .dropdown-item:hover {
            background: rgba(197, 160, 89, 0.15);
        }

        .stat-card, .chart-card, .recent-table {
            border-radius: 24px;
            padding: 1.5rem;
            transition: all 0.3s ease;
            height: 100%;
        }

        body.dark-mode .stat-card, body.dark-mode .chart-card, body.dark-mode .recent-table {
            background: rgba(20, 20, 20, 0.7);
            border: 1px solid rgba(255,255,255,0.05);
        }

        body.light-mode .stat-card, body.light-mode .chart-card, body.light-mode .recent-table {
            background: #FFFFFF;
            border: 1px solid #E8ECEF;
            box-shadow: 0 2px 8px rgba(0,0,0,0.02);
        }

        .stat-card:hover, .chart-card:hover {
            transform: translateY(-3px);
        }

        .stat-icon {
            font-size: 2rem;
            color: #C5A059;
            margin-bottom: 0.8rem;
        }

        .stat-value {
            font-size: 2rem;
            font-weight: 700;
        }

        .stat-label {
            font-size: 0.8rem;
            opacity: 0.7;
        }

        .trend-up {
            color: #28a745;
            font-size: 0.7rem;
            margin-top: 0.5rem;
        }

        .chart-title {
            font-weight: 600;
            margin-bottom: 1rem;
            color: #C5A059;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .footer {
            padding: 1rem;
            margin-top: 2rem;
            text-align: center;
            border-radius: 20px;
            font-size: 0.7rem;
        }

        body.dark-mode .footer {
            background: rgba(20, 20, 20, 0.5);
            color: rgba(255,255,255,0.4);
        }

        body.light-mode .footer {
            background: #FFFFFF;
            color: #8A8A8A;
            border: 1px solid #E8ECEF;
        }

        .scroll-top {
            position: fixed;
            bottom: 20px;
            right: 20px;
            width: 45px;
            height: 45px;
            background: linear-gradient(135deg, #C5A059, #E8C87A);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
            border: none;
            z-index: 999;
        }

            .scroll-top.show {
                opacity: 1;
                visibility: visible;
            }

            .scroll-top:hover {
                transform: scale(1.1) translateY(-3px);
                box-shadow: 0 8px 20px rgba(197,160,89,0.4);
            }

        .modal-custom {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.7);
            backdrop-filter: blur(8px);
            z-index: 2000;
            align-items: center;
            justify-content: center;
        }

            .modal-custom.active {
                display: flex;
            }

        .modal-content-custom {
            width: 90%;
            max-width: 500px;
            max-height: 85vh;
            overflow-y: auto;
            border-radius: 28px;
            padding: 2rem;
            position: relative;
        }

        body.dark-mode .modal-content-custom {
            background: #1A1A2E;
            border: 1px solid rgba(197,160,89,0.2);
        }

        body.light-mode .modal-content-custom {
            background: white;
            border: 1px solid #E8ECEF;
        }

        .modal-close {
            position: absolute;
            top: 15px;
            right: 20px;
            font-size: 1.5rem;
            cursor: pointer;
            background: none;
            border: none;
        }

        body.dark-mode .modal-close {
            color: white;
        }

        body.light-mode .modal-close {
            color: #333;
        }

        .modal-close:hover {
            color: #C5A059;
            transform: rotate(90deg);
        }

        .btn-gold {
            background: linear-gradient(135deg, #C5A059, #E8C87A);
            color: #000;
            border: none;
            padding: 0.6rem 1.5rem;
            border-radius: 50px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .btn-gold:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(197,160,89,0.3);
            }

        /* ========== UNIQUE / ENHANCED STYLES FOR MyPostings ========== */
        .posting-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.5rem;
        }

        .posting-card {
            perspective: 800px;
            border-radius: 20px;
            padding: 1.2rem;
            transition: all 0.3s ease;
            transform-style: preserve-3d;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            cursor: pointer;
        }

        body.dark-mode .posting-card {
            background: rgba(20, 20, 20, 0.7);
            border: 1px solid rgba(255,255,255,0.08);
        }

        body.light-mode .posting-card {
            background: #FFFFFF;
            border: 1px solid #E8ECEF;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }

        .posting-card:hover {
            transform: scale(1.02) rotateX(2deg) rotateY(2deg);
            box-shadow: 0 15px 30px rgba(0,0,0,0.2);
        }

        .posting-thumb {
            width: 100%;
            height: 160px;
            object-fit: cover;
            border-radius: 15px;
            margin-bottom: 1rem;
            border: 1px solid rgba(197,160,89,0.1);
        }

        .posting-title {
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            font-size: 1.1rem;
            margin-bottom: 0.3rem;
        }

        body.dark-mode .posting-title {
            color: #E8C87A;
        }

        body.light-mode .posting-title {
            color: #C5A059;
        }

        .posting-meta {
            font-size: 0.8rem;
            opacity: 0.7;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 0.5rem;
        }

        .posting-actions {
            margin-top: 0.8rem;
            display: flex;
            gap: 0.5rem;
        }

            .posting-actions .btn-sm-custom {
                flex: 1;
                border-radius: 40px;
                padding: 0.4rem 0.8rem;
                font-size: 0.75rem;
                font-weight: 600;
                border: none;
                transition: all 0.3s ease;
                background: rgba(197, 160, 89, 0.15);
                color: #C5A059;
            }

                .posting-actions .btn-sm-custom:hover {
                    background: #C5A059;
                    color: #000;
                    transform: scale(1.05);
                }

        .status-badge {
            display: inline-block;
            padding: 0.25rem 0.7rem;
            border-radius: 30px;
            font-size: 0.65rem;
            font-weight: 700;
            text-transform: uppercase;
        }

            .status-badge.pending {
                background: #ffc107;
                color: #000;
            }

            .status-badge.approved {
                background: #28a745;
                color: white;
            }

            .status-badge.rejected {
                background: #dc3545;
                color: white;
            }
    </style>
</head>
<body class="dark-mode">

    <div class="app-wrapper">
        <!-- SIDEBAR -->
        <div class="sidebar">
            <div class="sidebar-inner">
                <div class="sidebar-profile" onclick="goToHome()">
                    <div class="profile-avatar"><i class="fas fa-palette"></i></div>
                    <div class="profile-name">ARTISTIC</div>
                    <div class="profile-role">Student Panel</div>
                </div>

                <div class="nav-menu">
                    <div class="nav-item">
                        <a href="@Url.Action("Dashboard", "Student")">
                            <i class="fas fa-home"></i>
                            <span class="nav-text">Dashboard</span>
                        </a>
                    </div>
                    <div class="nav-item">
                        <a href="@Url.Action("UploadPosting", "Student")">
                            <i class="fas fa-upload"></i>
                            <span class="nav-text">Upload Posting</span>
                        </a>
                    </div>
                    <div class="nav-item active">
                        <a href="@Url.Action("MyPostings", "Student")">
                            <i class="fas fa-list-ul"></i>
                            <span class="nav-text">My Postings</span>
                        </a>
                    </div>
                    <div class="nav-item">
                        <a href="@Url.Action("EditPosting", "Student")">
                            <i class="fas fa-edit"></i>
                            <span class="nav-text">Edit Posting</span>
                        </a>
                    </div>
                    <div class="nav-item">
                        <a href="@Url.Action("MyAwards", "Student")">
                            <i class="fas fa-trophy"></i>
                            <span class="nav-text">My Awards</span>
                        </a>
                    </div>
                    <div class="nav-item">
                        <a href="@Url.Action("BestPostings", "Student")">
                            <i class="fas fa-star"></i>
                            <span class="nav-text">Best Postings</span>
                        </a>
                    </div>
                    <div class="nav-item">
                        <a href="@Url.Action("ExhibitionStatus", "Student")">
                            <i class="fas fa-building"></i>
                            <span class="nav-text">Exhibition Status</span>
                        </a>
                    </div>
                </div>

                <div class="nav-footer">
                    <div class="logout-item">
                        <a href="#" onclick="logout()">
                            <i class="fas fa-sign-out-alt"></i>
                            <span class="logout-text">Logout</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="main-content">
            <!-- TOP HEADER -->
            <div class="top-header">
                <button class="menu-toggle" id="menuToggle"><i class="fas fa-bars"></i></button>
                <div class="page-title">
                    <h2>My Postings</h2>
                    <p>Here you can view all your submitted artworks and their status.</p>
                </div>
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <div class="theme-toggle" id="themeToggle"><i class="fas fa-sun" id="themeIcon"></i></div>
                    <div class="user-dropdown">
                        <div class="user-avatar"><i class="fas fa-user-graduate"></i></div>
                        <div class="dropdown-menu-custom">
                            <a href="#" class="dropdown-item" onclick="logout()"><i class="fas fa-sign-out-alt"></i> Logout</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ENHANCED CONTENT - 3D GRID WITH MY POSTINGS -->
            <div class="container-fluid mt-4">
                <div class="posting-grid" id="postingGrid">
                    @if (Model != null && Model.Any())
                    {
                        var delay = 100;
                        foreach (var posting in Model)
                        {
                            var badgeClass = posting.Grade == SubmissionGrade.Pending ? "pending" :
                            posting.Grade == SubmissionGrade.Disqualified ? "rejected" : "approved";

                            <div class="posting-card" data-aos="fade-up" data-aos-delay="@delay">
                                <img src="@posting.ImageFilePath"
                                     class="posting-thumb"
                                     alt="@posting.PaintingTitle"
                                     onerror="this.src='https://placehold.co/400x250/2a2a3e/C5A059?text=Artwork'">

                                <div class="posting-title">@posting.PaintingTitle</div>
                                <div style="font-size: 0.85rem; opacity: 0.8;">
                                    @(posting.Competition != null ? posting.Competition.Title : "No Competition")
                                </div>

                                <div class="posting-meta">
                                    <span><i class="far fa-calendar-alt me-1"></i> @posting.SubmittedAt.ToString("MMM dd, yyyy")</span>
                                    <span class="status-badge @badgeClass">@posting.Grade</span>
                                </div>

                                <div class="posting-actions">
                                    <button class="btn-sm-custom" type="button"
                                            onclick="viewSubmission('@posting.PaintingTitle.Replace("'", "\'")', '@posting.ImageFilePath', '@posting.Grade', '@posting.SubmittedAt.ToString("MMM dd, yyyy")', '@(posting.Competition != null ? posting.Competition.Title.Replace("'", "\'") : "No Competition")')">
                                        <i class="far fa-eye"></i> View
                                    </button>
                                    <button class="btn-sm-custom" type="button" onclick="window.location.href='@Url.Action("EditPosting", "Student", new { id = posting.SubmissionId })'">
                                        <i class="fas fa-edit"></i> Edit
                                    </button>
                                </div>
                            </div>

                            delay += 100;
                        }
                    }
                    else
                    {
                        <div class="chart-card" style="grid-column:1/-1; text-align:center; padding:3rem;">
                            <i class="fas fa-palette" style="font-size:3rem; color:#C5A059;"></i>
                            <h3 class="mt-3">No postings yet</h3>
                            <p style="opacity:0.7;">You have not uploaded any artwork yet.</p>
                            <a href="@Url.Action("UploadPosting", "Student")" class="btn-gold" style="text-decoration:none; display:inline-block; margin-top:1rem;">
                                Upload Your First Posting
                            </a>
                        </div>
                    }
                </div>

                <!-- Pagination / Load More -->
                <div class="text-center mt-4">
                    <a href="@Url.Action("UploadPosting", "Student")" class="btn-gold" style="text-decoration:none;">Upload New Posting</a>
                </div>
            </div>

            <div class="footer">
                <p>© 2025 ARTISTIC - Institute of Fine Arts. All rights reserved.</p>
            </div>
        </div>
    </div>

    <!-- MODAL FOR VIEWING ARTWORK -->
    <div class="modal-custom" id="viewArtworkModal">
        <div class="modal-content-custom">
            <button class="modal-close" onclick="closeModal('viewArtworkModal')">&times;</button>
            <h3 id="modalArtworkTitle" style="font-family:'Playfair Display',serif; color:#C5A059;">Artwork Title</h3>
            <div class="text-center mt-3">
                <img id="modalArtworkImage" style="max-width: 100%; border-radius: 15px;">
            </div>
            <p id="modalArtworkDetails" class="mt-3">Details of the artwork will appear here.</p>
            <button class="btn-gold w-100" onclick="closeModal('viewArtworkModal')">Close</button>
        </div>
    </div>

    <button class="scroll-top" id="scrollTop"><i class="fas fa-arrow-up"></i></button>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        AOS.init({ duration: 800, once: true });

        // Dark/Light Mode
        const themeToggle = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');
        const body = document.body;

        if (localStorage.getItem('studentTheme') === 'light') {
        body.classList.remove('dark-mode');
        body.classList.add('light-mode');
        themeIcon.classList.remove('fa-sun');
        themeIcon.classList.add('fa-moon');
        } else {
        body.classList.add('dark-mode');
        body.classList.remove('light-mode');
        themeIcon.classList.remove('fa-moon');
        themeIcon.classList.add('fa-sun');
        }

        themeToggle.addEventListener('click', () => {
        if (body.classList.contains('dark-mode')) {
        body.classList.remove('dark-mode');
        body.classList.add('light-mode');
        localStorage.setItem('studentTheme', 'light');
        themeIcon.classList.remove('fa-sun');
        themeIcon.classList.add('fa-moon');
        } else {
        body.classList.remove('light-mode');
        body.classList.add('dark-mode');
        localStorage.setItem('studentTheme', 'dark');
        themeIcon.classList.remove('fa-moon');
        themeIcon.classList.add('fa-sun');
        }
        });

        // Menu Toggle for Mobile
        const menuToggle = document.getElementById('menuToggle');
        const sidebar = document.querySelector('.sidebar');
        if (menuToggle) {
        menuToggle.addEventListener('click', () => sidebar.classList.toggle('active'));
        }

        // Scroll Top
        const scrollBtn = document.getElementById('scrollTop');
        window.addEventListener('scroll', () => {
        if (window.scrollY > 300) scrollBtn.classList.add('show');
        else scrollBtn.classList.remove('show');
        });
        if (scrollBtn) {
        scrollBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
        }

        // Functions
        function goToHome() { window.location.href = '@Url.Action("Index", "Home")'; }
        function openModal(id) { document.getElementById(id).classList.add('active'); document.body.style.overflow = 'hidden'; }
        function closeModal(id) { document.getElementById(id).classList.remove('active'); document.body.style.overflow = 'auto'; }

        function showSuccess(msg) {
        Swal.fire({
        title: 'Success!',
        text: msg,
        icon: 'success',
        confirmButtonColor: '#C5A059',
        background: body.classList.contains('dark-mode') ? '#1A1A2E' : '#FFFFFF',
        color: body.classList.contains('dark-mode') ? 'white' : '#333',
        timer: 2000,
        showConfirmButton: false
        });
        }

        function viewSubmission(title, imagePath, grade, submittedDate, competitionTitle) {
        document.getElementById('modalArtworkTitle').innerText = title;
        document.getElementById('modalArtworkImage').src = imagePath;
        document.getElementById('modalArtworkDetails').innerHTML =
        `<strong>Title:</strong> ${title}<br>` +
        `<strong>Competition:</strong> ${competitionTitle}<br>` +
        `<strong>Status:</strong> ${grade}<br>` +
        `<strong>Submitted:</strong> ${submittedDate}`;
        openModal('viewArtworkModal');
        }

        function logout() {
        Swal.fire({
        title: 'Logout?',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#C5A059',
        confirmButtonText: 'Yes',
        background: body.classList.contains('dark-mode') ? '#1A1A2E' : '#FFFFFF',
        color: body.classList.contains('dark-mode') ? 'white' : '#333'
        }).then((r) => { if (r.isConfirmed) window.location.href = '@Url.Action("Index", "Home")'; });
        }

        // ============== 3D TILT EFFECT ON EACH POSTING CARD ==============
        const cards = document.querySelectorAll('.posting-card');
        cards.forEach(card => {
        card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        const rotateX = ((y - centerY) / centerY) * -6;
        const rotateY = ((x - centerX) / centerX) * 6;
        card.style.transform = `perspective(800px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.03)`;
        });
        card.addEventListener('mouseleave', () => {
        card.style.transform = `perspective(800px) rotateX(0deg) rotateY(0deg) scale(1)`;
        });
        });
    </script>
</body>
</html>