@model IEnumerable<InstituteOfFineArts.Models.Submission>
@using InstituteOfFineArts.Models
@{
    ViewData["Title"] = "Edit Posting";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Posting | ARTISTIC Institute</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
        }

        body.dark-mode {
            background: #0A0A0A;
            color: #fff;
            font-family: Inter, Arial, sans-serif;
        }

        body.light-mode {
            background: #F0F2F5;
            color: #1A1A1A;
            font-family: Inter, Arial, sans-serif;
        }

        .app-wrapper {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            position: fixed;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            width: 70px;
            border-radius: 40px;
            z-index: 1000;
            overflow: hidden;
            backdrop-filter: blur(12px);
            transition: all .3s;
            background: rgba(20,20,30,.9);
            border: 1px solid rgba(197,160,89,.15);
        }

            .sidebar:hover {
                width: 260px;
                border-radius: 28px;
            }

        .sidebar-inner {
            padding: 24px 0;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        .sidebar-profile {
            width: 100%;
            text-align: center;
            padding-bottom: 20px;
            margin-bottom: 20px;
            border-bottom: 1px solid rgba(255,255,255,.08);
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
        }

        .profile-avatar {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg,#C5A059,#E8C87A);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #000;
        }

        .profile-name, .profile-role, .nav-text, .logout-text {
            font-size: 0;
            opacity: 0;
            transition: .3s;
            white-space: nowrap;
        }

        .sidebar:hover .profile-name {
            font-size: .85rem;
            opacity: 1;
            margin-top: 12px;
        }

        .sidebar:hover .profile-role {
            font-size: .65rem;
            opacity: .6;
            margin-top: 4px;
        }

        .sidebar:hover .nav-text, .sidebar:hover .logout-text {
            font-size: .85rem;
            opacity: 1;
        }

        .nav-menu {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 6px;
            padding: 0 12px;
        }

        .nav-item, .logout-item {
            width: 100%;
            border-radius: 30px;
        }

            .nav-item a, .logout-item a {
                display: flex;
                align-items: center;
                gap: 16px;
                padding: 12px;
                text-decoration: none;
                border-radius: 30px;
                transition: .25s;
                color: rgba(255,255,255,.7);
            }

                .nav-item a i, .logout-item a i {
                    width: 28px;
                    font-size: 1.1rem;
                    color: #C5A059;
                    flex-shrink: 0;
                    text-align: center;
                }

                .logout-item a i {
                    color: #E53E3E;
                }

            .nav-item:hover a, .nav-item.active a {
                background: rgba(197,160,89,.15);
                color: #C5A059;
                transform: translateX(4px);
            }

            .logout-item:hover a {
                background: rgba(229,62,62,.15);
                color: #E53E3E;
                transform: translateX(4px);
            }

        .nav-footer {
            width: 100%;
            margin-top: 30px;
            padding: 20px 12px 0;
            border-top: 1px solid rgba(255,255,255,.08);
        }

        .main-content {
            flex: 1;
            margin-left: 100px;
            padding: 24px 32px;
            overflow-x: hidden;
        }

        .top-header, .card-box {
            background: rgba(20,20,20,.7);
            border: 1px solid rgba(255,255,255,.05);
            border-radius: 24px;
            padding: 1.5rem;
            margin-bottom: 28px;
        }

        .top-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            padding: 12px 24px;
        }

        .page-title h2 {
            font-family: 'Playfair Display',serif;
            font-size: 1.5rem;
            font-weight: 700;
            margin: 0;
        }

        .page-title p {
            font-size: .8rem;
            opacity: .7;
            margin: 0;
        }

        .theme-toggle, .user-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,.08);
            color: #FFD700;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill,minmax(290px,1fr));
            gap: 1.5rem;
        }

        .art-card {
            background: rgba(20,20,20,.7);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 22px;
            padding: 1.2rem;
            transition: .3s;
        }

            .art-card:hover {
                transform: translateY(-5px);
                border-color: #C5A059;
            }

        .art-img {
            width: 100%;
            height: 190px;
            object-fit: cover;
            border-radius: 16px;
            border: 1px solid rgba(197,160,89,.2);
            background: #222;
        }

        .title {
            font-family: 'Playfair Display',serif;
            color: #E8C87A;
            font-size: 1.2rem;
            font-weight: 700;
            margin-top: 1rem;
        }

        .muted {
            opacity: .72;
            font-size: .85rem;
        }

        .badge-custom {
            display: inline-block;
            padding: .25rem .7rem;
            border-radius: 30px;
            font-size: .7rem;
            font-weight: 700;
        }

        .pending {
            background: #ffc107;
            color: #000;
        }

        .best {
            background: linear-gradient(135deg,#FFD700,#C5A059);
            color: #000;
        }

        .normal {
            background: #6c757d;
            color: #fff;
        }

        .danger {
            background: #dc3545;
            color: #fff;
        }

        .success {
            background: #28a745;
            color: #fff;
        }

        .btn-gold {
            background: linear-gradient(135deg,#C5A059,#E8C87A);
            color: #000;
            border: none;
            padding: .6rem 1.2rem;
            border-radius: 50px;
            font-weight: 700;
            text-decoration: none;
            display: inline-block;
            cursor: pointer;
        }

        .btn-dark2 {
            background: #4a5568;
            color: #fff;
            border: none;
            padding: .6rem 1.2rem;
            border-radius: 50px;
            font-weight: 700;
            text-decoration: none;
            display: inline-block;
            cursor: pointer;
        }

        .form-control, .form-select {
            background: rgba(255,255,255,.08);
            border: 1px solid rgba(197,160,89,.3);
            color: #fff;
            border-radius: 14px;
            padding: .7rem 1rem;
            width: 100%;
        }

            .form-select option {
                background: #1A1A2E;
                color: #fff;
            }

        textarea.form-control {
            min-height: 100px;
        }

        label {
            color: #C5A059;
            font-weight: 600;
            font-size: .85rem;
            margin-top: .7rem;
            margin-bottom: .35rem;
            display: block;
        }

        .footer {
            padding: 1rem;
            margin-top: 2rem;
            text-align: center;
            border-radius: 20px;
            font-size: .7rem;
            background: rgba(20,20,20,.5);
            color: rgba(255,255,255,.4);
        }

        .empty {
            text-align: center;
            padding: 3rem;
            border: 1px dashed rgba(197,160,89,.35);
            border-radius: 24px;
            color: rgba(255,255,255,.75);
        }

        .table-dark-custom {
            width: 100%;
            border-collapse: collapse;
        }

            .table-dark-custom th, .table-dark-custom td {
                padding: .85rem;
                border-bottom: 1px solid rgba(255,255,255,.08);
                vertical-align: middle;
            }

            .table-dark-custom th {
                color: #C5A059;
            }
        @@media(max - width:992px) {
            .main-content

        {
            margin-left: 0;
            padding: 16px;
        }

        .sidebar {
            left: -70px;
        }

            .sidebar.active {
                left: 20px;
            }

        }
    </style>

</head>
<body class="dark-mode">
    <div class="app-wrapper">

        <div class="sidebar">
            <div class="sidebar-inner">
                <div class="sidebar-profile" onclick="goToHome()">
                    <div class="profile-avatar"><i class="fas fa-palette"></i></div>
                    <div class="profile-name">ARTISTIC</div>
                    <div class="profile-role">Student Panel</div>
                </div>
                <div class="nav-menu">
                    <div class="nav-item "><a href="@Url.Action("Dashboard", "Student")"><i class="fas fa-home"></i><span class="nav-text">Dashboard</span></a></div>
                    <div class="nav-item"><a href="@Url.Action("UploadPosting", "Student")"><i class="fas fa-upload"></i><span class="nav-text">Upload Posting</span></a></div>
                    <div class="nav-item"><a href="@Url.Action("MyPostings", "Student")"><i class="fas fa-list-ul"></i><span class="nav-text">My Postings</span></a></div>
                    <div class="nav-item active"><a href="@Url.Action("EditPosting", "Student")"><i class="fas fa-edit"></i><span class="nav-text">Edit Posting</span></a></div>
                    <div class="nav-item "><a href="@Url.Action("MyAwards", "Student")"><i class="fas fa-trophy"></i><span class="nav-text">My Awards</span></a></div>
                    <div class="nav-item "><a href="@Url.Action("BestPostings", "Student")"><i class="fas fa-star"></i><span class="nav-text">Best Postings</span></a></div>
                    <div class="nav-item "><a href="@Url.Action("ExhibitionStatus", "Student")"><i class="fas fa-building"></i><span class="nav-text">Exhibition Status</span></a></div>
                </div>
                <div class="nav-footer">
                    <div class="logout-item"><a href="#" onclick="logout()"><i class="fas fa-sign-out-alt"></i><span class="logout-text">Logout</span></a></div>
                </div>
            </div>
        </div>

        <div class="main-content">
            <div class="top-header">
                <div class="page-title">
                    <h2><i class="fas fa-edit me-2" style="color:#C5A059;"></i>Edit Posting</h2>
                    <p>Student panel dynamic page</p>
                </div>
                <div style="display:flex;align-items:center;gap:1rem;">
                    <div class="theme-toggle"><i class="fas fa-sun"></i></div>
                    <div class="user-avatar"><i class="fas fa-user-graduate"></i></div>
                </div>
            </div>

            <div class="container-fluid">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }

                @if (Model != null && Model.Any())
                {
                    <div class="grid">
                        @foreach (var item in Model)
                        {
                            var canEdit = item.Competition != null && item.Competition.EndDate >= DateTime.Now && item.Grade == SubmissionGrade.Pending;
                            <div class="art-card" data-aos="fade-up">
                                <img src="@item.ImageFilePath" class="art-img" alt="@item.PaintingTitle" onerror="this.src='https://placehold.co/500x300/2a2a3e/C5A059?text=Artwork'">
                                <div class="title">@item.PaintingTitle</div>
                                <div class="muted">@item.Competition?.Title</div>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <span class="badge-custom @(item.Grade == SubmissionGrade.Pending ? "pending" : item.Grade == SubmissionGrade.Disqualified ? "danger" : item.Grade == SubmissionGrade.Best ? "best" : "normal")">@item.Grade</span>
                                    <span class="muted">@item.SubmittedAt.ToString("dd MMM yyyy")</span>
                                </div>

                                @if (canEdit)
                                {
                                    <form action="/Student/UpdatePosting" method="post" enctype="multipart/form-data" class="mt-3">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="SubmissionId" value="@item.SubmissionId" />

                                        <label>Painting Title</label>
                                        <input type="text" name="PaintingTitle" value="@item.PaintingTitle" class="form-control" required />

                                        <label>Text Type</label>
                                        <select name="TextType" class="form-select" required>
                                            <option value="Description" selected="@(item.TextType == "Description")">Description</option>
                                            <option value="Poem" selected="@(item.TextType == "Poem")">Poem</option>
                                            <option value="Quotation" selected="@(item.TextType == "Quotation")">Quotation</option>
                                            <option value="Story" selected="@(item.TextType == "Story")">Story</option>
                                        </select>

                                        <label>Poem / Quotation / Story / Description</label>
                                        <textarea name="AccompanyingText" class="form-control" required>@item.AccompanyingText</textarea>

                                        <label>Creative Description</label>
                                        <textarea name="CreativeDescription" class="form-control">@item.CreativeDescription</textarea>

                                        <label>Change Image (optional JPG/JPEG)</label>
                                        <input type="file" name="ImageFile" class="form-control" accept=".jpg,.jpeg,image/jpeg" />

                                        <button type="submit" class="btn-gold mt-3 w-100"><i class="fas fa-save me-1"></i> Update Posting</button>
                                    </form>
                                }
                                else
                                {
                                    <div class="alert alert-warning mt-3 mb-0">
                                        Editing locked. Either deadline passed or posting is already evaluated.
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty">
                        <i class="fas fa-edit fa-3x mb-3" style="color:#C5A059;"></i>
                        <h4>No posting found for editing</h4>
                        <p>Upload artwork first, then it will appear here.</p>
                        <a href="@Url.Action("UploadPosting", "Student")" class="btn-gold">Upload Posting</a>
                    </div>
                }
            </div>

            <div class="footer"><p>© 2025 ARTISTIC - Institute of Fine Arts. All rights reserved.</p></div>
        </div>
    </div>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        AOS.init({ duration: 700, once: true });
        const body = document.body;
        function goToHome(){ window.location.href='@Url.Action("Index", "Home")'; }
        function logout(){
            Swal.fire({
                title:'Logout?', icon:'question', showCancelButton:true,
                confirmButtonColor:'#C5A059', confirmButtonText:'Yes'
            }).then((r)=>{ if(r.isConfirmed) window.location.href='@Url.Action("Index", "Home")'; });
        }
        function previewImage(inputId, imgId){
            const fileInput = document.getElementById(inputId);
            const img = document.getElementById(imgId);
            if(fileInput && img && fileInput.files && fileInput.files[0]){
                const reader = new FileReader();
                reader.onload = function(e){ img.src = e.target.result; img.style.display='block'; };
                reader.readAsDataURL(fileInput.files[0]);
            }
        }
    </script>

</body>
</html>
