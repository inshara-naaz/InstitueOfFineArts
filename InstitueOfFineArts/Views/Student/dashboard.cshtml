@using InstituteOfFineArts.Models
@{
    ViewData["Title"] = "Student Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Student Dashboard | ARTISTIC Institute</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;400;500;600;700;800&family=Playfair+Display:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body.dark-mode {
            background: #0A0A0A;
            color: #FFFFFF;
        }

        body.light-mode {
            background: #F0F2F5;
            color: #1A1A1A;
        }

        .app-wrapper {
            display: flex;
            min-height: 100vh;
            position: relative;
        }

        /* SIDEBAR */
        .sidebar {
            position: fixed;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            width: 70px;
            border-radius: 40px;
            transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
            z-index: 1000;
            overflow: hidden;
            backdrop-filter: blur(12px);
        }

            .sidebar:hover {
                width: 260px;
                border-radius: 28px;
            }

        body.dark-mode .sidebar {
            background: rgba(20, 20, 30, 0.9);
            border: 1px solid rgba(197, 160, 89, 0.15);
            box-shadow: 0 20px 40px rgba(0,0,0,0.3);
        }

        body.light-mode .sidebar {
            background: rgba(255, 255, 255, 0.95);
            border: 1px solid rgba(0,0,0,0.08);
            box-shadow: 0 20px 40px rgba(0,0,0,0.08);
        }

        @@media (max-width: 992px) {
            .sidebar {
                left: -70px;
                top: 50%;
                transform: translateY(-50%);
            }

                .sidebar.active {
                    left: 20px;
                }

            .menu-toggle {
                display: block !important;
            }

            .main-content {
                margin-left: 0 !important;
                width: 100%;
                padding: 16px !important;
            }
        }

        .sidebar-inner {
            padding: 24px 0;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        .sidebar-profile {
            width: 100%;
            text-align: center;
            padding: 0 0 20px 0;
            margin-bottom: 20px;
            border-bottom: 1px solid;
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .sidebar-profile:hover {
                opacity: 0.8;
            }

        body.dark-mode .sidebar-profile {
            border-color: rgba(255,255,255,0.08);
        }

        body.light-mode .sidebar-profile {
            border-color: rgba(0,0,0,0.06);
        }

        .profile-avatar {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg, #C5A059, #E8C87A);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            color: #000;
            transition: all 0.3s ease;
        }

        .sidebar:hover .profile-avatar {
            width: 50px;
            height: 50px;
            font-size: 1.4rem;
        }

        .profile-name {
            margin-top: 10px;
            font-size: 0;
            opacity: 0;
            transition: all 0.3s ease;
            white-space: nowrap;
        }

        .sidebar:hover .profile-name {
            font-size: 0.85rem;
            opacity: 1;
            margin-top: 12px;
        }

        .profile-role {
            font-size: 0;
            opacity: 0;
            transition: all 0.3s ease;
            white-space: nowrap;
        }

        .sidebar:hover .profile-role {
            font-size: 0.65rem;
            opacity: 0.6;
            margin-top: 4px;
        }

        .nav-menu {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 6px;
            padding: 0 12px;
        }

        .nav-item {
            width: 100%;
            border-radius: 30px;
            transition: all 0.25s ease;
        }

            .nav-item a {
                display: flex;
                align-items: center;
                gap: 16px;
                padding: 12px;
                text-decoration: none;
                border-radius: 30px;
                transition: all 0.25s ease;
                font-weight: 500;
                white-space: nowrap;
            }

                .nav-item a i {
                    width: 28px;
                    height: 28px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 1.1rem;
                    color: #C5A059;
                    flex-shrink: 0;
                }

        .nav-text {
            font-size: 0;
            opacity: 0;
            transition: all 0.3s ease;
            overflow: hidden;
        }

        .sidebar:hover .nav-text {
            font-size: 0.85rem;
            opacity: 1;
        }

        body.dark-mode .nav-item a {
            color: rgba(255,255,255,0.7);
        }

        body.light-mode .nav-item a {
            color: #4A5568;
        }

        .nav-item:hover a {
            transform: translateX(4px);
        }

        body.dark-mode .nav-item:hover a {
            background: rgba(197, 160, 89, 0.12);
            color: #C5A059;
        }

        body.light-mode .nav-item:hover a {
            background: rgba(197, 160, 89, 0.08);
            color: #C5A059;
        }

        body.dark-mode .nav-item.active a {
            background: rgba(197,160,89,0.18);
            color: #C5A059;
        }

        body.light-mode .nav-item.active a {
            background: rgba(197,160,89,0.12);
            color: #C5A059;
        }

        .nav-footer {
            width: 100%;
            margin-top: 30px;
            padding: 20px 12px 0;
            border-top: 1px solid;
        }

        body.dark-mode .nav-footer {
            border-color: rgba(255,255,255,0.08);
        }

        body.light-mode .nav-footer {
            border-color: rgba(0,0,0,0.06);
        }

        .logout-item {
            width: 100%;
            border-radius: 30px;
        }

            .logout-item a {
                display: flex;
                align-items: center;
                gap: 16px;
                padding: 12px;
                text-decoration: none;
                border-radius: 30px;
                transition: all 0.25s ease;
                white-space: nowrap;
            }

                .logout-item a i {
                    width: 28px;
                    font-size: 1.1rem;
                    flex-shrink: 0;
                    color: #E53E3E;
                }

        body.dark-mode .logout-item a {
            color: rgba(255,255,255,0.7);
        }

        body.light-mode .logout-item a {
            color: #E53E3E;
        }

        .logout-text {
            font-size: 0;
            opacity: 0;
            transition: all 0.3s ease;
        }

        .sidebar:hover .logout-text {
            font-size: 0.85rem;
            opacity: 1;
        }

        .logout-item:hover a {
            transform: translateX(4px);
        }

        /* MAIN CONTENT */
        .main-content {
            flex: 1;
            margin-left: 100px;
            padding: 24px 32px;
            overflow-x: hidden;
            transition: all 0.3s ease;
        }

        @@media (max-width: 992px) {
            .main-content {
                margin-left: 0;
            }
        }

        .top-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            padding: 12px 24px;
            border-radius: 24px;
            margin-bottom: 28px;
        }

        body.dark-mode .top-header {
            background: rgba(20, 20, 20, 0.7);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.05);
        }

        body.light-mode .top-header {
            background: #FFFFFF;
            border: 1px solid #E8ECEF;
            box-shadow: 0 2px 8px rgba(0,0,0,0.02);
        }

        .menu-toggle {
            display: none;
            background: transparent;
            border: none;
            font-size: 1.4rem;
            cursor: pointer;
            padding: 8px 12px;
            border-radius: 12px;
        }

        body.dark-mode .menu-toggle {
            color: white;
        }

        body.light-mode .menu-toggle {
            color: #333;
        }

        .page-title h2 {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            font-weight: 700;
        }

        .page-title p {
            font-size: 0.8rem;
            opacity: 0.7;
        }

        .theme-toggle {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        body.dark-mode .theme-toggle {
            background: rgba(255,255,255,0.08);
            color: #FFD700;
        }

        body.light-mode .theme-toggle {
            background: #F0F2F5;
            color: #C5A059;
        }

        .theme-toggle:hover {
            transform: rotate(15deg);
        }

        .user-dropdown {
            position: relative;
            cursor: pointer;
        }

        .user-avatar {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg, #C5A059, #E8C87A);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            color: #000;
        }

        .dropdown-menu-custom {
            position: absolute;
            top: 50px;
            right: 0;
            min-width: 160px;
            border-radius: 16px;
            padding: 8px;
            display: none;
            z-index: 100;
        }

        body.dark-mode .dropdown-menu-custom {
            background: #1A1A2E;
            border: 1px solid rgba(197,160,89,0.2);
        }

        body.light-mode .dropdown-menu-custom {
            background: white;
            border: 1px solid #E8ECEF;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        .user-dropdown:hover .dropdown-menu-custom {
            display: block;
        }

        .dropdown-item {
            padding: 10px 14px;
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            border-radius: 12px;
            transition: 0.2s;
        }

        body.dark-mode .dropdown-item {
            color: white;
        }

        body.light-mode .dropdown-item {
            color: #333;
        }

        .dropdown-item:hover {
            background: rgba(197, 160, 89, 0.15);
        }

        /* STAT CARDS */
        .stat-card, .chart-card, .recent-table {
            border-radius: 24px;
            padding: 1.5rem;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            height: 100%;
            transform-style: preserve-3d;
            perspective: 1000px;
        }

        body.dark-mode .stat-card, body.dark-mode .chart-card, body.dark-mode .recent-table {
            background: rgba(20, 20, 20, 0.7);
            border: 1px solid rgba(255,255,255,0.05);
            box-shadow: 0 8px 32px rgba(0,0,0,0.3), inset 0 1px 0 rgba(255,255,255,0.05);
        }

        body.light-mode .stat-card, body.light-mode .chart-card, body.light-mode .recent-table {
            background: #FFFFFF;
            border: 1px solid #E8ECEF;
            box-shadow: 0 4px 20px rgba(0,0,0,0.06), inset 0 1px 0 rgba(255,255,255,0.8);
        }

        .stat-card:hover {
            transform: translateY(-8px) rotateX(4deg) rotateY(-2deg) scale(1.02);
            box-shadow: 0 20px 50px rgba(197,160,89,0.15), 0 8px 20px rgba(0,0,0,0.2);
        }

        .chart-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 40px rgba(197,160,89,0.12), 0 4px 16px rgba(0,0,0,0.15);
        }

        .stat-icon {
            font-size: 2rem;
            color: #C5A059;
            margin-bottom: 0.8rem;
            display: inline-block;
            transition: transform 0.3s ease;
            filter: drop-shadow(0 0 8px rgba(197,160,89,0.4));
        }

        .stat-card:hover .stat-icon {
            transform: scale(1.15) rotate(-5deg);
        }

        .stat-value {
            font-size: 2rem;
            font-weight: 700;
        }

        .stat-label {
            font-size: 0.8rem;
            opacity: 0.7;
        }

        .trend-up {
            color: #28a745;
            font-size: 0.7rem;
            margin-top: 0.5rem;
        }

        .chart-title {
            font-weight: 600;
            margin-bottom: 1rem;
            color: #C5A059;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .chart-container {
            position: relative;
            height: 250px;
        }

        .category-list, .country-list {
            display: flex;
            flex-direction: column;
            gap: 0.8rem;
        }

        .category-item, .country-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .category-name, .country-name {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .progress-bar-custom {
            background: rgba(0,0,0,0.08);
            border-radius: 10px;
            height: 6px;
            overflow: hidden;
        }

        body.dark-mode .progress-bar-custom {
            background: rgba(255,255,255,0.1);
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #C5A059, #E8C87A);
            border-radius: 10px;
            transition: width 1s ease;
        }

        .activity-timeline {
            display: flex;
            flex-direction: column;
            gap: 0.8rem;
        }

        .activity-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px;
            border-radius: 14px;
            transition: all 0.3s ease;
        }

            .activity-item:hover {
                background: rgba(197, 160, 89, 0.06);
                transform: translateX(6px);
            }

        .activity-icon {
            width: 36px;
            height: 36px;
            background: rgba(197, 160, 89, 0.12);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #C5A059;
            transition: all 0.3s ease;
        }

        .activity-item:hover .activity-icon {
            background: rgba(197,160,89,0.25);
            transform: scale(1.1);
        }

        .activity-detail {
            flex: 1;
        }

        .activity-title {
            font-size: 0.85rem;
            font-weight: 500;
        }

        .activity-time {
            font-size: 0.7rem;
            opacity: 0.6;
        }

        .quick-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 0.8rem;
        }

        .quick-btn {
            border-radius: 40px;
            padding: 0.5rem 1.2rem;
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            font-size: 0.8rem;
            font-weight: 500;
        }

        body.dark-mode .quick-btn {
            background: rgba(197, 160, 89, 0.1);
            border: 1px solid rgba(197, 160, 89, 0.2);
            color: white;
        }

        body.light-mode .quick-btn {
            background: #F0F2F5;
            border: 1px solid #E8ECEF;
            color: #333;
        }

        .quick-btn:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 6px 20px rgba(197,160,89,0.25);
            background: rgba(197,160,89,0.2);
            color: #C5A059;
            border-color: #C5A059;
        }

        .table-custom {
            width: 100%;
            border-collapse: collapse;
        }

            .table-custom th, .table-custom td {
                padding: 0.8rem 0.5rem;
                text-align: left;
                border-bottom: 1px solid;
            }

        body.dark-mode .table-custom th, body.dark-mode .table-custom td {
            border-color: rgba(255,255,255,0.06);
        }

        body.light-mode .table-custom th, body.light-mode .table-custom td {
            border-color: #E8ECEF;
        }

        .table-custom th {
            color: #C5A059;
            font-weight: 600;
        }

        .table-custom tbody tr {
            transition: all 0.2s ease;
        }

            .table-custom tbody tr:hover {
                background: rgba(197,160,89,0.05);
                transform: scale(1.005);
            }

        .badge-status {
            padding: 0.2rem 0.7rem;
            border-radius: 30px;
            font-size: 0.7rem;
            font-weight: 600;
            display: inline-block;
        }

        .badge-pending {
            background: #ffc107;
            color: #000;
        }

        .badge-approved {
            background: #28a745;
            color: white;
        }

        .btn-sm {
            background: linear-gradient(135deg, #C5A059, #E8C87A);
            border: none;
            padding: 0.25rem 0.8rem;
            border-radius: 20px;
            color: #000;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .btn-sm:hover {
                transform: scale(1.08);
                box-shadow: 0 4px 12px rgba(197,160,89,0.4);
            }

        .footer {
            padding: 1rem;
            margin-top: 2rem;
            text-align: center;
            border-radius: 20px;
            font-size: 0.7rem;
        }

        body.dark-mode .footer {
            background: rgba(20, 20, 20, 0.5);
            color: rgba(255,255,255,0.4);
        }

        body.light-mode .footer {
            background: #FFFFFF;
            color: #8A8A8A;
            border: 1px solid #E8ECEF;
        }

        .scroll-top {
            position: fixed;
            bottom: 20px;
            right: 20px;
            width: 45px;
            height: 45px;
            background: linear-gradient(135deg, #C5A059, #E8C87A);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
            border: none;
            z-index: 999;
        }

            .scroll-top.show {
                opacity: 1;
                visibility: visible;
            }

            .scroll-top:hover {
                transform: scale(1.1) translateY(-3px);
                box-shadow: 0 8px 20px rgba(197,160,89,0.4);
            }

        .modal-custom {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.7);
            backdrop-filter: blur(8px);
            z-index: 2000;
            align-items: center;
            justify-content: center;
        }

            .modal-custom.active {
                display: flex;
            }

        .modal-content-custom {
            width: 90%;
            max-width: 500px;
            max-height: 85vh;
            overflow-y: auto;
            border-radius: 28px;
            padding: 2rem;
            position: relative;
        }

        body.dark-mode .modal-content-custom {
            background: #1A1A2E;
            border: 1px solid rgba(197,160,89,0.2);
        }

        body.light-mode .modal-content-custom {
            background: white;
            border: 1px solid #E8ECEF;
        }

        .modal-close {
            position: absolute;
            top: 15px;
            right: 20px;
            font-size: 1.5rem;
            cursor: pointer;
            background: none;
            border: none;
        }

        body.dark-mode .modal-close {
            color: white;
        }

        .form-group {
            margin-bottom: 1rem;
        }

            .form-group label {
                display: block;
                margin-bottom: 0.4rem;
                font-size: 0.8rem;
                font-weight: 500;
            }

        .form-control, .form-select {
            width: 100%;
            padding: 0.7rem 1rem;
            border-radius: 14px;
            transition: all 0.3s ease;
        }

        .form-select {
            cursor: pointer;
            appearance: auto;
        }

        body.dark-mode .form-control, body.dark-mode .form-select {
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.1);
            color: white;
        }

        body.light-mode .form-control, body.light-mode .form-select {
            background: #F0F2F5;
            border: 1px solid #E8ECEF;
            color: #333;
        }

        /* DARK MODE PLACEHOLDER FIX */
        body.dark-mode .form-control::placeholder,
        body.dark-mode textarea.form-control::placeholder {
            color: rgba(255, 255, 255, 0.6) !important;
            opacity: 1;
        }

        .form-control:focus, .form-select:focus {
            outline: none;
            border-color: #C5A059;
            box-shadow: 0 0 0 3px rgba(197,160,89,0.15);
        }

        .btn-gold {
            background: linear-gradient(135deg, #C5A059, #E8C87A);
            color: #000;
            border: none;
            padding: 0.6rem 1.5rem;
            border-radius: 50px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .btn-gold:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(197,160,89,0.3);
            }

        @@keyframes goldPulse {
            0%, 100% {
                text-shadow: 0 0 8px rgba(197,160,89,0.0);
            }

            50% {
                text-shadow: 0 0 18px rgba(197,160,89,0.5);
            }
        }

        .stat-value {
            animation: goldPulse 3s ease-in-out infinite;
        }
    </style>
</head>
<body class="dark-mode">

    <div class="app-wrapper">
        <!-- SIDEBAR -->
        <div class="sidebar">
            <div class="sidebar-inner">
                <div class="sidebar-profile" onclick="goToHome()">
                    <div class="profile-avatar"><i class="fas fa-palette"></i></div>
                    <div class="profile-name">ARTISTIC</div>
                    <div class="profile-role">Student Panel</div>
                </div>

                <div class="nav-menu">
                    <div class="nav-item active">
                        <a href="@Url.Action("Dashboard", "Student")">
                            <i class="fas fa-home"></i>
                            <span class="nav-text">Dashboard</span>
                        </a>
                    </div>
                    <div class="nav-item">
                        <a href="@Url.Action("UploadPosting", "Student")">
                            <i class="fas fa-upload"></i>
                            <span class="nav-text">Upload Posting</span>
                        </a>
                    </div>
                    <div class="nav-item">
                        <a href="@Url.Action("MyPostings", "Student")">
                            <i class="fas fa-list-ul"></i>
                            <span class="nav-text">My Postings</span>
                        </a>
                    </div>
                    <div class="nav-item">
                        <a href="@Url.Action("EditPosting", "Student")">
                            <i class="fas fa-edit"></i>
                            <span class="nav-text">Edit Posting</span>
                        </a>
                    </div>
                    <div class="nav-item">
                        <a href="@Url.Action("MyAwards", "Student")">
                            <i class="fas fa-trophy"></i>
                            <span class="nav-text">My Awards</span>
                        </a>
                    </div>
                    <div class="nav-item">
                        <a href="@Url.Action("BestPostings", "Student")">
                            <i class="fas fa-star"></i>
                            <span class="nav-text">Best Postings</span>
                        </a>
                    </div>
                    <div class="nav-item">
                        <a href="@Url.Action("ExhibitionStatus", "Student")">
                            <i class="fas fa-building"></i>
                            <span class="nav-text">Exhibition Status</span>
                        </a>
                    </div>
                </div>

                <div class="nav-footer">
                    <div class="logout-item">
                        <a href="#" onclick="logout()">
                            <i class="fas fa-sign-out-alt"></i>
                            <span class="logout-text">Logout</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="main-content">
            <div class="top-header">
                <button class="menu-toggle" id="menuToggle"><i class="fas fa-bars"></i></button>
                <div class="page-title">
                    <h2>Dashboard</h2>
                    <p>Welcome back, Student! Track your progress and submissions here.</p>
                </div>
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <div class="theme-toggle" id="themeToggle"><i class="fas fa-sun" id="themeIcon"></i></div>
                    <div class="user-dropdown">
                        <div class="user-avatar"><i class="fas fa-user-graduate"></i></div>
                        <div class="dropdown-menu-custom">
                            <a href="#" class="dropdown-item" onclick="logout()"><i class="fas fa-sign-out-alt"></i> Logout</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="container-fluid mt-4">
                <!-- Stats Cards -->
                <div class="row g-4 mb-4">
                    <div class="col-xl-3 col-md-6" data-aos="fade-up" data-aos-delay="100">
                        <div class="stat-card">
                            <div class="stat-icon"><i class="fas fa-paint-brush"></i></div>
                            <div class="stat-value">@(ViewBag.MySubmissionsCount ?? 0)</div>
                            <div class="stat-label">My Submissions</div>
                            <div class="trend-up">Saved in database</div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6" data-aos="fade-up" data-aos-delay="200">
                        <div class="stat-card">
                            <div class="stat-icon"><i class="fas fa-trophy"></i></div>
                            <div class="stat-value">@(ViewBag.MyAwardsCount ?? 0)</div>
                            <div class="stat-label">Awards Won</div>
                            <div class="trend-up">Your award count</div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6" data-aos="fade-up" data-aos-delay="300">
                        <div class="stat-card">
                            <div class="stat-icon"><i class="fas fa-calendar-check"></i></div>
                            <div class="stat-value">@(ViewBag.ActiveCompetitions ?? 0)</div>
                            <div class="stat-label">Active Competitions</div>
                            <div class="trend-up">Ongoing competitions</div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6" data-aos="fade-up" data-aos-delay="400">
                        <div class="stat-card">
                            <div class="stat-icon"><i class="fas fa-clock"></i></div>
                            <div class="stat-value">@(ViewBag.TotalArtworks ?? 0)</div>
                            <div class="stat-label">Total Artworks (Institute)</div>
                            <div class="trend-up">All submissions</div>
                        </div>
                    </div>
                </div>

                <!-- Charts -->
                <div class="row g-4 mb-4">
                    <div class="col-lg-8" data-aos="fade-up" data-aos-delay="100">
                        <div class="chart-card">
                            <div class="chart-title"><i class="fas fa-chart-line"></i> My Submissions Trend</div>
                            <div class="chart-container"><canvas id="submissionsChart"></canvas></div>
                        </div>
                    </div>
                    <div class="col-lg-4" data-aos="fade-up" data-aos-delay="200">
                        <div class="chart-card">
                            <div class="chart-title"><i class="fas fa-chart-pie"></i> My Competition Status</div>
                            <div class="chart-container"><canvas id="statusChart"></canvas></div>
                        </div>
                    </div>
                </div>

                <!-- Category & City Distribution -->
                <div class="row g-4 mb-4">
                    <div class="col-lg-6" data-aos="fade-up" data-aos-delay="100">
                        <div class="chart-card">
                            <div class="chart-title"><i class="fas fa-chart-simple"></i> Artwork by Category</div>
                            <div class="category-list">
                                <div><div class="category-item"><div class="category-name"><span>Painting</span></div><div>35%</div></div><div class="progress-bar-custom"><div class="progress-fill" style="width: 35%;"></div></div></div>
                                <div><div class="category-item"><div class="category-name"><span>Digital Art</span></div><div>28%</div></div><div class="progress-bar-custom"><div class="progress-fill" style="width: 28%;"></div></div></div>
                                <div><div class="category-item"><div class="category-name"><span>Animation</span></div><div>22%</div></div><div class="progress-bar-custom"><div class="progress-fill" style="width: 22%;"></div></div></div>
                                <div><div class="category-item"><div class="category-name"><span>Photography</span></div><div>15%</div></div><div class="progress-bar-custom"><div class="progress-fill" style="width: 15%;"></div></div></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6" data-aos="fade-up" data-aos-delay="200">
                        <div class="chart-card">
                            <div class="chart-title"><i class="fas fa-globe"></i> Student Distribution by City</div>
                            <div class="country-list">
                                <div><div class="country-item"><div class="country-name">🇵🇰 Lahore</div><div>45%</div></div><div class="progress-bar-custom"><div class="progress-fill" style="width: 45%;"></div></div></div>
                                <div><div class="country-item"><div class="country-name">🇵🇰 Karachi</div><div>25%</div></div><div class="progress-bar-custom"><div class="progress-fill" style="width: 25%;"></div></div></div>
                                <div><div class="country-item"><div class="country-name">🇵🇰 Islamabad</div><div>20%</div></div><div class="progress-bar-custom"><div class="progress-fill" style="width: 20%;"></div></div></div>
                                <div><div class="country-item"><div class="country-name">🇵🇰 Other Cities</div><div>10%</div></div><div class="progress-bar-custom"><div class="progress-fill" style="width: 10%;"></div></div></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recent Submissions & Activity -->
                <div class="row g-4 mb-4">
                    <div class="col-lg-7" data-aos="fade-up" data-aos-delay="100">
                        <div class="recent-table">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="chart-title"><i class="fas fa-clock"></i> My Recent Submissions</div>
                                <a href="@Url.Action("MyPostings", "Student")" style="color: #C5A059; text-decoration: none;">View All <i class="fas fa-arrow-right"></i></a>
                            </div>
                            <div class="table-responsive">
                                <table class="table-custom">
                                    <thead>
                                        <tr><th>Title</th><th>Competition</th><th>Submitted On</th><th>Status</th><th>Action</th></tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var recentSubmissions = ViewBag.RecentSubmissions as List<Submission>;
                                        }
                                        @if (recentSubmissions != null && recentSubmissions.Any())
                                        {
                                            foreach (var submission in recentSubmissions)
                                            {
                                                <tr>
                                                    <td>@submission.PaintingTitle</td>
                                                    <td>@submission.Competition?.Title</td>
                                                    <td>@submission.SubmittedAt.ToString("MMM dd, yyyy")</td>
                                                    <td>
                                                        @if (submission.Grade == SubmissionGrade.Pending)
                                                        {
                                                            <span class="badge-status badge-pending">Pending</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge-status badge-approved">@submission.Grade</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <a class="btn-sm" href="@Url.Action("MyPostings", "Student")">View</a>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="5" class="text-center">No submissions yet.</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-5" data-aos="fade-up" data-aos-delay="200">
                        <div class="chart-card">
                            <div class="chart-title"><i class="fas fa-history"></i> Recent Activity</div>
                            <div class="activity-timeline">
                                <div class="activity-item"><div class="activity-icon"><i class="fas fa-check-circle"></i></div><div class="activity-detail"><div class="activity-title">Submission Approved</div><div class="activity-time">5 minutes ago</div></div></div>
                                <div class="activity-item"><div class="activity-icon"><i class="fas fa-upload"></i></div><div class="activity-detail"><div class="activity-title">New Artwork Uploaded</div><div class="activity-time">2 hours ago</div></div></div>
                                <div class="activity-item"><div class="activity-icon"><i class="fas fa-trophy"></i></div><div class="activity-detail"><div class="activity-title">Award Received!</div><div class="activity-time">1 day ago</div></div></div>
                                <div class="activity-item"><div class="activity-icon"><i class="fas fa-edit"></i></div><div class="activity-detail"><div class="activity-title">Posting Edited</div><div class="activity-time">3 days ago</div></div></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="row g-4" data-aos="fade-up">
                    <div class="col-12">
                        <div class="chart-card">
                            <div class="chart-title"><i class="fas fa-bolt"></i> Quick Actions</div>
                            <div class="quick-actions">
                                <div class="quick-btn" onclick="window.location.href='@Url.Action("UploadPosting", "Student")'"><i class="fas fa-upload"></i> <span>Upload Artwork</span></div>
                                <div class="quick-btn" onclick="window.location.href='@Url.Action("MyAwards", "Student")'"><i class="fas fa-medal"></i> <span>View Awards</span></div>
                                <div class="quick-btn" onclick="window.location.href='@Url.Action("BestPostings", "Student")'"><i class="fas fa-star"></i> <span>Top Postings</span></div>
                                <div class="quick-btn" onclick="window.location.href='@Url.Action("ExhibitionStatus", "Student")'"><i class="fas fa-building"></i> <span>Exhibition Status</span></div>
                                <div class="quick-btn" onclick="generateReport()"><i class="fas fa-file-pdf"></i> <span>Download Report</span></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="footer">
                <p>© 2025 ARTISTIC - Institute of Fine Arts. All rights reserved.</p>
            </div>
        </div>
    </div>

    <!-- Upload Modal -->
    <div class="modal-custom" id="uploadArtworkModal">
        <div class="modal-content-custom">
            <button class="modal-close" onclick="closeModal('uploadArtworkModal')">&times;</button>
            <h3 style="font-family:'Playfair Display',serif; color:#C5A059; margin-bottom:1.2rem;">Upload New Artwork</h3>
            <form id="uploadArtworkForm">
                <div class="form-group"><label>Title</label><input type="text" class="form-control" id="artworkTitle" placeholder="Enter artwork title" required></div>
                <div class="form-group"><label>Category</label><select class="form-select" id="artworkCategory"><option>Painting</option><option>Digital Art</option><option>Animation</option><option>Photography</option></select></div>
                <div class="form-group"><label>Description</label><textarea class="form-control" id="artworkDesc" rows="3" placeholder="Describe your artwork..."></textarea></div>
                <button type="submit" class="btn-gold w-100">Upload Artwork</button>
            </form>
        </div>
    </div>

    <button class="scroll-top" id="scrollTop"><i class="fas fa-arrow-up"></i></button>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        AOS.init({ duration: 800, once: true });

        const themeToggle = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');
        const body = document.body;

        if (localStorage.getItem('studentTheme') === 'light') {
        body.classList.remove('dark-mode'); body.classList.add('light-mode');
        themeIcon.classList.replace('fa-sun','fa-moon');
        }

        themeToggle.addEventListener('click', () => {
        if (body.classList.contains('dark-mode')) {
        body.classList.replace('dark-mode','light-mode');
        localStorage.setItem('studentTheme','light');
        themeIcon.classList.replace('fa-sun','fa-moon');
        } else {
        body.classList.replace('light-mode','dark-mode');
        localStorage.setItem('studentTheme','dark');
        themeIcon.classList.replace('fa-moon','fa-sun');
        }
        });

        document.getElementById('menuToggle').addEventListener('click', () => document.querySelector('.sidebar').classList.toggle('active'));

        const scrollBtn = document.getElementById('scrollTop');
        window.addEventListener('scroll', () => scrollBtn.classList.toggle('show', window.scrollY > 300));
        scrollBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

        function goToHome() { window.location.href = '@Url.Action("Index", "Home")'; }
        function openModal(id) { document.getElementById(id).classList.add('active'); document.body.style.overflow = 'hidden'; }
        function closeModal(id) { document.getElementById(id).classList.remove('active'); document.body.style.overflow = 'auto'; }
        function showSuccess(msg) {
        Swal.fire({
        title: 'Success!',
        text: msg,
        icon: 'success',
        confirmButtonColor: '#C5A059',
        background: body.classList.contains('dark-mode') ? '#1A1A2E' : '#FFFFFF',
        color: body.classList.contains('dark-mode') ? 'white' : '#333',
        timer: 2000,
        showConfirmButton: false
        });
        }
        function viewSubmission() {
        Swal.fire({
        title: 'Submission Details',
        html: '<strong>Details:</strong> Open My Postings to view your uploaded artwork.',
        icon: 'info',
        confirmButtonColor: '#C5A059',
        background: body.classList.contains('dark-mode') ? '#1A1A2E' : '#FFFFFF',
        color: body.classList.contains('dark-mode') ? 'white' : '#333'
        });
        }
        function generateReport() { showSuccess('Report generated successfully!'); }
        function logout() {
        Swal.fire({
        title: 'Logout?',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#C5A059',
        confirmButtonText: 'Yes',
        background: body.classList.contains('dark-mode') ? '#1A1A2E' : '#FFFFFF',
        color: body.classList.contains('dark-mode') ? 'white' : '#333'
        }).then((r) => { if(r.isConfirmed) window.location.href = '@Url.Action("Index", "Home")'; });
        }

        document.getElementById('uploadArtworkForm')?.addEventListener('submit', (e) => {
        e.preventDefault();
        showSuccess('Artwork uploaded!');
        closeModal('uploadArtworkModal');
        e.target.reset();
        });

        // Charts
        const isDark = body.classList.contains('dark-mode');
        const tickColor = isDark ? 'white' : '#333';

        const ctx = document.getElementById('submissionsChart')?.getContext('2d');
        if (ctx) {
        new Chart(ctx, {
        type: 'line',
        data: {
        labels: ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'],
        datasets: [{
        label: 'Submissions',
        data: [12,19,25,32,38,45,52,48,55,62,70,78],
        borderColor: '#C5A059',
        backgroundColor: 'rgba(197,160,89,0.07)',
        fill: true,
        tension: 0.4,
        pointBackgroundColor: '#C5A059',
        pointRadius: 4,
        pointHoverRadius: 7
        }]
        },
        options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { labels: { color: tickColor } } },
        scales: {
        y: { grid: { color: 'rgba(197,160,89,0.07)' }, ticks: { color: tickColor } },
        x: { grid: { color: 'rgba(197,160,89,0.07)' }, ticks: { color: tickColor } }
        }
        }
        });
        }

        const ctxPie = document.getElementById('statusChart')?.getContext('2d');
        if (ctxPie) {
        new Chart(ctxPie, {
        type: 'doughnut',
        data: {
        labels: ['Ongoing','Upcoming','Completed'],
        datasets: [{ data:[3,7,2], backgroundColor:['#28a745','#ffc107','#17a2b8'], borderWidth: 3, borderColor: isDark ? '#0A0A0A' : '#F0F2F5' }]
        },
        options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { position:'bottom', labels: { color: tickColor, padding: 16 } } },
        cutout: '60%'
        }
        });
        }

        // 3D tilt on stat cards
        document.querySelectorAll('.stat-card').forEach(card => {
        card.addEventListener('mousemove', (e) => {
        const r = card.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        card.style.transform = `perspective(600px) rotateY(${x*14}deg) rotateX(${-y*14}deg) translateY(-8px) scale(1.02)`;
        });
        card.addEventListener('mouseleave', () => {
        card.style.transform = '';
        });
        });
    </script>
</body>
</html>