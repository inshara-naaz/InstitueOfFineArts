@{
    ViewData["Title"] = "About Page";
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>About Us | ARTISTIC Institute of Fine Arts</title>

    <!-- Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@@400;500;600;700;800;900&family=Poppins:wght@@300;400;500;600;700;800&display=swap"
          rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://unpkg.com/aos@@2.3.1/dist/aos.css" rel="stylesheet">

    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            /* Dark Mode Colors (Default) */
            :root {
                --primary: #C5A059;
                --primary-dark: #A8883A;
                --primary-light: #D4B87A;
                --secondary: #1A1A2E;
                --dark: #0A0A0A;
                --darker: #050505;
                --gray: #8A8A8A;
                --bg-body: var(--dark);
                --text-color: #FFFFFF;
                --card-bg: rgba(26, 26, 46, 0.9);
                --footer-bg: var(--darker);
                --navbar-bg: rgba(5, 5, 5, 0.95);
                --border-color: rgba(197, 160, 89, 0.15);
                --stats-bg: rgba(26, 26, 46, 0.9);
                --modal-bg: linear-gradient(135deg, #1A1A2E, #0A0A0A);
                --modal-text: #FFFFFF;
                --gradient-gold: linear-gradient(135deg, #C5A059 0%, #E8C87A 50%, #C5A059 100%);
                --gradient-dark: linear-gradient(135deg, #0A0A0A 0%, #1A1A2E 100%);
                --shadow-gold: 0 10px 30px rgba(197, 160, 89, 0.3);
                --transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
            }

            /* Light Mode - White & Gold only */
            body.light-mode {
                --bg-body: #FFFFFF;
                --text-color: #1A1A1A;
                --card-bg: #FFFFFF;
                --footer-bg: #F5F5F5;
                --navbar-bg: #FFFFFF;
                --border-color: rgba(197, 160, 89, 0.25);
                --stats-bg: #FFFFFF;
                --modal-bg: #FFFFFF;
                --modal-text: #1A1A1A;
                --secondary: #F8F8F8;
            }

            body {
                font-family: 'Poppins', sans-serif;
                background: var(--bg-body);
                color: var(--text-color);
                overflow-x: hidden;
                transition: var(--transition);
            }

            ::-webkit-scrollbar {
                width: 8px;
            }

            ::-webkit-scrollbar-track {
                background: var(--secondary);
            }

            ::-webkit-scrollbar-thumb {
                background: var(--primary);
                border-radius: 10px;
            }

            /* Dark/Light Mode Toggle Button */
            .theme-toggle {
                background: rgba(197, 160, 89, 0.15);
                border: 1px solid var(--primary);
                color: var(--primary);
                width: 40px;
                height: 40px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                transition: var(--transition);
                margin-left: 0.5rem;
            }

                .theme-toggle:hover {
                    background: var(--primary);
                    color: #000;
                    transform: rotate(15deg);
                }

                .theme-toggle i {
                    font-size: 1.2rem;
                }

            /* Particle Background */
            #particles-js {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                z-index: 0;
                pointer-events: none;
            }

            .container,
            .page-header,
            .story-section,
            .stats-section,
            .mission-card,
            .vision-card,
            .value-card,
            .team-card,
            .timeline-section,
            .testimonial-card,
            .why-choose-section,
            .cta-section,
            footer,
            nav {
                position: relative;
                z-index: 2;
            }

            /* Navbar - Responsive */
            .navbar {
                background: var(--navbar-bg);
                backdrop-filter: blur(20px);
                padding: 1rem 2rem;
                position: fixed;
                top: 0;
                width: 100%;
                z-index: 1000;
                border-bottom: 1px solid var(--border-color);
                transition: var(--transition);
            }

            @@media (max-width: 1200px) {
                .navbar {
                    padding: 0.9rem 1.5rem;
                }
            }

            @@media (max-width: 991px) {
                .navbar {
                    padding: 0.8rem 1rem;
                }
            }

            @@media (max-width: 768px) {
                .navbar.scrolled {
                    padding: 0.5rem 1rem;
                }
            }

            .navbar.scrolled {
                padding: 0.7rem 2rem;
            }

            .logo {
                font-family: 'Playfair Display', serif;
                font-size: 1.6rem;
                font-weight: 800;
                background: var(--gradient-gold);
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent;
                text-decoration: none;
                transition: var(--transition);
            }

            @@media (max-width: 992px) {
                .logo {
                    font-size: 1.4rem;
                }
            }

            @@media (max-width: 768px) {
                .logo {
                    font-size: 1.3rem;
                }
            }

            @@media (max-width: 576px) {
                .logo {
                    font-size: 1.2rem;
                }
            }

            .logo:hover {
                transform: scale(1.05);
                letter-spacing: 2px;
            }

            .navbar-toggler {
                border-color: var(--primary);
            }

            .nav-link {
                color: var(--text-color) !important;
                opacity: 0.8;
                font-weight: 500;
                transition: var(--transition);
                position: relative;
                padding: 0.5rem 1rem;
            }

            @@media (max-width: 991px) {
                .nav-link {
                    padding: 0.5rem 0;
                    text-align: center;
                }
            }

            .nav-link::after {
                content: '';
                position: absolute;
                bottom: -5px;
                left: 0;
                width: 0;
                height: 2px;
                background: var(--gradient-gold);
                transition: var(--transition);
            }

            @@media (max-width: 991px) {
                .nav-link::after {
                    display: none;
                }
            }

            .nav-link:hover::after {
                width: 100%;
            }

            .nav-link:hover {
                color: var(--primary) !important;
                opacity: 1;
                transform: translateY(-2px);
            }

            .btn-nav {
                background: transparent;
                border: 1.5px solid var(--primary);
                color: var(--primary);
                padding: 0.4rem 1.2rem;
                border-radius: 50px;
                text-decoration: none;
                transition: var(--transition);
                font-size: 0.85rem;
                cursor: pointer;
                display: inline-block;
            }

            @@media (max-width: 991px) {
                .btn-nav {
                    padding: 0.3rem 1rem;
                    font-size: 0.75rem;
                    margin: 0.2rem 0;
                    text-align: center;
                }
            }

            @@media (max-width: 576px) {
                .btn-nav {
                    padding: 0.25rem 0.8rem;
                    font-size: 0.7rem;
                }
            }

            .btn-nav:hover {
                background: var(--primary);
                color: #000;
                transform: translateY(-2px);
                box-shadow: var(--shadow-gold);
            }

            .btn-register {
                background: var(--gradient-gold);
                color: #000;
                border: none;
            }

            /* Page Header - Responsive */
            .page-header {
                padding: 140px 0 80px;
                background: var(--gradient-dark);
                position: relative;
                overflow: hidden;
                text-align: center;
                z-index: 2;
            }

            @@media (max-width: 1200px) {
                .page-header {
                    padding: 130px 0 70px;
                }
            }

            @@media (max-width: 992px) {
                .page-header {
                    padding: 120px 0 60px;
                }
            }

            @@media (max-width: 768px) {
                .page-header {
                    padding: 110px 0 50px;
                }
            }

            @@media (max-width: 576px) {
                .page-header {
                    padding: 100px 0 40px;
                }
            }

            .page-header::before {
                content: '';
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: radial-gradient(circle, rgba(197, 160, 89, 0.08), transparent);
                animation: rotateBg 20s linear infinite;
                z-index: -1;
            }

            @@keyframes rotateBg {
                from {
                    transform: rotate(0deg);
                }

                to {
                    transform: rotate(360deg);
                }
            }

            .page-header h1 {
                font-size: clamp(1.8rem, 5vw, 4rem);
                font-weight: 800;
                animation: fadeInDown 0.8s ease;
                color: #FFFFFF;
            }

            @@keyframes fadeInDown {
                from {
                    opacity: 0;
                    transform: translateY(-50px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .page-header p {
                color: rgba(255, 255, 255, 0.85);
                animation: fadeInUp 0.8s ease 0.2s both;
                font-size: clamp(0.85rem, 3vw, 1.1rem);
            }

            /* Section Titles - Responsive */
            .section-title {
                font-family: 'Playfair Display', serif;
                font-size: clamp(1.5rem, 5vw, 2.2rem);
                font-weight: 700;
                text-align: center;
                margin-bottom: 2rem;
                position: relative;
                color: var(--text-color);
            }

                .section-title::after {
                    content: '';
                    position: absolute;
                    bottom: -12px;
                    left: 50%;
                    transform: translateX(-50%);
                    width: 80px;
                    height: 3px;
                    background: var(--gradient-gold);
                    border-radius: 3px;
                }

            /* Story Section - Responsive */
            .story-section {
                background: var(--card-bg);
                backdrop-filter: blur(10px);
                border-radius: 25px;
                padding: 2.5rem;
                border: 1px solid var(--border-color);
            }

            @@media (max-width: 768px) {
                .story-section {
                    padding: 1.5rem;
                }
            }

            .story-img {
                background: rgba(197, 160, 89, 0.1);
                border-radius: 20px;
                height: 100%;
                min-height: 350px;
                display: flex;
                align-items: center;
                justify-content: center;
                overflow: hidden;
                border: 1px solid rgba(197, 160, 89, 0.3);
            }

            @@media (max-width: 992px) {
                .story-img {
                    min-height: 300px;
                    margin-top: 1.5rem;
                }
            }

            @@media (max-width: 576px) {
                .story-img {
                    min-height: 250px;
                }
            }

            .story-img img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                border-radius: 20px;
            }

            .story-text {
                color: var(--gray);
                line-height: 1.8;
                font-size: clamp(0.85rem, 3vw, 1rem);
            }

            /* Stats Section - Responsive */
            .stats-section {
                background: var(--stats-bg);
                backdrop-filter: blur(10px);
                border-radius: 25px;
                padding: 3rem 2rem;
                border: 1px solid var(--border-color);
            }

            @@media (max-width: 768px) {
                .stats-section {
                    padding: 2rem 1rem;
                }
            }

            .stat-item {
                text-align: center;
                transition: var(--transition);
                margin-bottom: 1rem;
            }

                .stat-item:hover {
                    transform: translateY(-5px);
                }

            .stat-number {
                font-size: clamp(1.5rem, 5vw, 2.5rem);
                font-weight: 800;
                color: var(--primary);
                font-family: 'Playfair Display', serif;
            }

            .stat-label {
                font-size: clamp(0.65rem, 2.5vw, 0.75rem);
                color: var(--gray);
                letter-spacing: 1px;
            }

            /* Mission & Vision Cards - Responsive */
            .mission-card,
            .vision-card {
                background: var(--card-bg);
                backdrop-filter: blur(10px);
                border-radius: 25px;
                padding: 2rem;
                text-align: center;
                height: 100%;
                transition: var(--transition);
                border: 1px solid var(--border-color);
            }

            @@media (max-width: 768px) {

                .mission-card,
                .vision-card {
                    padding: 1.5rem;
                }
            }

            .mission-card:hover,
            .vision-card:hover {
                transform: translateY(-8px);
                border-color: var(--primary);
                box-shadow: var(--shadow-gold);
            }

            .mission-icon,
            .vision-icon {
                width: 80px;
                height: 80px;
                background: rgba(197, 160, 89, 0.1);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 1rem;
                transition: var(--transition);
            }

            @@media (max-width: 576px) {

                .mission-icon,
                .vision-icon {
                    width: 60px;
                    height: 60px;
                }
            }

            .mission-card:hover .mission-icon,
            .vision-card:hover .vision-icon {
                background: var(--primary);
                transform: rotateY(360deg);
            }

            .mission-icon i,
            .vision-icon i {
                font-size: 2rem;
                color: var(--primary);
            }

            @@media (max-width: 576px) {

                .mission-icon i,
                .vision-icon i {
                    font-size: 1.5rem;
                }
            }

            .mission-card:hover .mission-icon i,
            .vision-card:hover .vision-icon i {
                color: #000;
            }

            .mission-card p,
            .vision-card p {
                color: var(--gray);
                font-size: clamp(0.85rem, 3vw, 1rem);
            }

            /* Core Values Cards - Responsive */
            .value-card {
                background: var(--card-bg);
                backdrop-filter: blur(10px);
                border-radius: 20px;
                padding: 1.8rem;
                text-align: center;
                height: 100%;
                transition: var(--transition);
                border: 1px solid var(--border-color);
            }

            @@media (max-width: 768px) {
                .value-card {
                    padding: 1.2rem;
                }
            }

            .value-card:hover {
                transform: translateY(-8px);
                border-color: var(--primary);
            }

            .value-icon {
                font-size: 2rem;
                color: var(--primary);
                margin-bottom: 1rem;
            }

            @@media (max-width: 576px) {
                .value-icon {
                    font-size: 1.5rem;
                }
            }

            .value-card h4 {
                color: var(--text-color);
                font-size: clamp(1rem, 3.5vw, 1.2rem);
            }

            .value-card p {
                color: var(--gray);
                font-size: clamp(0.8rem, 3vw, 0.85rem);
            }

            /* Team Cards - Responsive */
            .team-card {
                background: var(--card-bg);
                backdrop-filter: blur(10px);
                border-radius: 20px;
                overflow: hidden;
                transition: var(--transition);
                height: 100%;
                border: 1px solid var(--border-color);
            }

                .team-card:hover {
                    transform: translateY(-8px);
                    border-color: var(--primary);
                    box-shadow: var(--shadow-gold);
                }

            .team-img {
                background: rgba(197, 160, 89, 0.1);
                height: 200px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 3rem;
                color: var(--primary);
            }

            @@media (max-width: 768px) {
                .team-img {
                    height: 160px;
                    font-size: 2.5rem;
                }
            }

            .team-info {
                padding: 1.5rem;
                text-align: center;
            }

            @@media (max-width: 768px) {
                .team-info {
                    padding: 1rem;
                }
            }

            .team-name {
                font-family: 'Playfair Display', serif;
                font-size: clamp(1rem, 3.5vw, 1.2rem);
                font-weight: 700;
                margin-bottom: 0.3rem;
                color: var(--text-color);
            }

            .team-role {
                color: var(--primary);
                font-weight: 600;
                font-size: clamp(0.7rem, 2.5vw, 0.8rem);
                margin-bottom: 0.5rem;
            }

            .team-desc {
                color: var(--gray);
                font-size: clamp(0.7rem, 2.5vw, 0.8rem);
            }

            /* Timeline Section - Responsive */
            .timeline-section {
                background: var(--card-bg);
                backdrop-filter: blur(10px);
                border-radius: 25px;
                padding: 2rem;
                border: 1px solid var(--border-color);
            }

            @@media (max-width: 768px) {
                .timeline-section {
                    padding: 1.5rem;
                }
            }

            .timeline-item {
                text-align: center;
                padding: 1rem;
                margin-bottom: 1rem;
            }

            .timeline-year {
                font-size: clamp(0.9rem, 3.5vw, 1.2rem);
                font-weight: 800;
                color: #000;
                background: var(--gradient-gold);
                display: inline-block;
                padding: 0.3rem 1rem;
                border-radius: 50px;
                margin-bottom: 0.5rem;
            }

            .timeline-text {
                color: var(--gray);
                font-size: clamp(0.75rem, 3vw, 0.85rem);
            }

            /* Testimonial Cards - Responsive */
            .testimonial-card {
                background: var(--card-bg);
                backdrop-filter: blur(10px);
                border-radius: 20px;
                padding: 1.5rem;
                text-align: center;
                height: 100%;
                transition: var(--transition);
                border: 1px solid var(--border-color);
            }

            @@media (max-width: 768px) {
                .testimonial-card {
                    padding: 1rem;
                }
            }

            .testimonial-card:hover {
                transform: translateY(-5px);
                border-color: var(--primary);
            }

            .testimonial-icon {
                font-size: 1.5rem;
                color: var(--primary);
                margin-bottom: 0.5rem;
            }

            .testimonial-text {
                color: var(--gray);
                font-size: clamp(0.8rem, 3vw, 0.85rem);
                line-height: 1.6;
                font-style: italic;
            }

            .testimonial-name {
                font-weight: 700;
                color: var(--primary);
                margin-top: 0.5rem;
                font-size: clamp(0.8rem, 3vw, 0.9rem);
            }

            /* Why Choose Us Section - Responsive */
            .why-choose-section {
                background: var(--card-bg);
                backdrop-filter: blur(10px);
                border-radius: 25px;
                padding: 2.5rem;
                border: 1px solid var(--border-color);
            }

            @@media (max-width: 768px) {
                .why-choose-section {
                    padding: 1.5rem;
                }
            }

            .why-choose-title {
                font-family: 'Playfair Display', serif;
                font-size: clamp(1.3rem, 4vw, 1.8rem);
                margin-bottom: 1.5rem;
                color: var(--text-color);
            }

            .why-item {
                display: flex;
                align-items: center;
                margin-bottom: 1rem;
                transition: var(--transition);
                color: var(--gray);
                font-size: clamp(0.85rem, 3vw, 1rem);
            }

            @@media (max-width: 576px) {
                .why-item {
                    font-size: 0.8rem;
                }
            }

            .why-item:hover {
                transform: translateX(10px);
                color: var(--primary);
            }

            .why-icon {
                width: 40px;
                height: 40px;
                background: rgba(197, 160, 89, 0.1);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                margin-right: 1rem;
                flex-shrink: 0;
            }

            @@media (max-width: 576px) {
                .why-icon {
                    width: 35px;
                    height: 35px;
                }
            }

            .why-icon i {
                font-size: 1rem;
                color: var(--primary);
            }

            .why-image-container {
                background: rgba(197, 160, 89, 0.1);
                border-radius: 20px;
                padding: 1rem;
                display: flex;
                align-items: center;
                justify-content: center;
                border: 1px solid rgba(197, 160, 89, 0.3);
                transition: var(--transition);
            }

            @@media (max-width: 768px) {
                .why-image-container {
                    margin-top: 2rem;
                }
            }

            .why-image-container:hover {
                transform: scale(1.02);
                border-color: var(--primary);
                box-shadow: var(--shadow-gold);
            }

            .why-image-container img {
                width: 100%;
                max-width: 300px;
                height: auto;
                border-radius: 15px;
                transition: var(--transition);
            }

            @@media (max-width: 768px) {
                .why-image-container img {
                    max-width: 250px;
                }
            }

            @@media (max-width: 576px) {
                .why-image-container img {
                    max-width: 200px;
                }
            }

            /* CTA Section - Responsive */
            .cta-section {
                background: var(--card-bg);
                backdrop-filter: blur(10px);
                border-radius: 25px;
                padding: 2.5rem;
                text-align: center;
                border: 1px solid var(--border-color);
            }

            @@media (max-width: 768px) {
                .cta-section {
                    padding: 1.5rem;
                }
            }

            .btn-join,
            .btn-contact {
                border-radius: 50px;
                padding: 0.8rem 1.8rem;
                font-weight: 600;
                text-decoration: none;
                display: inline-block;
                margin: 0.5rem;
                transition: var(--transition);
            }

            @@media (max-width: 576px) {

                .btn-join,
                .btn-contact {
                    padding: 0.6rem 1.2rem;
                    font-size: 0.85rem;
                }
            }

            .btn-join {
                background: var(--gradient-gold);
                color: #000;
            }

                .btn-join:hover {
                    transform: scale(1.05);
                    box-shadow: var(--shadow-gold);
                }

            .btn-contact {
                background: transparent;
                border: 2px solid var(--primary);
                color: var(--primary);
            }

                .btn-contact:hover {
                    background: var(--primary);
                    color: #000;
                    transform: scale(1.05);
                }

            .cta-section p {
                color: var(--gray);
                font-size: clamp(0.85rem, 3vw, 1rem);
                margin-bottom: 1rem;
            }

            /* Login/Register Modal Styles */
            .login-modal,
            .register-modal {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.96);
                backdrop-filter: blur(20px);
                z-index: 2000;
                align-items: center;
                justify-content: center;
            }

                .login-modal.active,
                .register-modal.active {
                    display: flex;
                    animation: fadeInModal 0.3s ease;
                }

            @@keyframes fadeInModal {
                from {
                    opacity: 0;
                }

                to {
                    opacity: 1;
                }
            }

            .modal-login-glass,
            .modal-register-glass {
                background: var(--modal-bg);
                border-radius: 28px;
                max-width: 450px;
                width: 90%;
                padding: 2rem 1.5rem 1.5rem 1.5rem;
                border: 1px solid rgba(197, 160, 89, 0.25);
                animation: modalPop 0.4s cubic-bezier(0.34, 1.2, 0.64, 1);
                max-height: 90vh;
                overflow-y: auto;
                position: relative;
            }

            @@media (max-width: 576px) {

                .modal-login-glass,
                .modal-register-glass {
                    padding: 1.8rem 1rem 1rem 1rem;
                    max-width: 95%;
                    border-radius: 20px;
                }
            }

            @@keyframes modalPop {
                from {
                    opacity: 0;
                    transform: scale(0.9) translateY(-40px);
                }

                to {
                    opacity: 1;
                    transform: scale(1) translateY(0);
                }
            }

            .close-modal {
                position: absolute;
                top: 15px;
                right: 20px;
                font-size: 1.5rem;
                cursor: pointer;
                color: var(--gray);
                transition: var(--transition);
                background: none;
                border: none;
            }

                .close-modal:hover {
                    color: var(--primary);
                    transform: rotate(90deg);
                }

            .modal-header-custom {
                text-align: center;
                margin-bottom: 1.5rem;
            }

                .modal-header-custom h3 {
                    font-size: clamp(1.2rem, 4vw, 1.5rem);
                    font-weight: 700;
                    color: var(--modal-text);
                }

                .modal-header-custom p {
                    color: var(--gray);
                    font-size: 0.8rem;
                }

            .role-selector {
                display: flex;
                gap: 0.5rem;
                flex-wrap: wrap;
                justify-content: center;
                margin-bottom: 1.5rem;
            }

            .role-btn {
                background: rgba(197, 160, 89, 0.1);
                border: 1px solid var(--border-color);
                padding: 0.4rem 0.8rem;
                border-radius: 50px;
                cursor: pointer;
                font-size: 0.75rem;
                color: var(--modal-text);
                transition: var(--transition);
            }

                .role-btn.active {
                    background: var(--primary);
                    color: #000;
                }

                .role-btn:hover {
                    background: var(--primary);
                    color: #000;
                }

            .input-group {
                margin-bottom: 1rem;
            }

                .input-group label {
                    font-size: 0.75rem;
                    margin-bottom: 0.3rem;
                    display: block;
                    color: var(--gray);
                }

                .input-group input,
                .input-group select {
                    width: 100%;
                    padding: 0.7rem;
                    background: rgba(197, 160, 89, 0.05);
                    border: 1px solid var(--border-color);
                    border-radius: 10px;
                    color: var(--modal-text);
                    font-size: 0.85rem;
                }

                .input-group select {
                    appearance: auto;
                    -webkit-appearance: menulist;
                    -moz-appearance: menulist;
                    cursor: pointer;
                }

                    .input-group select option {
                        background: var(--card-bg);
                        color: var(--modal-text);
                    }

            body.light-mode .input-group select option {
                background: #ffffff;
                color: #1a1a1a;
            }

            .switch-form {
                text-align: center;
                margin-top: 1rem;
                font-size: 0.8rem;
                cursor: pointer;
                color: var(--gray);
            }

                .switch-form span {
                    color: var(--primary);
                }

            .demo-creds p {
                font-size: 0.7rem;
                margin-bottom: 0.3rem;
                cursor: pointer;
                color: var(--primary);
            }

                .demo-creds p:hover {
                    text-decoration: underline;
                }

            /* Footer - Responsive */
            .footer {
                background: var(--footer-bg);
                padding: 4rem 0 2rem;
                margin-top: 4rem;
                border-top: 1px solid var(--border-color);
            }

            @@media (max-width: 992px) {
                .footer {
                    padding: 3rem 0 1.5rem;
                    margin-top: 3rem;
                }
            }

            @@media (max-width: 768px) {
                .footer {
                    padding: 2rem 0 1.2rem;
                    margin-top: 2rem;
                    text-align: center;
                }
            }

            .footer-logo {
                font-family: 'Playfair Display', serif;
                font-size: clamp(1.3rem, 4vw, 1.8rem);
                font-weight: 800;
                background: var(--gradient-gold);
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent;
                display: inline-block;
            }

            .footer-links {
                list-style: none;
                padding: 0;
            }

                .footer-links li {
                    margin-bottom: 0.8rem;
                }

            @@media (max-width: 768px) {
                .footer-links li {
                    margin-bottom: 0.5rem;
                }
            }

            .footer-links a {
                color: var(--gray);
                text-decoration: none;
                transition: var(--transition);
                font-size: clamp(0.8rem, 3vw, 0.85rem);
            }

            .social-icons {
                display: flex;
                gap: 1rem;
                margin-top: 1.5rem;
            }

            @@media (max-width: 768px) {
                .social-icons {
                    justify-content: center;
                }
            }

            .social-icon {
                width: 40px;
                height: 40px;
                background: rgba(197, 160, 89, 0.1);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                color: var(--primary);
                transition: var(--transition);
            }

            @@media (max-width: 768px) {
                .social-icon {
                    width: 35px;
                    height: 35px;
                }
            }

            .social-icon:hover {
                background: var(--primary);
                color: #000;
                transform: translateY(-5px) rotate(360deg);
            }

            /* Scroll Top - Responsive */
            .scroll-top {
                position: fixed;
                bottom: 30px;
                right: 30px;
                width: 50px;
                height: 50px;
                background: var(--gradient-gold);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #000;
                cursor: pointer;
                opacity: 0;
                visibility: hidden;
                transition: var(--transition);
                border: none;
                z-index: 999;
            }

            @@media (max-width: 768px) {
                .scroll-top {
                    width: 40px;
                    height: 40px;
                    bottom: 20px;
                    right: 20px;
                }
            }

            @@media (max-width: 576px) {
                .scroll-top {
                    width: 35px;
                    height: 35px;
                }
            }

            .scroll-top.show {
                opacity: 1;
                visibility: visible;
            }

            .scroll-top:hover {
                transform: translateY(-5px);
            }

            /* Responsive Grid Gaps */
            @@media (max-width: 992px) {
                .row.g-4 {
                    --bs-gutter-y: 1.2rem;
                    --bs-gutter-x: 1.2rem;
                }
            }

            @@media (max-width: 768px) {
                .row.g-4 {
                    --bs-gutter-y: 1rem;
                    --bs-gutter-x: 1rem;
                }
            }
    </style>
</head>

