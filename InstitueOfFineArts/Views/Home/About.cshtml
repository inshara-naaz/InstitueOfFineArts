                        <li>
                            <i class="fas fa-clock me-2" style="color: var(--primary);"></i> Mon-Fri: 9:00 AM - 6:00 PM
                        </li>
                    </ul>
                </div>
            </div>
            <hr class="my-4" style="border-color: var(--border-color);">
            <div class="text-center">
                <p style="color: var(--gray); margin: 0;">
                    © 2025 ARTISTIC - Institute of Fine Arts. All rights reserved.
                    Designed with <i class="fas fa-heart" style="color: var(--primary);"></i> in Lahore
                </p>
            </div>
        </div>
    </footer>

    <button class="scroll-top" id="scrollTop"><i class="fas fa-arrow-up"></i></button>

    <!-- Register Modal -->
    <div class="register-modal" id="registerModal">
        <div class="modal-register-glass">
            <button class="close-modal" onclick="closeRegisterModal()">&times;</button>
            <div class="modal-header-custom">
                <h3>Create Account</h3>
                <p>Join ARTISTIC Institute</p>
            </div>

            <div class="input-group">
                <label>Full Name</label>
                <input type="text" id="regName" placeholder="Enter your full name">
            </div>
            <div class="input-group">
                <label>Email Address</label>
                <input type="email" id="regEmail" placeholder="you@@example.com">
            </div>
            <div class="input-group">
                <label>Password</label>
                <input type="password" id="regPassword" placeholder="Create a password (min 6 characters)">
            </div>
            <div class="input-group">
                <label>Confirm Password</label>
                <input type="password" id="regConfirmPassword" placeholder="Confirm your password">
            </div>
            <div class="input-group">
                <label>Select Program (For Students)</label>
                <select id="regProgram">
                    <option value="Bachelor of Fine Arts (BFA)">Bachelor of Fine Arts (BFA)</option>
                    <option value="Diploma in Digital Art">Diploma in Digital Art</option>
                    <option value="Certificate in Animation">Certificate in Animation</option>
                    <option value="Short Course in Painting">Short Course in Painting</option>
                </select>
            </div>
            <div class="input-group">
                <label>Register as</label>
                <select id="regRole">
                    <option value="Student">🎓 Student</option>
                    <option value="Staff">👨‍🏫 Staff</option>
                    <option value="Manager">📊 Manager</option>
                </select>
                <small style="color: var(--gray); font-size: 0.65rem; display: block; margin-top: 5px;">
                    Note: Admin
                    accounts can only be created by existing admins
                </small>
            </div>

            <button class="btn-primary-gold mt-2" onclick="handleRegister()"
                    style="background: var(--gradient-gold); color: #000; padding: 0.6rem 1.2rem; border-radius: 50px; font-weight: 600; border: none; cursor: pointer; width: 100%;">
                Register
                Now
            </button>

            <div class="switch-form" onclick="switchToLogin()">
                Already have an account? <span>Login here</span>
            </div>
        </div>
    </div>

    <!-- Login Modal -->
    <div class="login-modal" id="loginModal">
        <div class="modal-login-glass">
            <button class="close-modal" onclick="closeLoginModal()">&times;</button>
            <div class="modal-header-custom">
                <h3>Welcome Back!</h3>
            </div>
            <div class="role-selector" id="roleSelector">
                <div class="role-btn" data-role="Admin">👑 Admin</div>
                <div class="role-btn" data-role="Manager">📊 Manager</div>
                <div class="role-btn" data-role="Staff">👨‍🏫 Staff</div>
                <div class="role-btn active" data-role="Student">🎓 Student</div>
            </div>
            <div class="input-group">
                <label>Email</label>
                <input type="email" id="loginEmail" placeholder="student@@artistic.edu.pk">
            </div>
            <div class="input-group">
                <label>Password</label>
                <input type="password" id="loginPassword" placeholder="••••••••">
            </div>
            <button class="btn-primary-gold mt-3" onclick="handleLogin()"
                    style="background: var(--gradient-gold); color: #000; padding: 0.6rem 1.2rem; border-radius: 50px; font-weight: 600; border: none; cursor: pointer; width: 100%;">
                Login
            </button>

            <div class="switch-form" onclick="switchToRegister()">
                Don't have an account? <span>Register here</span>
            </div>

            <div class="demo-creds mt-3 p-2" style="background: rgba(197,160,89,0.05); border-radius: 12px;">
                <small style="color: var(--gray);">Demo Credentials:</small>
                <p onclick="fillDemo('student@@artistic.edu.pk','student123')">
                    🎓 student@@artistic.edu.pk / student123
                </p>
                <p onclick="fillDemo('staff@@artistic.edu.pk','staff123')">👨‍🏫 staff@@artistic.edu.pk / staff123</p>
                <p onclick="fillDemo('manager@@artistic.edu.pk','manager123')">
                    📊 manager@@artistic.edu.pk / manager123
                </p>
                <p onclick="fillDemo('admin@@artistic.edu.pk','admin123')">👑 admin@@artistic.edu.pk / admin123</p>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@@2.3.1/dist/aos.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@@11"></script>
    <script src="https://cdn.jsdelivr.net/particles.js/2.0.0/particles.min.js"></script>

    <script>
        AOS.init({ duration: 1000, once: true });

        // Initialize localStorage with default users
        if (!localStorage.getItem('registeredUsers')) {
        function hashPassword(password) {
        let hash = 0;
        for (let i = 0; i < password.length; i++) {
        hash = ((hash << 5) - hash) + password.charCodeAt(i);
        hash |= 0;
        }
        return hash.toString();
        }

        const defaultUsers = {
        students: [
        { name: "Demo Student", email: "student@@artistic.edu.pk", password: "student123", program: "Bachelor of Fine Arts (BFA)" }
        ],
        staff: [
        { name: "Demo Staff", email: "staff@@artistic.edu.pk", password: "staff123", department: "Fine Arts" }
        ],
        managers: [
        { name: "Demo Manager", email: "manager@@artistic.edu.pk", password: "manager123", department: "Operations" }
        ],
        admins: [
        { name: "Super Admin", email: "admin@@artistic.edu.pk", password: hashPassword("admin123"), role: "Super Admin" }
        ]
        };
        localStorage.setItem('registeredUsers', JSON.stringify(defaultUsers));
        }

        function hashPassword(password) {
        let hash = 0;
        for (let i = 0; i < password.length; i++) {
        hash = ((hash << 5) - hash) + password.charCodeAt(i);
        hash |= 0;
        }
        return hash.toString();
        }

        // Dark/Light Mode Toggle
        const themeToggle = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');
        const body = document.body;

        if (localStorage.getItem('theme') === 'light') {
        body.classList.add('light-mode');
        themeIcon.classList.remove('fa-sun');
        themeIcon.classList.add('fa-moon');
        } else {
        themeIcon.classList.remove('fa-moon');
        themeIcon.classList.add('fa-sun');
        }

        themeToggle.addEventListener('click', () => {
        body.classList.toggle('light-mode');
        if (body.classList.contains('light-mode')) {
        localStorage.setItem('theme', 'light');
        themeIcon.classList.remove('fa-sun');
        themeIcon.classList.add('fa-moon');
        } else {
        localStorage.setItem('theme', 'dark');
        themeIcon.classList.remove('fa-moon');
        themeIcon.classList.add('fa-sun');
        }
        });

        // Particles Background
        particlesJS('particles-js', {
        particles: { number: { value: 80 }, color: { value: '#C5A059' }, opacity: { value: 0.3 }, size: { value: 3, random: true }, move: { enable: true, speed: 2 } }
        });

        // Navbar Scroll
        window.addEventListener('scroll', () => {
        document.getElementById('navbar').classList.toggle('scrolled', window.scrollY > 50);
        document.getElementById('scrollTop').classList.toggle('show', window.scrollY > 200);
        });
        document.getElementById('scrollTop').onclick = () => window.scrollTo({ top: 0, behavior: 'smooth' });

        // Animated Counter
        function animateCounter(element, target) {
        let current = 0;
        const increment = target / 50;
        const timer = setInterval(() => {
        current += increment;
        if (current >= target) { element.innerText = target; clearInterval(timer); }
        else { element.innerText = Math.floor(current); }
        }, 30);
        }
        const counterElements = document.querySelectorAll('.counter');
        let animated = false;
        function checkCounters() {
        if (animated) return;
        const statsSection = document.querySelector('.stats-section');
        if (statsSection) {
        const rect = statsSection.getBoundingClientRect();
        if (rect.top < window.innerHeight - 100) {
        counterElements.forEach(counter => { animateCounter(counter, parseInt(counter.getAttribute('data-target'))); });
        animated = true;
        }
        }
        }
        window.addEventListener('scroll', checkCounters);
        window.addEventListener('load', checkCounters);

        // Modal Functions
        let currentSelectedRole = 'Student';

        function openLoginModal() {
        document.getElementById('loginModal').classList.add('active');
        document.body.style.overflow = 'hidden';
        }

        function closeLoginModal() {
        document.getElementById('loginModal').classList.remove('active');
        document.body.style.overflow = 'auto';
        }

        function openRegisterModal() {
        document.getElementById('registerModal').classList.add('active');
        document.body.style.overflow = 'hidden';
        }

        function closeRegisterModal() {
        document.getElementById('registerModal').classList.remove('active');
        document.body.style.overflow = 'auto';
        resetRegisterForm();
        }

        function resetRegisterForm() {
        document.getElementById('regName').value = '';
        document.getElementById('regEmail').value = '';
        document.getElementById('regPassword').value = '';
        document.getElementById('regConfirmPassword').value = '';
        document.getElementById('regProgram').value = 'Bachelor of Fine Arts (BFA)';
        document.getElementById('regRole').value = 'Student';
        }

        function switchToLogin() {
        closeRegisterModal();
        openLoginModal();
        }

        function switchToRegister() {
        closeLoginModal();
        openRegisterModal();
        }

        function fillDemo(email, pass) {
        document.getElementById('loginEmail').value = email;
        document.getElementById('loginPassword').value = pass;
        }

        // Role selection in login modal
        document.querySelectorAll('.role-btn').forEach(btn => {
        btn.addEventListener('click', function () {
        document.querySelectorAll('.role-btn').forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        currentSelectedRole = this.dataset.role;
        document.getElementById('loginEmail').placeholder = currentSelectedRole.toLowerCase() + '@@artistic.edu.pk';
        });
        });

        // Registration Handler
        function handleRegister() {
        const name = document.getElementById('regName').value.trim();
        const email = document.getElementById('regEmail').value.trim();
        const password = document.getElementById('regPassword').value;
        const confirmPassword = document.getElementById('regConfirmPassword').value;
        const program = document.getElementById('regProgram').value;
        const role = document.getElementById('regRole').value;

        if (!name || !email || !password || !confirmPassword) {
        Swal.fire({ title: 'Error!', text: 'Please fill all fields', icon: 'error', confirmButtonColor: '#C5A059' });
        return;
        }

        if (password.length < 6) {
        Swal.fire({ title: 'Error!', text: 'Password must be at least 6 characters', icon: 'error', confirmButtonColor: '#C5A059' });
        return;
        }

        if (password !== confirmPassword) {
        Swal.fire({ title: 'Error!', text: 'Passwords do not match', icon: 'error', confirmButtonColor: '#C5A059' });
        return;
        }

        const users = JSON.parse(localStorage.getItem('registeredUsers'));

        const allUsers = [...users.students, ...users.staff, ...users.managers, ...users.admins];
        if (allUsers.some(user => user.email === email)) {
        Swal.fire({ title: 'Error!', text: 'Email already registered', icon: 'error', confirmButtonColor: '#C5A059' });
        return;
        }

        if (role === 'Student') {
        users.students.push({ name, email, password, program });
        } else if (role === 'Staff') {
        users.staff.push({ name, email, password, department: "Fine Arts" });
        } else if (role === 'Manager') {
        users.managers.push({ name, email, password, department: "Management" });
        }

        localStorage.setItem('registeredUsers', JSON.stringify(users));

        Swal.fire({
        title: 'Registration Successful!',
        text: `You are now registered as a ${role}. Please login.`,
        icon: 'success',
        confirmButtonColor: '#C5A059'
        }).then(() => {
        closeRegisterModal();
        openLoginModal();
        document.getElementById('loginEmail').value = email;
        document.getElementById('loginPassword').value = '';
        document.querySelectorAll('.role-btn').forEach(btn => {
        if (btn.dataset.role === role) {
        btn.click();
        }
        });
        });
        }

        // Login Handler - Admin redirects to backend/admin/dashboard.html
        function handleLogin() {
        const email = document.getElementById('loginEmail').value.trim();
        const password = document.getElementById('loginPassword').value;

        if (!email || !password) {
        Swal.fire({ title: 'Error!', text: 'Please enter email and password', icon: 'error', confirmButtonColor: '#C5A059' });
        return;
        }

        const users = JSON.parse(localStorage.getItem('registeredUsers'));
        let userFound = null;
        let role = null;

        if (currentSelectedRole === 'Student') {
        const student = users.students.find(u => u.email === email && u.password === password);
        if (student) {
        userFound = student;
        role = 'Student';
        }
        } else if (currentSelectedRole === 'Staff') {
        const staff = users.staff.find(u => u.email === email && u.password === password);
        if (staff) {
        userFound = staff;
        role = 'Staff';
        }
        } else if (currentSelectedRole === 'Manager') {
        const manager = users.managers.find(u => u.email === email && u.password === password);
        if (manager) {
        userFound = manager;
        role = 'Manager';
        }
        } else if (currentSelectedRole === 'Admin') {
        const admin = users.admins.find(u => u.email === email && u.password === hashPassword(password));
        if (admin) {
        userFound = admin;
        role = 'Admin';
        }
        }

        if (userFound) {
        localStorage.setItem('currentUser', JSON.stringify({ name: userFound.name, email, role }));

        let redirect = '';
        if (role === 'Student') redirect = 'student-dashboard.html';
        else if (role === 'Staff') redirect = 'staff-dashboard.html';
        else if (role === 'Manager') redirect = 'manager-dashboard.html';
        else if (role === 'Admin') redirect = 'backend/admin/dashboard.html';

        Swal.fire({
        title: 'Login Successful!',
        text: `Welcome ${userFound.name} to ${role} Dashboard`,
        icon: 'success',
        timer: 1500,
        showConfirmButton: false                }).then(() => {
        window.location.href = redirect;
        });
        } else {
        Swal.fire({ title: 'Error!', text: 'Invalid email or password', icon: 'error', confirmButtonColor: '#C5A059' });
        }
        }

        // Close modals on escape key
        document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
        closeLoginModal();
        closeRegisterModal();
        }
        });
    </script>
</body>

</html>