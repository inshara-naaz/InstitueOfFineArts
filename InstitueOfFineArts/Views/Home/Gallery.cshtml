    <!-- 🔥 EXHIBITION ARTWORKS - DYNAMIC FROM DATABASE 🔥 -->
    @if (ViewBag.ExhibitionListings != null && ((IEnumerable<dynamic>)ViewBag.ExhibitionListings).Any())
    {
        <div class="container mt-5">
            <h2 class="text-center mb-4" style="color: var(--primary);">🏆 Exhibition Artworks</h2>
            <div class="row g-4">
                @foreach (var listing in ViewBag.ExhibitionListings)
                {
                    var submission = listing.Submission;
                    var medal = "";
                    if (submission.Grade.ToString() == "Best")
                    {
                        medal = "🥇 Gold Medal Winner";
                    }
                    else if (submission.Grade.ToString() == "Better")
                    {
                        medal = "🥈 Silver Medal Winner";
                    }
                    else
                    {
                        medal = "🥉 Bronze Medal Winner";
                    }

                    <div class="col-md-4 col-sm-6">
                        <div class="gallery-item" data-category="exhibition"
                             onclick='openLightbox("@submission.ImageFilePath", "@submission.PaintingTitle", "@(submission.Student?.FullName ?? "Student")", "@medal", "@submission.CreativeDescription")'>
                            <img src="@submission.ImageFilePath" class="gallery-img" alt="@submission.PaintingTitle" onerror="this.src='https://placehold.co/600x400/1A1A2E/C5A059?text=Artwork'">
                            <div class="gallery-info">
                                <div class="gallery-title">@submission.PaintingTitle</div>
                                <div class="gallery-artist">@(submission.Student?.FullName ?? "Student")</div>
                                <div class="gallery-award">@medal</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
