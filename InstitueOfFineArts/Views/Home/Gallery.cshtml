@model IEnumerable<InstituteOfFineArts.Models.ExhibitionListing>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Gallery | ARTISTIC Institute of Fine Arts – Student Artwork Showcase</title>

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@@400;500;600;700;800;900&family=Poppins:wght@@300;400;500;600;700;800&display=swap"
          rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://unpkg.com/aos@@2.3.1/dist/aos.css" rel="stylesheet">

    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            /* Dark Mode Colors (Default) */
            :root {
                --primary: #C5A059;
                --primary-dark: #A8883A;
                --primary-light: #D4B87A;
                --secondary: #1A1A2E;
                --dark: #0A0A0A;
                --darker: #050505;
                --gray: #8A8A8A;
                --bg-body: var(--dark);
                --text-color: #FFFFFF;
                --card-bg: rgba(26, 26, 46, 0.95);
                --footer-bg: var(--darker);
                --navbar-bg: rgba(5, 5, 5, 0.95);
                --border-color: rgba(197, 160, 89, 0.15);
                --stats-bg: rgba(26, 26, 46, 0.9);
                --modal-bg: linear-gradient(135deg, #1A1A2E, #0A0A0A);
                --modal-text: #FFFFFF;
                --gradient-gold: linear-gradient(135deg, #C5A059 0%, #E8C87A 50%, #C5A059 100%);
                --gradient-dark: linear-gradient(135deg, #0A0A0A 0%, #1A1A2E 100%);
                --shadow-gold: 0 10px 30px rgba(197, 160, 89, 0.3);
                --transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
            }

            /* Light Mode */
            body.light-mode {
                --bg-body: #FFFFFF;
                --text-color: #1A1A1A;
                --card-bg: #FFFFFF;
                --footer-bg: #F5F5F5;
                --navbar-bg: #FFFFFF;
                --border-color: rgba(197, 160, 89, 0.25);
                --stats-bg: #FFFFFF;
                --modal-bg: #FFFFFF;
                --modal-text: #1A1A1A;
            }

            body {
                font-family: 'Poppins', sans-serif;
                background: var(--bg-body);
                color: var(--text-color);
                overflow-x: hidden;
                position: relative;
                transition: var(--transition);
            }

            ::-webkit-scrollbar {
                width: 8px;
            }

            ::-webkit-scrollbar-track {
                background: var(--secondary);
            }

            ::-webkit-scrollbar-thumb {
                background: var(--primary);
                border-radius: 10px;
            }

            /* Dark/Light Mode Toggle Button */
            .theme-toggle {
                background: rgba(197, 160, 89, 0.15);
                border: 1px solid var(--primary);
                color: var(--primary);
                width: 40px;
                height: 40px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                transition: var(--transition);
                margin-left: 0.5rem;
            }

                .theme-toggle:hover {
                    background: var(--primary);
                    color: #000;
                    transform: rotate(15deg);
                }

                .theme-toggle i {
                    font-size: 1.2rem;
                }

            /* Particle Background */
            #particles-js {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                z-index: 0;
                pointer-events: none;
            }

            .container,
            .page-header,
            .filter-buttons,
            .gallery-grid,
            footer,
            nav {
                position: relative;
                z-index: 2;
            }

            /* Navbar - Responsive */
            .navbar {
                background: var(--navbar-bg);
                backdrop-filter: blur(20px);
                padding: 1rem 2rem;
                position: fixed;
                top: 0;
                width: 100%;
                z-index: 1000;
                border-bottom: 1px solid var(--border-color);
                transition: var(--transition);
            }

            @@media (max-width: 1200px) {
                .navbar {
                    padding: 0.9rem 1.5rem;
                }
            }

            @@media (max-width: 992px) {
                .navbar {
                    padding: 0.8rem 1rem;
                }
            }

            @@media (max-width: 768px) {
                .navbar.scrolled {
                    padding: 0.5rem 1rem;
                }
            }

            .navbar.scrolled {
                padding: 0.7rem 2rem;
            }

            .logo {
                font-family: 'Playfair Display', serif;
                font-size: 1.6rem;
                font-weight: 800;
                background: var(--gradient-gold);
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent;
                text-decoration: none;
                transition: var(--transition);
            }

            @@media (max-width: 992px) {
                .logo {
                    font-size: 1.4rem;
                }
            }

            @@media (max-width: 768px) {
                .logo {
                    font-size: 1.3rem;
                }
            }

            @@media (max-width: 576px) {
                .logo {
                    font-size: 1.2rem;
                }
            }

            .logo:hover {
                transform: scale(1.05);
                letter-spacing: 2px;
            }

            .navbar-toggler {
                border-color: var(--primary);
            }

            .nav-link {
                color: var(--text-color) !important;
                opacity: 0.8;
                font-weight: 500;
                transition: var(--transition);
                position: relative;
            }

            @@media (max-width: 992px) {
                .nav-link {
                    padding: 0.5rem 0;
                    text-align: center;
                }
            }

            .nav-link::after {
                content: '';
                position: absolute;
                bottom: -5px;
                left: 0;
                width: 0;
                height: 2px;
                background: var(--gradient-gold);
                transition: var(--transition);
            }

            @@media (max-width: 992px) {
                .nav-link::after {
                    display: none;
                }
            }

            .nav-link:hover::after {
                width: 100%;
            }

            .nav-link:hover {
                color: var(--primary) !important;
                opacity: 1;
                transform: translateY(-2px);
            }

            .btn-nav {
                background: transparent;
                border: 1.5px solid var(--primary);
                color: var(--primary);
                padding: 0.4rem 1.2rem;
                border-radius: 50px;
                text-decoration: none;
                transition: var(--transition);
                font-size: 0.85rem;
                cursor: pointer;
                display: inline-block;
            }

            @@media (max-width: 992px) {
                .btn-nav {
                    padding: 0.3rem 1rem;
                    font-size: 0.75rem;
                    margin: 0.2rem 0;
                    text-align: center;
                }
            }

            @@media (max-width: 576px) {
                .btn-nav {
                    padding: 0.25rem 0.8rem;
                    font-size: 0.7rem;
                }
            }

            .btn-nav:hover {
                background: var(--primary);
                color: #000;
                transform: translateY(-2px);
                box-shadow: var(--shadow-gold);
            }

            .btn-register {
                background: var(--gradient-gold);
                color: #000;
                border: none;
            }

            /* Page Header - Responsive */
            .page-header {
                padding: 140px 0 60px;
                background: var(--gradient-dark);
                text-align: center;
                position: relative;
                overflow: hidden;
                z-index: 2;
            }

            @@media (max-width: 1200px) {
                .page-header {
                    padding: 130px 0 55px;
                }
            }

            @@media (max-width: 992px) {
                .page-header {
                    padding: 120px 0 50px;
                }
            }

            @@media (max-width: 768px) {
                .page-header {
                    padding: 110px 0 45px;
                }
            }

            @@media (max-width: 576px) {
                .page-header {
                    padding: 100px 0 40px;
                }
            }

            .page-header::before {
                content: '';
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: radial-gradient(circle, rgba(197, 160, 89, 0.05), transparent);
                animation: rotateBg 20s linear infinite;
                z-index: -1;
            }

            @@keyframes rotateBg {
                from {
                    transform: rotate(0deg);
                }

                to {
                    transform: rotate(360deg);
                }
            }

            .page-header h1 {
                font-size: clamp(1.8rem, 5vw, 4rem);
                font-weight: 800;
                animation: fadeInDown 0.8s ease;
                color: #FFFFFF;
            }

            body.light-mode .page-header h1 {
                color: #FFFFFF;
            }

            @@keyframes fadeInDown {
                from {
                    opacity: 0;
                    transform: translateY(-50px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .page-header p {
                color: rgba(255, 255, 255, 0.8);
                animation: fadeInUp 0.8s ease 0.2s both;
                font-size: clamp(0.85rem, 3vw, 1.1rem);
            }

            body.light-mode .page-header p {
                color: rgba(255, 255, 255, 0.7);
            }

            @@keyframes fadeInUp {
                from {
                    opacity: 0;
                    transform: translateY(30px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            /* Stats Bar - Responsive */
            .stats-bar {
                background: var(--stats-bg);
                backdrop-filter: blur(10px);
                border-radius: 20px;
                padding: 2rem;
                margin: -30px auto 3rem;
                position: relative;
                z-index: 3;
                max-width: 900px;
                border: 1px solid var(--border-color);
                animation: slideInUp 0.8s ease 0.4s both;
            }

            @@media (max-width: 1200px) {
                .stats-bar {
                    max-width: 850px;
                    padding: 1.8rem;
                }
            }

            @@media (max-width: 992px) {
                .stats-bar {
                    max-width: 750px;
                    margin: -35px 1.5rem 2.5rem;
                    padding: 1.5rem;
                }
            }

            @@media (max-width: 768px) {
                .stats-bar {
                    margin: -30px 1rem 2rem;
                    padding: 1.2rem;
                }
            }

            @@media (max-width: 576px) {
                .stats-bar {
                    margin: -25px 0.8rem 1.5rem;
                    padding: 1rem;
                    border-radius: 15px;
                }
            }

            @@keyframes slideInUp {
                from {
                    opacity: 0;
                    transform: translateY(50px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .stat-item {
                text-align: center;
                transition: var(--transition);
            }

                .stat-item:hover {
                    transform: translateY(-5px);
                }

            .stat-number {
                font-size: clamp(1.2rem, 4vw, 2rem);
                font-weight: 800;
                color: var(--primary);
                font-family: 'Playfair Display', serif;
            }

            .stat-label {
                font-size: clamp(0.6rem, 2.5vw, 0.75rem);
                color: var(--gray);
                letter-spacing: 1px;
            }

            /* Gallery Filters - Responsive */
            .filter-buttons {
                display: flex;
                flex-wrap: wrap;
                justify-content: center;
                gap: 0.8rem;
                margin-bottom: 2rem;
                position: relative;
                z-index: 2;
            }

            @@media (max-width: 992px) {
                .filter-buttons {
                    gap: 0.7rem;
                    margin-bottom: 1.8rem;
                }
            }

            @@media (max-width: 768px) {
                .filter-buttons {
                    gap: 0.6rem;
                    margin-bottom: 1.5rem;
                }
            }

            @@media (max-width: 576px) {
                .filter-buttons {
                    gap: 0.5rem;
                }
            }

            .filter-btn {
                background: rgba(197, 160, 89, 0.15);
                border: 1px solid var(--border-color);
                color: var(--gray);
                padding: 0.6rem 1.5rem;
                border-radius: 50px;
                transition: var(--transition);
                cursor: pointer;
                font-weight: 500;
                font-size: clamp(0.7rem, 3vw, 0.85rem);
            }

            @@media (max-width: 992px) {
                .filter-btn {
                    padding: 0.5rem 1.2rem;
                }
            }

            @@media (max-width: 768px) {
                .filter-btn {
                    padding: 0.4rem 1rem;
                }
            }

            @@media (max-width: 576px) {
                .filter-btn {
                    padding: 0.35rem 0.8rem;
                }
            }

            @@media (max-width: 400px) {
                .filter-btn {
                    padding: 0.3rem 0.6rem;
                }
            }

            .filter-btn:hover,
            .filter-btn.active {
                background: var(--primary);
                color: #000;
                border-color: var(--primary);
                transform: translateY(-2px);
                box-shadow: var(--shadow-gold);
            }

            /* Gallery Grid - Responsive */
            .gallery-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
                gap: 1.8rem;
                position: relative;
                z-index: 2;
            }

            @@media (max-width: 1200px) {
                .gallery-grid {
                    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
                    gap: 1.5rem;
                }
            }

            @@media (max-width: 992px) {
                .gallery-grid {
                    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
                    gap: 1.3rem;
                }
            }

            @@media (max-width: 768px) {
                .gallery-grid {
                    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
                    gap: 1rem;
                }
            }

            @@media (max-width: 576px) {
                .gallery-grid {
                    grid-template-columns: 1fr;
                    gap: 1rem;
                }
            }

            .gallery-item {
                background: var(--card-bg);
                backdrop-filter: blur(10px);
                border-radius: 20px;
                overflow: hidden;
                transition: var(--transition);
                cursor: pointer;
                animation: scaleIn 0.5s ease backwards;
                border: 1px solid var(--border-color);
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            }

            @@keyframes scaleIn {
                from {
                    opacity: 0;
                    transform: scale(0.9);
                }

                to {
                    opacity: 1;
                    transform: scale(1);
                }
            }

            .gallery-item:hover {
                transform: translateY(-12px);
                border-color: var(--primary);
                box-shadow: 0 25px 50px rgba(197, 160, 89, 0.2);
            }

            @@media (max-width: 768px) {
                .gallery-item:hover {
                    transform: translateY(-8px);
                }
            }

            .gallery-img {
                width: 100%;
                height: 280px;
                object-fit: cover;
                transition: transform 0.6s ease;
            }

            @@media (max-width: 1200px) {
                .gallery-img {
                    height: 260px;
                }
            }

            @@media (max-width: 992px) {
                .gallery-img {
                    height: 240px;
                }
            }

            @@media (max-width: 768px) {
                .gallery-img {
                    height: 220px;
                }
            }

            @@media (max-width: 576px) {
                .gallery-img {
                    height: 250px;
                }
            }

            .gallery-item:hover .gallery-img {
                transform: scale(1.08);
            }

            .gallery-info {
                padding: 1.2rem;
                background: var(--card-bg);
            }

            @@media (max-width: 768px) {
                .gallery-info {
                    padding: 1rem;
                }
            }

            .gallery-title {
                font-family: 'Playfair Display', serif;
                font-size: clamp(1rem, 3.5vw, 1.2rem);
                font-weight: 700;
                margin-bottom: 0.3rem;
                color: var(--text-color);
            }

            .gallery-artist {
                font-size: clamp(0.75rem, 3vw, 0.85rem);
                color: var(--primary);
                font-weight: 500;
            }

            .gallery-award {
                font-size: clamp(0.7rem, 2.5vw, 0.75rem);
                color: var(--gray);
                margin-top: 0.5rem;
                padding-top: 0.5rem;
                border-top: 1px solid var(--border-color);
            }

            /* CTA Banner - Responsive */
            .cta-banner {
                background: linear-gradient(135deg, rgba(197, 160, 89, 0.1), var(--card-bg));
                border-radius: 30px;
                padding: 3rem;
                text-align: center;
                border: 1px solid var(--border-color);
                margin-top: 3rem;
                position: relative;
                overflow: hidden;
            }

            @@media (max-width: 992px) {
                .cta-banner {
                    padding: 2rem;
                    margin-top: 2.5rem;
                }
            }

            @@media (max-width: 768px) {
                .cta-banner {
                    padding: 1.5rem;
                    margin-top: 2rem;
                    border-radius: 25px;
                }
            }

            @@media (max-width: 576px) {
                .cta-banner {
                    padding: 1.2rem;
                    border-radius: 20px;
                }
            }

            body.light-mode .cta-banner {
                background: linear-gradient(135deg, #F5F0E6, #E8E0D0);
            }

            .cta-banner h3 {
                font-size: clamp(1.2rem, 4vw, 1.8rem);
                margin-bottom: 1rem;
                color: var(--text-color);
            }

            .cta-banner p {
                color: var(--gray);
                font-size: clamp(0.8rem, 3vw, 0.9rem);
            }

            .btn-primary-gold {
                background: var(--gradient-gold);
                color: #000;
                padding: 0.8rem 2rem;
                border-radius: 50px;
                font-weight: 600;
                border: none;
                transition: var(--transition);
                cursor: pointer;
            }

            @@media (max-width: 768px) {
                .btn-primary-gold {
                    padding: 0.6rem 1.5rem;
                    font-size: 0.85rem;
                }
            }

            @@media (max-width: 576px) {
                .btn-primary-gold {
                    padding: 0.5rem 1.2rem;
                    font-size: 0.8rem;
                }
            }

            .btn-primary-gold:hover {
                transform: translateY(-2px);
                box-shadow: var(--shadow-gold);
            }

            /* Lightbox Modal - Responsive */
            .lightbox-modal {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.95);
                z-index: 3000;
                align-items: center;
                justify-content: center;
            }

                .lightbox-modal.active {
                    display: flex;
                }

            .lightbox-content {
                text-align: center;
                max-width: 90%;
                max-height: 90%;
            }

            .lightbox-img {
                max-width: 100%;
                max-height: 70vh;
                border-radius: 20px;
                border: 3px solid var(--primary);
                box-shadow: 0 0 50px rgba(197, 160, 89, 0.3);
                object-fit: contain;
            }

            @@media (max-width: 768px) {
                .lightbox-img {
                    max-height: 60vh;
                    border-radius: 15px;
                }
            }

            .lightbox-close {
                position: absolute;
                top: 20px;
                right: 40px;
                font-size: 3rem;
                color: white;
                cursor: pointer;
                transition: var(--transition);
                z-index: 3001;
            }

            @@media (max-width: 768px) {
                .lightbox-close {
                    top: 10px;
                    right: 20px;
                    font-size: 2rem;
                }
            }

            .lightbox-close:hover {
                color: var(--primary);
                transform: rotate(90deg);
            }

            .lightbox-caption {
                text-align: center;
                margin-top: 1rem;
                color: white;
                font-size: clamp(0.8rem, 3vw, 1rem);
                background: rgba(0, 0, 0, 0.7);
                padding: 1rem;
                border-radius: 15px;
                display: inline-block;
                max-width: 90%;
            }

                .lightbox-caption strong {
                    color: var(--primary);
                    font-size: clamp(1rem, 4vw, 1.3rem);
                }

            /* Login/Register Modal Styles */
            .login-modal,
            .register-modal {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.96);
                backdrop-filter: blur(20px);
                z-index: 2000;
                align-items: center;
                justify-content: center;
            }

                .login-modal.active,
                .register-modal.active {
                    display: flex;
                    animation: fadeInModal 0.3s ease;
                }

            @@keyframes fadeInModal {
                from {
                    opacity: 0;
                }

                to {
                    opacity: 1;
                }
            }

            .modal-login-glass,
            .modal-register-glass {
                background: var(--modal-bg);
                border-radius: 28px;
                max-width: 450px;
                width: 90%;
                padding: 2rem 1.5rem 1.5rem 1.5rem;
                border: 1px solid rgba(197, 160, 89, 0.25);
                animation: modalPop 0.4s cubic-bezier(0.34, 1.2, 0.64, 1);
                max-height: 90vh;
                overflow-y: auto;
                position: relative;
            }

            @@media (max-width: 576px) {
                .modal-login-glass,
                .modal-register-glass {
                    padding: 1.8rem 1rem 1rem 1rem;
                    max-width: 95%;
                    border-radius: 20px;
                }
            }

            @@keyframes modalPop {
                from {
                    opacity: 0;
                    transform: scale(0.9) translateY(-40px);
                }

                to {
                    opacity: 1;
                    transform: scale(1) translateY(0);
                }
            }

            .close-modal {
                position: absolute;
                top: 15px;
                right: 20px;
                font-size: 1.5rem;
                cursor: pointer;
                color: var(--gray);
                transition: var(--transition);
                background: none;
                border: none;
            }

                .close-modal:hover {
                    color: var(--primary);
                    transform: rotate(90deg);
                }

            .modal-header-custom {
                text-align: center;
                margin-bottom: 1.5rem;
            }

                .modal-header-custom h3 {
                    font-size: clamp(1.2rem, 4vw, 1.5rem);
                    font-weight: 700;
                    color: var(--modal-text);
                }

                .modal-header-custom p {
                    color: var(--gray);
                    font-size: 0.8rem;
                }

            .role-selector {
                display: flex;
                gap: 0.5rem;
                flex-wrap: wrap;
                justify-content: center;
                margin-bottom: 1.5rem;
            }

            .role-btn {
                background: rgba(197, 160, 89, 0.1);
                border: 1px solid var(--border-color);
                padding: 0.4rem 0.8rem;
                border-radius: 50px;
                cursor: pointer;
                font-size: 0.75rem;
                color: var(--modal-text);
                transition: var(--transition);
            }

                .role-btn.active {
                    background: var(--primary);
                    color: #000;
                }

                .role-btn:hover {
                    background: var(--primary);
                    color: #000;
                }

            .input-group {
                margin-bottom: 1rem;
            }

                .input-group label {
                    font-size: 0.75rem;
                    margin-bottom: 0.3rem;
                    display: block;
                    color: var(--gray);
                }

                .input-group input,
                .input-group select {
                    width: 100%;
                    padding: 0.7rem;
                    background: rgba(197, 160, 89, 0.05);
                    border: 1px solid var(--border-color);
                    border-radius: 10px;
                    color: var(--modal-text);
                    font-size: 0.85rem;
                }

                .input-group select {
                    appearance: auto;
                    -webkit-appearance: menulist;
                    -moz-appearance: menulist;
                    cursor: pointer;
                }

                    .input-group select option {
                        background: var(--card-bg);
                        color: var(--modal-text);
                    }

            body.light-mode .input-group select option {
                background: #ffffff;
                color: #1a1a1a;
            }

            .switch-form {
                text-align: center;
                margin-top: 1rem;
                font-size: 0.8rem;
                cursor: pointer;
                color: var(--gray);
            }

                .switch-form span {
                    color: var(--primary);
                }

            .demo-creds p {
                font-size: 0.7rem;
                margin-bottom: 0.3rem;
                cursor: pointer;
                color: var(--primary);
            }

                .demo-creds p:hover {
                    text-decoration: underline;
                }

            /* Footer - Responsive */
            .footer {
                background: var(--footer-bg);
                padding: 4rem 0 2rem;
                margin-top: 4rem;
                border-top: 1px solid var(--border-color);
            }

            @@media (max-width: 992px) {
                .footer {
                    padding: 3rem 0 1.5rem;
                    margin-top: 3rem;
                }
            }

            @@media (max-width: 768px) {
                .footer {
                    padding: 2rem 0 1.2rem;
                    margin-top: 2rem;
                    text-align: center;
                }
            }

            .footer-logo {
                font-family: 'Playfair Display', serif;
                font-size: clamp(1.3rem, 4vw, 1.8rem);
                font-weight: 800;
                background: var(--gradient-gold);
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent;
            }

            .footer-links {
                list-style: none;
                padding: 0;
            }

                .footer-links li {
                    margin-bottom: 0.8rem;
                }

            @@media (max-width: 768px) {
                .footer-links li {
                    margin-bottom: 0.5rem;
                }
            }

            .footer-links a {
                color: var(--gray);
                text-decoration: none;
                transition: var(--transition);
                font-size: clamp(0.8rem, 3vw, 0.85rem);
            }

                .footer-links a:hover {
                    color: var(--primary);
                    padding-left: 5px;
                }

            .social-icons {
                display: flex;
                gap: 1rem;
                margin-top: 1rem;
            }

            @@media (max-width: 768px) {
                .social-icons {
                    justify-content: center;
                }
            }

            .social-icon {
                width: 40px;
                height: 40px;
                background: rgba(197, 160, 89, 0.1);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                color: var(--primary);
                transition: var(--transition);
            }

            @@media (max-width: 768px) {
                .social-icon {
                    width: 35px;
                    height: 35px;
                }
            }

            .social-icon:hover {
                background: var(--primary);
                color: #000;
                transform: translateY(-5px) rotate(360deg);
            }

            /* Scroll Top - Responsive */
            .scroll-top {
                position: fixed;
                bottom: 30px;
                right: 30px;
                width: 50px;
                height: 50px;
                background: var(--gradient-gold);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #000;
                cursor: pointer;
                opacity: 0;
                visibility: hidden;
                transition: var(--transition);
                border: none;
                z-index: 999;
            }

            @@media (max-width: 768px) {
                .scroll-top {
                    width: 40px;
                    height: 40px;
                    bottom: 20px;
                    right: 20px;
                }
            }

            @@media (max-width: 576px) {
                .scroll-top {
                    width: 35px;
                    height: 35px;
                }
            }

            .scroll-top.show {
                opacity: 1;
                visibility: visible;
            }

            .scroll-top:hover {
                transform: translateY(-5px);
            }
    </style>
</head>

