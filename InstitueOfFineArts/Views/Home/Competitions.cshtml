    <section class="py-4">
        <div class="container">
            <div class="row g-4" id="competitionsGrid">
                @if (Model != null && Model.Any())
                {
                    @foreach (var comp in Model)
                    {
                        var statusText = comp.Status == CompetitionStatus.Ongoing ? "ongoing" : "upcoming";
                        var statusBadge = comp.Status == CompetitionStatus.Ongoing ? "🔥 ONGOING" : "📅 UPCOMING";
                        var randomRegistered = new Random().Next(5, 50);
                        var randomPercent = comp.Status == CompetitionStatus.Ongoing ? new Random().Next(30, 90) : new Random().Next(0, 30);

                        <div class="col-md-4 competition-item" data-category="@statusText">
                            <div class="competition-card"
                                 onclick='openCompetitionModal(
                         "@comp.Title.Replace("\"", "\\\"")",
                         "@(comp.Status == CompetitionStatus.Ongoing ? "ongoing" : "upcoming")",
                         "@comp.Description?.Replace("\"", "\\\"")",
                         "@comp.Conditions?.Replace("\"", "\\\"")",
                         "@comp.EndDate.ToString("MMM dd, yyyy")",
                         "@comp.Description?.Replace("\"", "\\\"")",
                         "@randomRegistered"
                     )'>
                                <div class="card-img-wrapper">
                                    @if (!string.IsNullOrEmpty(comp.ImagePath))
                                    {
                                        <img src="@comp.ImagePath" class="card-img" alt="@comp.Title">
                                    }
                                    else
                                    {
                                        <img src="https://images.pexels.com/photos/102127/pexels-photo-102127.jpeg?w=400" class="card-img" alt="Competition">
                                    }
                                    <span class="card-badge">@statusBadge</span>
                                </div>
                                <div class="card-body">
                                    <h3 class="card-title">@comp.Title</h3>
                                    <div class="card-meta">
                                        <span><i class="far fa-calendar"></i> @comp.StartDate.ToString("MMM dd, yyyy") - @comp.EndDate.ToString("MMM dd, yyyy")</span>
                                        <span><i class="fas fa-users"></i> @randomRegistered Registered</span>
                                    </div>
                                    <div class="card-prize">🏆 @(string.IsNullOrEmpty(comp.Conditions) ? "PKR 0 + Medal" : comp.Conditions)</div>
                                    <div class="progress-bar-custom">
                                        <div class="progress-fill" style="width: @randomPercent%;"></div>
                                    </div>
                                    <div class="progress-info">
                                        <span class="progress-percent">@randomPercent% Registered</span>
                                        <span class="progress-slots">@(50 - randomRegistered) Slots Left</span>
                                    </div>
                                    <button class="btn-view-details">View Details</button>
                                </div>
                            </div>
                        </div>
                    }
