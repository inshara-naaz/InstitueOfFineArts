@model IEnumerable<InstituteOfFineArts.Models.Exhibition>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
<title>Exhibitions | ARTISTIC Institute of Fine Arts – Showcase Your Art</title>

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@@400;500;600;700;800;900&family=Poppins:wght@@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://unpkg.com/aos@@2.3.1/dist/aos.css" rel="stylesheet">

<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

/* Dark Mode Colors (Default) */
:root {
    --primary: #C5A059;
    --primary-dark: #A8883A;
    --primary-light: #D4B87A;
    --secondary: #1A1A2E;
    --dark: #0A0A0A;
    --darker: #050505;
    --gray: #8A8A8A;
    --bg-body: var(--dark);
    --text-color: #FFFFFF;
    --card-bg: rgba(26, 26, 46, 0.85);
    --footer-bg: var(--darker);
    --navbar-bg: rgba(5, 5, 5, 0.95);
    --border-color: rgba(197, 160, 89, 0.15);
    --stats-bg: rgba(26, 26, 46, 0.9);
    --modal-bg: linear-gradient(135deg, #1A1A2E, #0A0A0A);
    --modal-text: #FFFFFF;
    --gradient-gold: linear-gradient(135deg, #C5A059 0%, #E8C87A 50%, #C5A059 100%);
    --gradient-dark: linear-gradient(135deg, #0A0A0A 0%, #1A1A2E 100%);
    --shadow-gold: 0 10px 30px rgba(197, 160, 89, 0.3);
    --shadow-gold-lg: 0 20px 40px rgba(197, 160, 89, 0.2);
    --transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
}

/* Light Mode */
body.light-mode {
    --bg-body: #F5F5F5;
    --text-color: #1A1A1A;
    --card-bg: #FFFFFF;
    --footer-bg: #E8E8E8;
    --navbar-bg: #FFFFFF;
    --border-color: rgba(197, 160, 89, 0.25);
    --stats-bg: #FFFFFF;
    --modal-bg: #FFFFFF;
    --modal-text: #1A1A1A;
}

body {
    font-family: 'Poppins', sans-serif;
    background: var(--bg-body);
    color: var(--text-color);
    overflow-x: hidden;
    transition: var(--transition);
}

::-webkit-scrollbar { width: 8px; }
::-webkit-scrollbar-track { background: var(--secondary); }
::-webkit-scrollbar-thumb { background: var(--primary); border-radius: 10px; }

/* Dark/Light Mode Toggle Button */
.theme-toggle {
    background: rgba(197, 160, 89, 0.15);
    border: 1px solid var(--primary);
    color: var(--primary);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition);
    margin-left: 0.5rem;
}
.theme-toggle:hover {
    background: var(--primary);
    color: #000;
    transform: rotate(15deg);
}
.theme-toggle i { font-size: 1.2rem; }

#particles-js { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
.container, .page-header, .stats-bar, .countdown-section, .category-filters, .exhibition-card, .price-guide, .past-exhibition-card, .testimonial-card, .cta-banner, footer, nav { position: relative; z-index: 2; }

/* Navbar - Fully Responsive */
.navbar { background: var(--navbar-bg); backdrop-filter: blur(20px); padding: 1rem 2rem; position: fixed; top: 0; width: 100%; z-index: 1000; border-bottom: 1px solid var(--border-color); transition: var(--transition); }
.navbar.scrolled { padding: 0.7rem 2rem; }
@@media (max-width: 1200px) { .navbar { padding: 0.9rem 1.5rem; } }
@@media (max-width: 991px) { .navbar { padding: 0.8rem 1rem; } }
@@media (max-width: 768px) { .navbar.scrolled { padding: 0.5rem 1rem; } }

.logo { font-family: 'Playfair Display', serif; font-size: 1.6rem; font-weight: 800; background: var(--gradient-gold); -webkit-background-clip: text; background-clip: text; color: transparent; text-decoration: none; transition: var(--transition); }
@@media (max-width: 992px) { .logo { font-size: 1.4rem; } }
@@media (max-width: 768px) { .logo { font-size: 1.3rem; } }
@@media (max-width: 576px) { .logo { font-size: 1.2rem; } }
.logo:hover { transform: scale(1.05); letter-spacing: 2px; }

.navbar-toggler { border-color: var(--primary); }
.navbar-toggler-icon { filter: invert(0.5); }

.nav-link { color: var(--text-color) !important; opacity: 0.8; font-weight: 500; transition: var(--transition); position: relative; padding: 0.5rem 1rem; }
@@media (max-width: 991px) { .nav-link { padding: 0.5rem 0; text-align: center; } }
.nav-link::after { content: ''; position: absolute; bottom: -5px; left: 0; width: 0; height: 2px; background: var(--gradient-gold); transition: var(--transition); }
@@media (max-width: 991px) { .nav-link::after { display: none; } }
.nav-link:hover::after { width: 100%; }
.nav-link:hover { color: var(--primary) !important; opacity: 1; transform: translateY(-2px); }

.btn-nav { background: transparent; border: 1.5px solid var(--primary); color: var(--primary); padding: 0.4rem 1.2rem; border-radius: 50px; text-decoration: none; transition: var(--transition); font-size: 0.85rem; cursor: pointer; display: inline-block; }
@@media (max-width: 991px) { .btn-nav { padding: 0.3rem 1rem; font-size: 0.75rem; margin: 0.2rem 0; display: inline-block; width: auto; text-align: center; } }
@@media (max-width: 576px) { .btn-nav { padding: 0.25rem 0.8rem; font-size: 0.7rem; } }
.btn-nav:hover { background: var(--primary); color: #000; transform: translateY(-2px); box-shadow: var(--shadow-gold); }
.btn-register { background: var(--gradient-gold); color: #000; border: none; }

/* Page Header */
.page-header { padding: 140px 0 80px; background: var(--gradient-dark); position: relative; overflow: hidden; text-align: center; z-index: 1; }
@@media (max-width: 1200px) { .page-header { padding: 130px 0 70px; } }
@@media (max-width: 992px) { .page-header { padding: 120px 0 60px; } }
@@media (max-width: 768px) { .page-header { padding: 110px 0 50px; } }
@@media (max-width: 576px) { .page-header { padding: 100px 0 40px; } }
.page-header::before { content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%; background: radial-gradient(circle, rgba(197,160,89,0.08), transparent); animation: rotateBg 20s linear infinite; z-index: -1; }
@@keyframes rotateBg { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
.page-header h1 { font-size: clamp(1.8rem, 5vw, 4rem); font-weight: 800; animation: fadeInDown 0.8s ease; color: #FFFFFF; }
@@keyframes fadeInDown { from { opacity: 0; transform: translateY(-50px); } to { opacity: 1; transform: translateY(0); } }
.page-header p { color: rgba(255,255,255,0.8); animation: fadeInUp 0.8s ease 0.2s both; font-size: clamp(0.85rem, 3vw, 1.1rem); max-width: 90%; margin: 0 auto; }

/* Stats Bar */
.stats-bar { background: var(--stats-bg); backdrop-filter: blur(10px); border-radius: 20px; padding: 2rem; margin: -40px auto 3rem; position: relative; z-index: 2; max-width: 900px; border: 1px solid var(--border-color); animation: slideInUp 0.8s ease 0.4s both; }
@@media (max-width: 1200px) { .stats-bar { max-width: 850px; padding: 1.8rem; } }
@@media (max-width: 992px) { .stats-bar { max-width: 750px; margin: -35px 1.5rem 2.5rem; padding: 1.5rem; } }
@@media (max-width: 768px) { .stats-bar { margin: -30px 1rem 2rem; padding: 1.2rem; } }
@@media (max-width: 576px) { .stats-bar { margin: -25px 0.8rem 1.5rem; padding: 1rem; border-radius: 15px; } }
@@keyframes slideInUp { from { opacity: 0; transform: translateY(50px); } to { opacity: 1; transform: translateY(0); } }

.stat-item { text-align: center; transition: var(--transition); }
.stat-item:hover { transform: translateY(-5px); }
.stat-number { font-size: clamp(1.2rem, 4vw, 2rem); font-weight: 800; color: var(--primary); font-family: 'Playfair Display', serif; }
.stat-label { font-size: clamp(0.6rem, 2.5vw, 0.75rem); color: var(--gray); letter-spacing: 1px; }

/* Countdown Timer */
.countdown-section { background: var(--card-bg); backdrop-filter: blur(10px); border-radius: 30px; padding: 2rem; margin-bottom: 3rem; border: 1px solid var(--border-color); }
@@media (max-width: 992px) { .countdown-section { padding: 1.8rem; margin-bottom: 2.5rem; } }
@@media (max-width: 768px) { .countdown-section { padding: 1.5rem; margin-bottom: 2rem; border-radius: 25px; } }
@@media (max-width: 576px) { .countdown-section { padding: 1.2rem; margin-bottom: 1.5rem; border-radius: 20px; } }
.countdown-title { font-family: 'Playfair Display', serif; font-size: clamp(1.2rem, 4vw, 1.8rem); margin-bottom: 1rem; color: var(--text-color); }
.timer-box { background: rgba(197,160,89,0.15); border-radius: 15px; padding: 1rem; min-width: 80px; transition: var(--transition); }
@@media (max-width: 768px) { .timer-box { padding: 0.7rem; min-width: 65px; } }
@@media (max-width: 576px) { .timer-box { padding: 0.5rem; min-width: 55px; border-radius: 12px; } }
@@media (max-width: 400px) { .timer-box { min-width: 45px; padding: 0.4rem; } }
.timer-box:hover { transform: translateY(-5px); background: rgba(197,160,89,0.3); }
.timer-number { font-size: clamp(1rem, 4vw, 2.5rem); font-weight: 800; color: var(--primary); font-family: 'Playfair Display', serif; }
@@media (max-width: 576px) { .timer-number { font-size: 1rem; } }
.timer-label { font-size: clamp(0.5rem, 2.5vw, 0.7rem); color: var(--gray); text-transform: uppercase; letter-spacing: 2px; }
@@media (max-width: 576px) { .timer-label { font-size: 0.5rem; letter-spacing: 1px; } }

/* Exhibition Cards */
.exhibition-card { background: var(--card-bg); backdrop-filter: blur(10px); border-radius: 20px; overflow: hidden; transition: var(--transition); border: 1px solid var(--border-color); height: 100%; cursor: pointer; animation: scaleIn 0.5s ease backwards; }
@@keyframes scaleIn { from { opacity: 0; transform: scale(0.9); } to { opacity: 1; transform: scale(1); } }
.exhibition-card:hover { transform: translateY(-15px) scale(1.02); border-color: var(--primary); box-shadow: var(--shadow-gold-lg); }
@@media (max-width: 768px) { .exhibition-card:hover { transform: translateY(-8px) scale(1.01); } }

.card-img-wrapper { height: 220px; overflow: hidden; position: relative; }
@@media (max-width: 1200px) { .card-img-wrapper { height: 200px; } }
@@media (max-width: 992px) { .card-img-wrapper { height: 190px; } }
@@media (max-width: 768px) { .card-img-wrapper { height: 180px; } }
@@media (max-width: 576px) { .card-img-wrapper { height: 170px; } }

.card-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s ease; }
.exhibition-card:hover .card-img { transform: scale(1.15); }

.card-badge { position: absolute; top: 15px; right: 15px; background: var(--gradient-gold); color: #000; padding: 0.3rem 1rem; border-radius: 50px; font-size: 0.7rem; font-weight: 700; animation: pulse 2s infinite; }
@@media (max-width: 576px) { .card-badge { top: 10px; right: 10px; padding: 0.2rem 0.7rem; font-size: 0.6rem; } }
@@keyframes pulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(197,160,89,0.4); } 50% { box-shadow: 0 0 0 10px rgba(197,160,89,0); } }

.card-body { padding: 1.5rem; }
@@media (max-width: 992px) { .card-body { padding: 1.2rem; } }
@@media (max-width: 768px) { .card-body { padding: 1rem; } }

.card-title { font-family: 'Playfair Display', serif; font-size: clamp(1rem, 3.5vw, 1.3rem); font-weight: 700; color: var(--text-color); margin-bottom: 0.5rem; }
.card-meta { display: flex; gap: 1rem; font-size: 0.75rem; color: var(--gray); margin: 0.5rem 0; flex-wrap: wrap; }
@@media (max-width: 576px) { .card-meta { gap: 0.5rem; font-size: 0.65rem; } }
.sold-info { background: rgba(197,160,89,0.1); border-radius: 10px; padding: 0.5rem; margin: 0.5rem 0; font-size: 0.75rem; color: var(--gray); }
@@media (max-width: 576px) { .sold-info { font-size: 0.65rem; } }

/* Category Filters */
.category-filters { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.8rem; margin-bottom: 2rem; }
@@media (max-width: 992px) { .category-filters { gap: 0.7rem; margin-bottom: 1.8rem; } }
@@media (max-width: 768px) { .category-filters { gap: 0.6rem; margin-bottom: 1.5rem; } }
@@media (max-width: 576px) { .category-filters { gap: 0.5rem; } }
.cat-btn { background: rgba(197,160,89,0.1); border: 1px solid var(--border-color); color: var(--gray); padding: 0.5rem 1.5rem; border-radius: 50px; transition: var(--transition); cursor: pointer; font-size: 0.85rem; }
@@media (max-width: 992px) { .cat-btn { padding: 0.45rem 1.3rem; font-size: 0.8rem; } }
@@media (max-width: 768px) { .cat-btn { padding: 0.4rem 1rem; font-size: 0.75rem; } }
@@media (max-width: 576px) { .cat-btn { padding: 0.35rem 0.8rem; font-size: 0.7rem; } }
@@media (max-width: 400px) { .cat-btn { padding: 0.3rem 0.6rem; font-size: 0.65rem; } }
.cat-btn:hover, .cat-btn.active { background: var(--primary); color: #000; border-color: var(--primary); transform: translateY(-2px); }

/* View Details Button */
.btn-view-details {
    background: linear-gradient(135deg, rgba(197,160,89,0.1), rgba(197,160,89,0.05));
    border: 2px solid var(--primary);
    color: var(--primary);
    padding: 0.5rem 1rem;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 600;
    transition: var(--transition);
    cursor: pointer;
    width: auto;
    min-width: 130px;
    display: inline-block;
}
@@media (max-width: 992px) { .btn-view-details { min-width: 120px; font-size: 0.72rem; } }
@@media (max-width: 768px) { .btn-view-details { min-width: 110px; font-size: 0.7rem; padding: 0.4rem 0.8rem; } }
@@media (max-width: 576px) { .btn-view-details { min-width: 100%; font-size: 0.68rem; } }
.btn-view-details:hover {
    background: var(--primary);
    color: #000;
    transform: translateY(-2px);
}

/* Past Exhibitions */
.past-exhibition-card { background: var(--card-bg); border-radius: 20px; overflow: hidden; transition: var(--transition); border: 1px solid var(--border-color); height: 100%; }
.past-exhibition-card:hover { transform: translateY(-8px); border-color: var(--primary); }
.sold-sticker { position: absolute; bottom: 15px; right: 15px; background: var(--primary); color: #000; padding: 0.2rem 0.8rem; border-radius: 20px; font-size: 0.7rem; font-weight: 600; z-index: 1; }
@@media (max-width: 768px) { .sold-sticker { bottom: 10px; right: 10px; padding: 0.2rem 0.6rem; font-size: 0.6rem; } }

/* Testimonial Cards */
.testimonial-card { background: var(--card-bg); border-radius: 20px; padding: 1.5rem; text-align: center; transition: var(--transition); border: 1px solid var(--border-color); height: 100%; }
@@media (max-width: 992px) { .testimonial-card { padding: 1.2rem; } }
@@media (max-width: 768px) { .testimonial-card { padding: 1rem; } }
.testimonial-card:hover { transform: translateY(-8px); border-color: var(--primary); }
.testimonial-img { width: 70px; height: 70px; background: var(--gradient-gold); border-radius: 50%; margin: 0 auto 1rem; display: flex; align-items: center; justify-content: center; font-size: 2rem; color: #000; }
@@media (max-width: 768px) { .testimonial-img { width: 60px; height: 60px; font-size: 1.6rem; margin-bottom: 0.8rem; } }
.testimonial-text { font-style: italic; color: var(--gray); font-size: clamp(0.8rem, 3vw, 0.9rem); line-height: 1.6; }

/* Price Guide */
.price-guide { background: var(--card-bg); border-radius: 20px; padding: 1.5rem; height: 100%; }
@@media (max-width: 992px) { .price-guide { padding: 1.2rem; } }
@@media (max-width: 768px) { .price-guide { padding: 1rem; } }
.price-item { display: flex; justify-content: space-between; padding: 0.8rem 0; border-bottom: 1px solid var(--border-color); transition: var(--transition); color: var(--gray); flex-wrap: wrap; }
@@media (max-width: 768px) { .price-item { flex-direction: column; gap: 0.3rem; text-align: center; padding: 0.6rem 0; } }
.price-item:hover { padding-left: 10px; color: var(--primary); }
.price-category { font-weight: 600; font-size: clamp(0.75rem, 3vw, 0.85rem); }
.price-value { color: var(--primary); font-size: clamp(0.7rem, 3vw, 0.85rem); }

/* CTA Banner */
.cta-banner { background: linear-gradient(135deg, rgba(197,160,89,0.1), var(--card-bg)); border-radius: 30px; padding: 2.5rem; text-align: center; border: 1px solid var(--border-color); margin-top: 3rem; }
@@media (max-width: 992px) { .cta-banner { padding: 2rem; margin-top: 2.5rem; } }
@@media (max-width: 768px) { .cta-banner { padding: 1.5rem; margin-top: 2rem; border-radius: 25px; } }
@@media (max-width: 576px) { .cta-banner { padding: 1.2rem; border-radius: 20px; } }
.cta-banner h3 { font-size: clamp(1.2rem, 4vw, 1.8rem); margin-bottom: 1rem; color: var(--text-color); }
.cta-banner p { color: var(--gray); font-size: clamp(0.8rem, 3vw, 0.9rem); margin-bottom: 1rem; }
.btn-primary-gold { background: var(--gradient-gold); color: #000; padding: 0.6rem 1.8rem; border-radius: 50px; font-weight: 600; border: none; transition: var(--transition); cursor: pointer; display: inline-block; font-size: clamp(0.8rem, 3vw, 0.85rem); }
@@media (max-width: 768px) { .btn-primary-gold { padding: 0.5rem 1.2rem; } }
@@media (max-width: 576px) { .btn-primary-gold { padding: 0.45rem 1rem; font-size: 0.75rem; } }
.btn-primary-gold:hover { transform: translateY(-2px); box-shadow: var(--shadow-gold); }

/* Login/Register Modal Styles */
.login-modal, .register-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.96);
    backdrop-filter: blur(20px);
    z-index: 2000;
    align-items: center;
    justify-content: center;
}

.login-modal.active, .register-modal.active {
    display: flex;
    animation: fadeInModal 0.3s ease;
}

@@keyframes fadeInModal {
    from { opacity: 0; }
    to { opacity: 1; }
}

.modal-login-glass, .modal-register-glass {
    background: var(--modal-bg);
    border-radius: 28px;
    max-width: 450px;
    width: 90%;
    padding: 2rem 1.5rem 1.5rem 1.5rem;
    border: 1px solid rgba(197, 160, 89, 0.25);
    animation: modalPop 0.4s cubic-bezier(0.34, 1.2, 0.64, 1);
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
}

@@media (max-width: 576px) {
    .modal-login-glass, .modal-register-glass {
        padding: 1.8rem 1rem 1rem 1rem;
        max-width: 95%;
        border-radius: 20px;
    }
}

@@keyframes modalPop {
    from { opacity: 0; transform: scale(0.9) translateY(-40px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
}

.close-modal {
    position: absolute;
    top: 15px;
    right: 20px;
    font-size: 1.5rem;
    cursor: pointer;
    color: var(--gray);
    transition: var(--transition);
    background: none;
    border: none;
}

.close-modal:hover {
    color: var(--primary);
    transform: rotate(90deg);
}

.modal-header-custom {
    text-align: center;
    margin-bottom: 1.5rem;
}

.modal-header-custom h3 {
    font-size: clamp(1.2rem, 4vw, 1.5rem);
    font-weight: 700;
    color: var(--modal-text);
}

.modal-header-custom p {
    color: var(--gray);
    font-size: 0.8rem;
}

.role-selector {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 1.5rem;
}

.role-btn {
    background: rgba(197, 160, 89, 0.1);
    border: 1px solid var(--border-color);
    padding: 0.4rem 0.8rem;
    border-radius: 50px;
    cursor: pointer;
    font-size: 0.75rem;
    color: var(--modal-text);
    transition: var(--transition);
}

.role-btn.active {
    background: var(--primary);
    color: #000;
}

.role-btn:hover {
    background: var(--primary);
    color: #000;
}

.input-group {
    margin-bottom: 1rem;
}

.input-group label {
    font-size: 0.75rem;
    margin-bottom: 0.3rem;
    display: block;
    color: var(--gray);
}

.input-group input, .input-group select {
    width: 100%;
    padding: 0.7rem;
    background: rgba(197, 160, 89, 0.05);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    color: var(--modal-text);
    font-size: 0.85rem;
}

.input-group select {
    appearance: auto;
    -webkit-appearance: menulist;
    -moz-appearance: menulist;
    cursor: pointer;
}

.input-group select option {
    background: var(--card-bg);
    color: var(--modal-text);
}

body.light-mode .input-group select option {
    background: #ffffff;
    color: #1a1a1a;
}

.switch-form {
    text-align: center;
    margin-top: 1rem;
    font-size: 0.8rem;
    cursor: pointer;
    color: var(--gray);
}

.switch-form span {
    color: var(--primary);
}

.demo-creds p {
    font-size: 0.7rem;
    margin-bottom: 0.3rem;
    cursor: pointer;
    color: var(--primary);
}

.demo-creds p:hover {
    text-decoration: underline;
}

/* Footer */
.footer { background: var(--footer-bg); padding: 4rem 0 2rem; margin-top: 4rem; border-top: 1px solid var(--border-color); position: relative; z-index: 2; }
@@media (max-width: 992px) { .footer { padding: 3rem 0 1.5rem; margin-top: 3rem; } }
@@media (max-width: 768px) { .footer { padding: 2rem 0 1.2rem; margin-top: 2rem; text-align: center; } }
.footer-logo { font-family: 'Playfair Display', serif; font-size: clamp(1.3rem, 4vw, 1.8rem); font-weight: 800; background: var(--gradient-gold); -webkit-background-clip: text; background-clip: text; color: transparent; display: inline-block; }
.footer-links { list-style: none; padding: 0; }
.footer-links li { margin-bottom: 0.8rem; }
@@media (max-width: 768px) { .footer-links li { margin-bottom: 0.5rem; } }
.footer-links a { color: var(--gray); text-decoration: none; transition: var(--transition); font-size: clamp(0.8rem, 3vw, 0.85rem); }
.social-icons-footer { display: flex; gap: 1rem; margin-top: 1.5rem; }
@@media (max-width: 768px) { .social-icons-footer { justify-content: center; } }
.social-icon-footer { width: 40px; height: 40px; background: rgba(197,160,89,0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--primary); transition: var(--transition); }
@@media (max-width: 768px) { .social-icon-footer { width: 35px; height: 35px; } }
.social-icon-footer:hover { background: var(--primary); color: #000; transform: translateY(-5px) rotate(360deg); }

/* Scroll Top */
.scroll-top { position: fixed; bottom: 30px; right: 30px; width: 45px; height: 45px; background: var(--gradient-gold); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #000; cursor: pointer; opacity: 0; visibility: hidden; transition: var(--transition); border: none; z-index: 999; }
@@media (max-width: 768px) { .scroll-top { width: 40px; height: 40px; bottom: 20px; right: 20px; } }
@@media (max-width: 576px) { .scroll-top { width: 35px; height: 35px; bottom: 15px; right: 15px; } }
.scroll-top.show { opacity: 1; visibility: visible; }

/* Premium Modal */
.premium-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.96);
    backdrop-filter: blur(12px);
    z-index: 2000;
    align-items: center;
    justify-content: center;
}
.premium-modal.active { display: flex; animation: fadeInModal 0.3s ease; }
@@keyframes fadeInModal { from { opacity: 0; } to { opacity: 1; } }

.modal-glass-premium {
    background: var(--modal-bg);
    border-radius: 28px;
    max-width: 520px;
    width: 90%;
    border: 1px solid rgba(197, 160, 89, 0.25);
    animation: modalPopPremium 0.4s cubic-bezier(0.34, 1.2, 0.64, 1);
    max-height: 85vh;
    overflow: hidden;
    position: relative;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4);
}
@@media (max-width: 992px) { .modal-glass-premium { max-width: 500px; } }
@@media (max-width: 768px) { .modal-glass-premium { max-width: 95%; border-radius: 24px; } }
@@media (max-width: 576px) { .modal-glass-premium { max-width: 95%; border-radius: 20px; } }
@@keyframes modalPopPremium {
    from { opacity: 0; transform: scale(0.9) translateY(-40px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
}

.modal-header-premium {
    background: linear-gradient(135deg, rgba(197,160,89,0.15), rgba(197,160,89,0.05));
    padding: 1.2rem 1.5rem;
    border-bottom: 1px solid rgba(197, 160, 89, 0.15);
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 10;
}
@@media (max-width: 768px) { .modal-header-premium { padding: 1rem; } }
.modal-header-premium h3 {
    margin: 0;
    font-family: 'Playfair Display', serif;
    font-size: clamp(1rem, 4vw, 1.3rem);
    font-weight: 700;
    color: var(--modal-text);
}
.modal-close-premium {
    background: rgba(255,255,255,0.08);
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition);
    color: var(--gray);
}
@@media (max-width: 576px) { .modal-close-premium { width: 28px; height: 28px; } }
.modal-close-premium:hover {
    background: var(--primary);
    color: #000;
    transform: rotate(90deg);
}

.modal-body-premium {
    padding: 1.5rem;
    max-height: calc(85vh - 130px);
    overflow-y: auto;
}
@@media (max-width: 768px) { .modal-body-premium { padding: 1.2rem; } }
@@media (max-width: 576px) { .modal-body-premium { padding: 1rem; } }
.modal-body-premium::-webkit-scrollbar { width: 4px; }
.modal-body-premium::-webkit-scrollbar-track { background: rgba(197, 160, 89, 0.1); border-radius: 10px; }
.modal-body-premium::-webkit-scrollbar-thumb { background: var(--primary); border-radius: 10px; }

.modal-icon-premium { text-align: center; margin-bottom: 1rem; }
.modal-icon-premium i { font-size: clamp(2rem, 6vw, 3rem); color: var(--primary); background: rgba(197, 160, 89, 0.12); width: clamp(60px, 15vw, 70px); height: clamp(60px, 15vw, 70px); line-height: clamp(60px, 15vw, 70px); border-radius: 50%; display: inline-block; }

.modal-date-premium { text-align: center; color: var(--primary); font-size: clamp(0.75rem, 3vw, 0.85rem); margin-bottom: 1.5rem; padding-bottom: 0.8rem; border-bottom: 1px dashed rgba(197, 160, 89, 0.2); }

.modal-info-row {
    display: flex;
    margin-bottom: 1rem;
    padding: 0.5rem 0;
    align-items: flex-start;
    flex-wrap: wrap;
}
.modal-info-label {
    width: 110px;
    font-weight: 600;
    color: var(--primary);
    font-size: clamp(0.7rem, 3vw, 0.85rem);
}
@@media (max-width: 768px) { .modal-info-label { width: 100%; margin-bottom: 0.3rem; } }
.modal-info-value {
    flex: 1;
    color: var(--modal-text);
    font-size: clamp(0.7rem, 3vw, 0.85rem);
    line-height: 1.5;
}

.modal-info-box-premium {
    background: rgba(197, 160, 89, 0.06);
    border-radius: 16px;
    padding: 1.2rem;
    margin: 1.2rem 0;
    border: 1px solid rgba(197, 160, 89, 0.12);
}
@@media (max-width: 576px) { .modal-info-box-premium { padding: 0.8rem; } }
.modal-info-box-premium strong {
    color: var(--primary);
    display: block;
    margin-bottom: 0.8rem;
    font-size: clamp(0.8rem, 3vw, 0.9rem);
}
.modal-info-box-premium span {
    color: var(--modal-text);
    font-size: clamp(0.7rem, 3vw, 0.8rem);
    line-height: 1.7;
    opacity: 0.85;
}

.modal-footer-premium {
    padding: 1rem 1.5rem;
    border-top: 1px solid rgba(197, 160, 89, 0.12);
    background: rgba(0,0,0,0.2);
}
@@media (max-width: 768px) { .modal-footer-premium { padding: 0.8rem 1rem; } }
.btn-modal-premium {
    background: var(--gradient-gold);
    color: #000;
    padding: 0.7rem 1.2rem;
    border-radius: 50px;
    font-weight: 600;
    border: none;
    transition: var(--transition);
    width: 100%;
    cursor: pointer;
    font-size: clamp(0.75rem, 3vw, 0.85rem);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
}
</style>
</head>
<body>

<div id="particles-js"></div>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg" id="navbar">
        <div class="container">
            <a class="logo" asp-controller="Home" asp-action="Index">✨ ARTISTIC</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon" style="filter: invert(1);"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Competitions">Competitions</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Exhibitions">Exhibitions</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Gallery">Gallery</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">About</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a></li>
                </ul>
                <div class="ms-lg-3 d-flex gap-2 align-items-center flex-wrap">
                    <div class="theme-toggle" id="themeToggle">
                        <i class="fas fa-sun" id="themeIcon"></i>
                    </div>
                    <a class="btn-nav" onclick="openLoginModal()">Login</a>
                    <a class="btn-nav btn-register" onclick="openRegisterModal()">Register</a>
                </div>
            </div>
        </div>
    </nav>

<!-- Page Header -->
<section class="page-header">
    <div class="container">
        <h1>Art <span style="color: var(--primary);">Exhibitions</span></h1>
        <p>Showcase your artwork to the world and earn from your creativity</p>
    </div>
</section>

<!-- Stats Bar -->
<div class="container">
    <div class="stats-bar">
        <div class="row text-center g-2 g-md-3">
            <div class="col-md-3 col-6"><div class="stat-item"><div class="stat-number">15+</div><div class="stat-label">Exhibitions Held</div></div></div>
            <div class="col-md-3 col-6"><div class="stat-item"><div class="stat-number">2,500+</div><div class="stat-label">Artworks Sold</div></div></div>
            <div class="col-md-3 col-6"><div class="stat-item"><div class="stat-number">PKR 25M+</div><div class="stat-label">Total Sales</div></div></div>
            <div class="col-md-3 col-6"><div class="stat-item"><div class="stat-number">100%</div><div class="stat-label">Proceeds to Artist</div></div></div>
        </div>
    </div>
</div>

<!-- Countdown Timer -->
<div class="container">
    <div class="countdown-section text-center" data-aos="fade-up">
        <h3 class="countdown-title">🎨 Next Exhibition Starts In</h3>
        <div class="row justify-content-center g-2 g-md-3">
            <div class="col-3 col-md-2"><div class="timer-box"><div class="timer-number" id="days">00</div><div class="timer-label">Days</div></div></div>
            <div class="col-3 col-md-2"><div class="timer-box"><div class="timer-number" id="hours">00</div><div class="timer-label">Hours</div></div></div>
            <div class="col-3 col-md-2"><div class="timer-box"><div class="timer-number" id="minutes">00</div><div class="timer-label">Minutes</div></div></div>
            <div class="col-3 col-md-2"><div class="timer-box"><div class="timer-number" id="seconds">00</div><div class="timer-label">Seconds</div></div></div>
        </div>
        <p class="mt-3" style="color: var(--gray); font-size: clamp(0.8rem, 3vw, 0.9rem);">National Art Expo 2025 - Lahore, Pakistan</p>
    </div>
</div>

<!-- Category Filters -->
<div class="container">
    <div class="category-filters">
        <button class="cat-btn active" data-filter="all">All Exhibitions</button>
        <button class="cat-btn" data-filter="painting">🎨 Painting</button>
        <button class="cat-btn" data-filter="digital">💻 Digital Art</button>
        <button class="cat-btn" data-filter="sculpture">🗿 Sculpture</button>
        <button class="cat-btn" data-filter="photography">📷 Photography</button>
    </div>
</div>

<!-- Exhibitions Grid -->
<section class="py-4">
    <div class="container">
        <div class="row g-4" id="exhibitionsGrid">
            <!-- Exhibition 1 - Painting -->
            <div class="col-lg-6 col-md-6 col-sm-12 exhibition-item" data-category="painting">
                <div class="exhibition-card" onclick="openExhibitionModal('National Art Expo 2025', 'Lahore, Pakistan', 'March 25-30, 2025', 'Selected student paintings will be displayed and sold. 100% sale proceeds go to the artist! Last year, 45 paintings were sold with average price of PKR 50,000.', 'PKR 50,000 - 200,000')">
                    <div class="card-img-wrapper">
                        <img src="https://images.pexels.com/photos/1194420/pexels-photo-1194420.jpeg?w=400" class="card-img" alt="National Art Expo">
                        <span class="card-badge">🎨 UPCOMING</span>
                    </div>
                    <div class="card-body">
                        <h3 class="card-title">National Art Expo 2025</h3>
                        <div class="card-meta"><span><i class="fas fa-map-marker-alt"></i> Lahore, Pakistan</span><span><i class="far fa-calendar"></i> March 25-30, 2025</span></div>
                        <p class="small" style="color: var(--gray);">Selected paintings displayed and sold. 100% proceeds to artist!</p>
                        <div class="sold-info"><i class="fas fa-chart-line me-2"></i> Last year sales: PKR 2.5 Million</div>
                        <button class="btn-view-details mt-3">View Details</button>
                    </div>
                </div>
            </div>

            <!-- Exhibition 2 - Digital -->
            <div class="col-lg-6 col-md-6 col-sm-12 exhibition-item" data-category="digital">
                <div class="exhibition-card" onclick="openExhibitionModal('International Art Fair', 'Karachi, Pakistan', 'June 10-15, 2025', 'International buyers and art collectors from USA, UK, UAE, Europe, and Asia. Opportunity to sell artwork globally. Previous sales up to PKR 500,000 per painting.', 'PKR 100,000 - 500,000')">
                    <div class="card-img-wrapper">
                        <img src="~/userimage/img/fair.png" class="card-img" alt="International Art Fair">
                        <span class="card-badge">🌍 UPCOMING</span>
                    </div>
                    <div class="card-body">
                        <h3 class="card-title">International Art Fair</h3>
                        <div class="card-meta"><span><i class="fas fa-map-marker-alt"></i> Karachi, Pakistan</span><span><i class="far fa-calendar"></i> June 10-15, 2025</span></div>
                        <p class="small" style="color: var(--gray);">International buyers from 15+ countries. Global exposure!</p>
                        <div class="sold-info"><i class="fas fa-globe me-2"></i> Buyers from USA, UK, UAE, Europe</div>
                        <button class="btn-view-details mt-3">View Details</button>
                    </div>
                </div>
            </div>

            <!-- Exhibition 3 - Digital -->
            <div class="col-lg-6 col-md-6 col-sm-12 exhibition-item" data-category="digital">
                <div class="exhibition-card" onclick="openExhibitionModal('Digital Art Exhibition', 'Islamabad, Pakistan', 'September 5-10, 2025', 'Exclusive exhibition for digital artists. NFTs and digital prints will be sold. Special section for AI-generated art.', 'PKR 30,000 - 150,000')">
                    <div class="card-img-wrapper">
                        <img src="~/userimage/img/exhibition.png" class="card-img" alt="Digital Art Exhibition">
                        <span class="card-badge">💻 UPCOMING</span>
                    </div>
                    <div class="card-body">
                        <h3 class="card-title">Digital Art Exhibition</h3>
                        <div class="card-meta"><span><i class="fas fa-map-marker-alt"></i> Islamabad, Pakistan</span><span><i class="far fa-calendar"></i> September 5-10, 2025</span></div>
                        <p class="small" style="color: var(--gray);">Exclusive exhibition for digital artists and NFT creators.</p>
                        <div class="sold-info"><i class="fas fa-nfc-symbol me-2"></i> NFT Minting Available</div>
                        <button class="btn-view-details mt-3">View Details</button>
                    </div>
                </div>
            </div>

            <!-- Exhibition 4 - Painting -->
            <div class="col-lg-6 col-md-6 col-sm-12 exhibition-item" data-category="painting">
                <div class="exhibition-card" onclick="openExhibitionModal('Student Graduation Show', 'Lahore, Pakistan', 'December 15-20, 2025', 'Annual graduation exhibition featuring best works of graduating students. Industry professionals and gallery owners attend.', 'PKR 40,000 - 300,000')">
                    <div class="card-img-wrapper">
                        <img src="~/userimage/img/graduation.png" class="card-img" alt="Graduation Show">
                        <span class="card-badge">🎓 UPCOMING</span>
                    </div>
                    <div class="card-body">
                        <h3 class="card-title">Student Graduation Show</h3>
                        <div class="card-meta"><span><i class="fas fa-map-marker-alt"></i> Lahore, Pakistan</span><span><i class="far fa-calendar"></i> December 15-20, 2025</span></div>
                        <p class="small" style="color: var(--gray);">Annual graduation exhibition featuring best works.</p>
                        <div class="sold-info"><i class="fas fa-trophy me-2"></i> Top 3 works get special awards</div>
                        <button class="btn-view-details mt-3">View Details</button>
                    </div>
                </div>
            </div>

            <!-- Exhibition 5 - Photography -->
            <div class="col-lg-6 col-md-6 col-sm-12 exhibition-item" data-category="photography">
                <div class="exhibition-card" onclick="openExhibitionModal('Photo Art Festival', 'Lahore, Pakistan', 'August 15-20, 2025', 'Exclusive photography exhibition featuring landscape, portrait, and documentary photography. Prints available for sale.', 'PKR 25,000 - 80,000')">
                    <div class="card-img-wrapper">
                        <img src="~/userimage/img/festival.png" class="card-img" alt="Photo Festival">
                        <span class="card-badge">📷 UPCOMING</span>
                    </div>
                    <div class="card-body">
                        <h3 class="card-title">Photo Art Festival</h3>
                        <div class="card-meta"><span><i class="fas fa-map-marker-alt"></i> Lahore, Pakistan</span><span><i class="far fa-calendar"></i> August 15-20, 2025</span></div>
                        <p class="small" style="color: var(--gray);">Exclusive photography exhibition.</p>
                        <div class="sold-info"><i class="fas fa-camera me-2"></i> Limited edition prints available</div>
                        <button class="btn-view-details mt-3">View Details</button>
                    </div>
                </div>
            </div>

            <!-- Exhibition 6 - Sculpture -->
            <div class="col-lg-6 col-md-6 col-sm-12 exhibition-item" data-category="sculpture">
                <div class="exhibition-card" onclick="openExhibitionModal('Sculpture Biennale', 'Lahore, Pakistan', 'October 10-25, 2025', 'International sculpture exhibition featuring ceramic, metal, and mixed media works. Installation art welcome.', 'PKR 80,000 - 500,000')">
                    <div class="card-img-wrapper">
                        <img src="https://images.pexels.com/photos/1619317/pexels-photo-1619317.jpeg?w=400" class="card-img" alt="Sculpture">
                        <span class="card-badge">🗿 UPCOMING</span>
                    </div>
                    <div class="card-body">
                        <h3 class="card-title">Sculpture Biennale</h3>
                        <div class="card-meta"><span><i class="fas fa-map-marker-alt"></i> Lahore, Pakistan</span><span><i class="far fa-calendar"></i> October 10-25, 2025</span></div>
                        <p class="small" style="color: var(--gray);">International sculpture exhibition.</p>
                        <div class="sold-info"><i class="fas fa-cube me-2"></i> Large format sculptures welcome</div>
                        <button class="btn-view-details mt-3">View Details</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Price Guide Section -->
<section class="py-4">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-6" data-aos="fade-right">
                <div class="price-guide">
                    <h3 style="color: var(--primary); margin-bottom: 1.5rem; font-size: clamp(1.1rem, 4vw, 1.4rem);"><i class="fas fa-tag me-2"></i>Artwork Price Guide</h3>
                    <div class="price-item"><span class="price-category">🎨 Small Painting (12x16)</span><span class="price-value">PKR 15,000 - 30,000</span></div>
                    <div class="price-item"><span class="price-category">🖼️ Medium Painting (24x36)</span><span class="price-value">PKR 35,000 - 70,000</span></div>
                    <div class="price-item"><span class="price-category">🎨 Large Painting (36x48)</span><span class="price-value">PKR 80,000 - 150,000</span></div>
                    <div class="price-item"><span class="price-category">💻 Digital Art Print</span><span class="price-value">PKR 10,000 - 40,000</span></div>
                    <div class="price-item"><span class="price-category">🗿 Small Sculpture</span><span class="price-value">PKR 50,000 - 120,000</span></div>
                    <div class="price-item"><span class="price-category">📷 Limited Edition Photo</span><span class="price-value">PKR 20,000 - 60,000</span></div>
                    <div class="price-item mt-2" style="border-bottom: none; color: var(--primary);"><span>💰 You set your own price!</span><span>100% proceeds to you</span></div>
                </div>
            </div>
            <div class="col-lg-6" data-aos="fade-left">
                <div class="price-guide">
                    <h3 style="color: var(--primary); margin-bottom: 1.5rem; font-size: clamp(1.1rem, 4vw, 1.4rem);"><i class="fas fa-question-circle me-2"></i>Submission Guidelines</h3>
                    <div class="price-item"><span>📅 Submission Deadline</span><span>15 days before exhibition</span></div>
                    <div class="price-item"><span>📏 Artwork Size Limit</span><span>Max 48x72 inches</span></div>
                    <div class="price-item"><span>📁 File Format</span><span>JPEG / PNG / PDF</span></div>
                    <div class="price-item"><span>💾 File Size</span><span>Max 10MB</span></div>
                    <div class="price-item"><span>📝 Description Required</span><span>Title + Artist Statement</span></div>
                    <div class="price-item"><span>⏱️ Selection Time</span><span>3-5 working days</span></div>
                    <button class="btn-primary-gold w-100 mt-3" onclick="openLoginModal()"><i class="fas fa-upload me-2"></i>Submit Your Artwork</button>
                </div>
            </div>
        </div>
    </div>
</section>
    <!-- 🔥 DYNAMIC EXHIBITIONS FROM DATABASE 🔥 -->
    @if (Model != null && Model.Any())
    {
        <section class="py-4">
            <div class="container">
                <h2 class="text-center mb-5" data-aos="fade-up" style="font-size: clamp(1.5rem, 5vw, 2rem);">
                    Upcoming <span style="color: var(--primary);">Exhibitions</span>
                </h2>
                <div class="row g-4">
                    @foreach (var exh in Model)
                    {
                        <div class="col-lg-6 col-md-6 col-sm-12 exhibition-item" data-category="all">
                            <div class="exhibition-card" onclick='openExhibitionModal("@exh.ExhibitionName", "@exh.Venue, @exh.City", "@exh.ExhibitionStartDate.ToString("MMM dd, yyyy") - @exh.ExhibitionEndDate.ToString("MMM dd, yyyy")", "@exh.Description", "PKR 50,000 - 200,000")'>
                                <div class="card-img-wrapper">
                                    @if (!string.IsNullOrEmpty(exh.ImagePath))
                                    {
                                        <img src="@exh.ImagePath" class="card-img" alt="@exh.ExhibitionName">
                                    }
                                    else
                                    {
                                        <img src="https://images.pexels.com/photos/1194420/pexels-photo-1194420.jpeg?w=400" class="card-img" alt="Exhibition">
                                    }
                                    <span class="card-badge">@(exh.Status == ExhibitionStatus.Ongoing ? "🔥 ONGOING" : "📅 UPCOMING")</span>
                                </div>
                                <div class="card-body">
                                    <h3 class="card-title">@exh.ExhibitionName</h3>
                                    <div class="card-meta">
                                        <span><i class="fas fa-map-marker-alt"></i> @exh.Venue, @exh.City</span>
                                        <span><i class="far fa-calendar"></i> @exh.ExhibitionStartDate.ToString("MMM dd, yyyy") - @exh.ExhibitionEndDate.ToString("MMM dd, yyyy")</span>
                                    </div>
