        AOS.init({ duration: 1000, once: true });

        // Initialize localStorage with default users
        if (!localStorage.getItem('registeredUsers')) {
            function hashPassword(password) {
                let hash = 0;
                for (let i = 0; i < password.length; i++) {
                    hash = ((hash << 5) - hash) + password.charCodeAt(i);
                    hash |= 0;
                }
                return hash.toString();
            }

            const defaultUsers = {
                students: [
                    { name: "Demo Student", email: "student@@artistic.edu.pk", password: "student123", program: "Bachelor of Fine Arts (BFA)" }
                ],
                staff: [
                    { name: "Demo Staff", email: "staff@@artistic.edu.pk", password: "staff123", department: "Fine Arts" }
                ],
                managers: [
                    { name: "Demo Manager", email: "manager@@artistic.edu.pk", password: "manager123", department: "Operations" }
                ],
                admins: [
                    { name: "Super Admin", email: "admin@@artistic.edu.pk", password: hashPassword("admin123"), role: "Super Admin" }
                ]
            };
            localStorage.setItem('registeredUsers', JSON.stringify(defaultUsers));
        }

        function hashPassword(password) {
            let hash = 0;
            for (let i = 0; i < password.length; i++) {
                hash = ((hash << 5) - hash) + password.charCodeAt(i);
                hash |= 0;
            }
            return hash.toString();
        }

        // Dark/Light Mode Toggle
        const themeToggle = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');
        const body = document.body;

        if (localStorage.getItem('theme') === 'light') {
            body.classList.add('light-mode');
            themeIcon.classList.remove('fa-sun');
            themeIcon.classList.add('fa-moon');
        } else {
            themeIcon.classList.remove('fa-moon');
            themeIcon.classList.add('fa-sun');
        }

        themeToggle.addEventListener('click', () => {
            body.classList.toggle('light-mode');
            if (body.classList.contains('light-mode')) {
                localStorage.setItem('theme', 'light');
                themeIcon.classList.remove('fa-sun');
                themeIcon.classList.add('fa-moon');
            } else {
                localStorage.setItem('theme', 'dark');
                themeIcon.classList.remove('fa-moon');
                themeIcon.classList.add('fa-sun');
            }
        });

        // Particles Background
        particlesJS('particles-js', {
            particles: { number: { value: 80 }, color: { value: '#C5A059' }, opacity: { value: 0.3 }, size: { value: 3, random: true }, move: { enable: true, speed: 2 } }
        });

        // Navbar Scroll
        window.addEventListener('scroll', () => {
            document.getElementById('navbar').classList.toggle('scrolled', window.scrollY > 50);
            document.getElementById('scrollTop').classList.toggle('show', window.scrollY > 200);
        });
        document.getElementById('scrollTop').onclick = () => window.scrollTo({ top: 0, behavior: 'smooth' });

        // Validation Functions
        function validateFullName() {
            const fullName = document.getElementById('fullName').value.trim();
            const errorDiv = document.getElementById('fullNameError');
            if (fullName === '') {
                errorDiv.textContent = 'Please enter your full name';
                document.getElementById('fullName').classList.add('is-invalid');
                return false;
            } else if (fullName.length < 3) {
                errorDiv.textContent = 'Name must be at least 3 characters';
                document.getElementById('fullName').classList.add('is-invalid');
                return false;
            } else {
                errorDiv.textContent = '';
                document.getElementById('fullName').classList.remove('is-invalid');
                return true;
            }
        }

        function validateEmail() {
            const email = document.getElementById('email').value.trim();
            const errorDiv = document.getElementById('emailError');
            const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            if (email === '') {
                errorDiv.textContent = 'Please enter your email address';
                document.getElementById('email').classList.add('is-invalid');
                return false;
            } else if (!emailRegex.test(email)) {
                errorDiv.textContent = 'Please enter a valid email address (e.g., name@@example.com)';
                document.getElementById('email').classList.add('is-invalid');
                return false;
            } else {
                errorDiv.textContent = '';
                document.getElementById('email').classList.remove('is-invalid');
                return true;
            }
        }

        function validateSubject() {
            const subject = document.getElementById('subject').value;
            const errorDiv = document.getElementById('subjectError');
            if (!subject || subject === '' || subject === 'Select Subject *') {
                errorDiv.textContent = 'Please select a subject';
                document.getElementById('subject').classList.add('is-invalid');
                return false;
            } else {
                errorDiv.textContent = '';
                document.getElementById('subject').classList.remove('is-invalid');
                return true;
            }
        }

        function validateMessage() {
            const message = document.getElementById('message').value.trim();
            const errorDiv = document.getElementById('messageError');
            if (message === '') {
                errorDiv.textContent = 'Please enter your message';
                document.getElementById('message').classList.add('is-invalid');
                return false;
            } else if (message.length < 10) {
                errorDiv.textContent = 'Message must be at least 10 characters';
                document.getElementById('message').classList.add('is-invalid');
                return false;
            } else if (message.length > 1000) {
                errorDiv.textContent = 'Message must be less than 1000 characters';
                document.getElementById('message').classList.add('is-invalid');
                return false;
            } else {
                errorDiv.textContent = '';
                document.getElementById('message').classList.remove('is-invalid');
                return true;
            }
        }

        // Real-time validation
        document.getElementById('fullName').addEventListener('input', validateFullName);
        document.getElementById('email').addEventListener('input', validateEmail);
        document.getElementById('subject').addEventListener('change', validateSubject);
        document.getElementById('message').addEventListener('input', validateMessage);


        // Modal Functions
        let currentSelectedRole = 'Student';

        function openLoginModal() {
            document.getElementById('loginModal').classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeLoginModal() {
            document.getElementById('loginModal').classList.remove('active');
            document.body.style.overflow = 'auto';
        }

        function openRegisterModal() {
            document.getElementById('registerModal').classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeRegisterModal() {
            document.getElementById('registerModal').classList.remove('active');
            document.body.style.overflow = 'auto';
            resetRegisterForm();
        }

        function resetRegisterForm() {
            document.getElementById('regName').value = '';
            document.getElementById('regEmail').value = '';
            document.getElementById('regPassword').value = '';
            document.getElementById('regConfirmPassword').value = '';
            document.getElementById('regProgram').value = 'Bachelor of Fine Arts (BFA)';
            document.getElementById('regRole').value = 'Student';
        }

        function switchToLogin() {
            closeRegisterModal();
            openLoginModal();
        }

        function switchToRegister() {
            closeLoginModal();
            openRegisterModal();
        }

        function fillDemo(email, pass) {
            document.getElementById('loginEmail').value = email;
            document.getElementById('loginPassword').value = pass;
        }

        // Role selection in login modal
        document.querySelectorAll('.role-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.role-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                currentSelectedRole = this.dataset.role;
                document.getElementById('loginEmail').placeholder = currentSelectedRole.toLowerCase() + '@@artistic.edu.pk';
            });
        });

        // Registration Handler
        function handleRegister() {
            const name = document.getElementById('regName').value.trim();
            const email = document.getElementById('regEmail').value.trim();
            const password = document.getElementById('regPassword').value;
            const confirmPassword = document.getElementById('regConfirmPassword').value;
            const program = document.getElementById('regProgram').value;
            const role = document.getElementById('regRole').value;

            if (!name || !email || !password || !confirmPassword) {
                Swal.fire({ title: 'Error!', text: 'Please fill all fields', icon: 'error', confirmButtonColor: '#C5A059' });
                return;
            }

            if (password.length < 6) {
                Swal.fire({ title: 'Error!', text: 'Password must be at least 6 characters', icon: 'error', confirmButtonColor: '#C5A059' });
                return;
            }

            if (password !== confirmPassword) {
                Swal.fire({ title: 'Error!', text: 'Passwords do not match', icon: 'error', confirmButtonColor: '#C5A059' });
                return;
            }

            const users = JSON.parse(localStorage.getItem('registeredUsers'));

            const allUsers = [...users.students, ...users.staff, ...users.managers, ...users.admins];
            if (allUsers.some(user => user.email === email)) {
                Swal.fire({ title: 'Error!', text: 'Email already registered', icon: 'error', confirmButtonColor: '#C5A059' });
                return;
            }

            if (role === 'Student') {
                users.students.push({ name, email, password, program });
            } else if (role === 'Staff') {
                users.staff.push({ name, email, password, department: "Fine Arts" });
            } else if (role === 'Manager') {
                users.managers.push({ name, email, password, department: "Management" });
            }

            localStorage.setItem('registeredUsers', JSON.stringify(users));

            Swal.fire({
                title: 'Registration Successful!',
                text: `You are now registered as a ${role}. Please login.`,
                icon: 'success',
                confirmButtonColor: '#C5A059'
            }).then(() => {
                closeRegisterModal();
                openLoginModal();
                document.getElementById('loginEmail').value = email;
                document.getElementById('loginPassword').value = '';
                document.querySelectorAll('.role-btn').forEach(btn => {
                    if (btn.dataset.role === role) {
                        btn.click();
                    }
                });
            });
        }

        // Login Handler - Admin redirects to backend/admin/dashboard.html
        function handleLogin() {
            const email = document.getElementById('loginEmail').value.trim();
            const password = document.getElementById('loginPassword').value;

            if (!email || !password) {
                Swal.fire({ title: 'Error!', text: 'Please enter email and password', icon: 'error', confirmButtonColor: '#C5A059' });
                return;
            }

            const users = JSON.parse(localStorage.getItem('registeredUsers'));
            let userFound = null;
            let role = null;

            if (currentSelectedRole === 'Student') {
                const student = users.students.find(u => u.email === email && u.password === password);
                if (student) {
                    userFound = student;
                    role = 'Student';
                }
            } else if (currentSelectedRole === 'Staff') {
                const staff = users.staff.find(u => u.email === email && u.password === password);
                if (staff) {
                    userFound = staff;
                    role = 'Staff';
                }
            } else if (currentSelectedRole === 'Manager') {
                const manager = users.managers.find(u => u.email === email && u.password === password);
                if (manager) {
                    userFound = manager;
                    role = 'Manager';
                }
            } else if (currentSelectedRole === 'Admin') {
                const admin = users.admins.find(u => u.email === email && u.password === hashPassword(password));
                if (admin) {
                    userFound = admin;
                    role = 'Admin';
                }
            }

            if (userFound) {
                localStorage.setItem('currentUser', JSON.stringify({ name: userFound.name, email, role }));

                let redirect = '';
                if (role === 'Student') redirect = 'student-dashboard.html';
                else if (role === 'Staff') redirect = 'staff-dashboard.html';
                else if (role === 'Manager') redirect = 'manager-dashboard.html';
                else if (role === 'Admin') redirect = 'backend/admin/dashboard.html';

                Swal.fire({
                    title: 'Login Successful!',
                    text: `Welcome ${userFound.name} to ${role} Dashboard`,
                    icon: 'success',
                    timer: 1500,
                    showConfirmButton: false
                }).then(() => {
                    window.location.href = redirect;
                });
            } else {
                Swal.fire({ title: 'Error!', text: 'Invalid email or password', icon: 'error', confirmButtonColor: '#C5A059' });
            }
        }

        // Close modals on escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeLoginModal();
                closeRegisterModal();
            }
        });
    </script>

</body>

</html>