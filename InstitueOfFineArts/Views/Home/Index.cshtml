    <!-- Login Modal -->
    <div class="login-modal" id="loginModal">
        <div class="modal-login-glass">
            <button type="button" class="close-modal" onclick="closeLoginModal()">&times;</button>
            <div class="modal-header-custom"><h3>Welcome Back!</h3></div>
            <form asp-controller="Account" asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="SelectedRole" id="SelectedRole" value="Student" />
                <div class="role-selector" id="roleSelector">
                    <button type="button" class="role-btn" onclick="selectLoginRole(this, 'Admin')">👑 Admin</button>
                    <button type="button" class="role-btn" onclick="selectLoginRole(this, 'Manager')">📊 Manager</button>
                    <button type="button" class="role-btn" onclick="selectLoginRole(this, 'Staff')">👨‍🏫 Staff</button>
                    <button type="button" class="role-btn active" onclick="selectLoginRole(this, 'Student')">🎓 Student</button>
