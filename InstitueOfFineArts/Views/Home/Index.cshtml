    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/particles.js/2.0.0/particles.min.js"></script>

    <script>
        // ============================================
        // FIXED JAVASCRIPT - DARK MODE + CHATBOT + PARTICLES
        // ============================================

        AOS.init({ duration: 1000, once: true });

        // ---------- PARTICLES.JS ----------
        particlesJS('particles-js', {
            particles: { number: { value: 80 }, color: { value: '#C5A059' }, opacity: { value: 0.3 }, size: { value: 3, random: true }, move: { enable: true, speed: 2 } }
        });

        // ---------- DARK/LIGHT MODE ----------
        const themeToggle = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');
        const body = document.body;

        function setTheme(isLight) {
            if (isLight) {
                body.classList.add('light-mode');
                themeIcon.classList.remove('fa-sun');
                themeIcon.classList.add('fa-moon');
                localStorage.setItem('theme', 'light');
            } else {
                body.classList.remove('light-mode');
                themeIcon.classList.remove('fa-moon');
                themeIcon.classList.add('fa-sun');
                localStorage.setItem('theme', 'dark');
            }
        }

        if (localStorage.getItem('theme') === 'light') {
            setTheme(true);
        } else {
            setTheme(false);
        }

        if (themeToggle) {
            themeToggle.addEventListener('click', () => {
                setTheme(!body.classList.contains('light-mode'));
            });
        }

        // ---------- TYPING ANIMATION ----------
        const words = ['Stroke', 'Brush', 'Canvas', 'Dream'];
        let wordIndex = 0, charIndex = 0, isDeleting = false;
        const typedElement = document.querySelector('.typed-text');

        function typeEffect() {
            if (!typedElement) return;
            const currentWord = words[wordIndex];
            if (isDeleting) {
                typedElement.textContent = currentWord.substring(0, charIndex - 1);
                charIndex--;
            } else {
                typedElement.textContent = currentWord.substring(0, charIndex + 1);
                charIndex++;
            }
            if (!isDeleting && charIndex === currentWord.length) {
                isDeleting = true;
                setTimeout(typeEffect, 2000);
                return;
            }
            if (isDeleting && charIndex === 0) {
                isDeleting = false;
                wordIndex = (wordIndex + 1) % words.length;
            }
            setTimeout(typeEffect, isDeleting ? 100 : 150);
        }
        typeEffect();

        // ---------- NAVBAR SCROLL ----------
        window.addEventListener('scroll', () => {
            const navbar = document.getElementById('navbar');
            const scrollTop = document.getElementById('scrollTop');
            if (navbar) navbar.classList.toggle('scrolled', window.scrollY > 50);
            if (scrollTop) scrollTop.classList.toggle('show', window.scrollY > 200);
        });

        // ---------- SCROLL TOP ----------
        const scrollTopBtn = document.getElementById('scrollTop');
        if (scrollTopBtn) {
            scrollTopBtn.onclick = () => window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // ---------- MODAL FUNCTIONS ----------
        let currentSelectedRole = 'Student';

        function openLoginModal(preSelectedRole) {
            const loginModal = document.getElementById('loginModal');
            const registerModal = document.getElementById('registerModal');

            if (registerModal) registerModal.classList.remove('active');
            if (loginModal) {
                loginModal.classList.add('active');
                document.body.style.overflow = 'hidden';
            }

            const selectedRoleInput = document.getElementById('SelectedRole');
            if (selectedRoleInput) {
                selectedRoleInput.value = preSelectedRole || 'Student';
            }

            document.querySelectorAll("#roleSelector .role-btn").forEach(btn => {
                btn.classList.remove("active");
                if (btn.innerText.includes(preSelectedRole || 'Student')) {
                    btn.classList.add("active");
                }
            });
        }

        function closeLoginModal() {
            const modal = document.getElementById('loginModal');
            if (modal) modal.classList.remove('active');
            document.body.style.overflow = 'auto';
        }

        function openRegisterModal() {
            const loginModal = document.getElementById('loginModal');
            const registerModal = document.getElementById('registerModal');
            if (loginModal) loginModal.classList.remove('active');
            if (registerModal) {
                registerModal.classList.add('active');
                document.body.style.overflow = 'hidden';
            }
        }

        function closeRegisterModal() {
            const modal = document.getElementById('registerModal');
            if (modal) modal.classList.remove('active');
            document.body.style.overflow = 'auto';
        }

        function switchToLogin() {
            closeRegisterModal();
            openLoginModal('Student');
        }

        function switchToRegister() {
            closeLoginModal();
            openRegisterModal();
        }

        function selectLoginRole(button, role) {
            const selectedRoleInput = document.getElementById("SelectedRole");
            if (selectedRoleInput) selectedRoleInput.value = role;
            document.querySelectorAll("#roleSelector .role-btn").forEach(btn => btn.classList.remove("active"));
            button.classList.add("active");
        }

        function openCompetitionModal() {
            const modal = document.getElementById('competitionModal');
            if (modal) modal.classList.add('active');
        }

        function closeCompetitionModal() {
            const modal = document.getElementById('competitionModal');
            if (modal) modal.classList.remove('active');
        }

        function openArtworkModal(title, artist, award, desc, imgSrc, value, likes, rating, badge) {
            document.getElementById('artworkTitle').innerText = title;
            document.getElementById('artworkArtist').innerText = "By " + artist;
            document.getElementById('artworkBadge').innerHTML = badge + " " + award;
            document.getElementById('artworkDesc').innerHTML = desc;
            document.getElementById('artworkValue').innerHTML = value;
            document.getElementById('artworkLikes').innerHTML = likes;
            document.getElementById('artworkRating').innerHTML = rating;
            const modal = document.getElementById('artworkModal');
            if (modal) modal.classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeArtworkModal() {
            const modal = document.getElementById('artworkModal');
            if (modal) modal.classList.remove('active');
            document.body.style.overflow = 'auto';
        }

        function applyCompetition() {
            Swal.fire({
                title: 'Application Started!',
                text: 'Please login to complete submission',
                icon: 'success',
                confirmButtonColor: '#C5A059',
                background: body.classList.contains('light-mode') ? '#FFFFFF' : '#1A1A2E',
                color: body.classList.contains('light-mode') ? '#1A1A1A' : '#FFFFFF'
            }).then(() => {
                closeCompetitionModal();
                openLoginModal('Student');
            });
        }

        function showWinnerDetails() {
            Swal.fire({
                title: '🏆 Award Winner',
                text: 'Congratulations! This student won a medal in the competition! Check the gallery to see their artwork.',
                icon: 'success',
                confirmButtonColor: '#C5A059',
                background: body.classList.contains('light-mode') ? '#FFFFFF' : '#1A1A2E',
                color: body.classList.contains('light-mode') ? '#1A1A1A' : '#FFFFFF'
            });
        }

        // ---------- CHATBOT ----------
        const chatbotBtn = document.getElementById('chatbotBtn');
        const chatbotWindow = document.getElementById('chatbotWindow');
        const closeChatbot = document.getElementById('closeChatbot');
        const chatMessages = document.getElementById('chatMessages');
        const chatInput = document.getElementById('chatInput');
        const sendChat = document.getElementById('sendChat');

        if (chatbotBtn) {
            chatbotBtn.onclick = () => { if (chatbotWindow) chatbotWindow.style.display = 'flex'; };
        }
        if (closeChatbot) {
            closeChatbot.onclick = () => { if (chatbotWindow) chatbotWindow.style.display = 'none'; };
        }

        function addMessage(text, isUser) {
            const msg = document.createElement('div');
            msg.className = isUser ? 'message user-message' : 'message bot-message';
            msg.innerHTML = text;
            if (chatMessages) {
                chatMessages.appendChild(msg);
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }
        }

        window.quickQuestion = function(type) {
            if (type === 'programs') {
                addMessage('What programs does ARTISTIC offer?', true);
                setTimeout(() => addMessage('🎨 <strong>ARTISTIC Institute of Fine Arts offers:</strong><br><br>📚 <strong>Programs:</strong><br>• Bachelor of Fine Arts (BFA)<br>• Diploma in Digital Art<br>• Certificate in Animation<br>• Short Courses in Painting<br>• Photography Workshop<br>• Sculpture Classes', false), 500);
            }
            else if (type === 'competition') {
                addMessage('How to join competition?', true);
                setTimeout(() => addMessage('🏆 <strong>How to Participate:</strong><br><br>1️⃣ Login to Student Account<br>2️⃣ Go to "Competitions" section<br>3️⃣ Select competition<br>4️⃣ Upload artwork<br>5️⃣ Submit before deadline', false), 500);
            }
            else if (type === 'exhibition') {
                addMessage('How to submit to exhibition?', true);
                setTimeout(() => addMessage('🖼️ <strong>How to Submit to Exhibition:</strong><br><br>1️⃣ Login to Student Dashboard<br>2️⃣ Go to "Exhibitions" section<br>3️⃣ Select exhibition<br>4️⃣ Submit your artwork', false), 500);
            }
            else if (type === 'register') {
                addMessage('How to register?', true);
                setTimeout(() => addMessage('📝 Click Register button, fill your details, choose program, and submit. Registration is FREE!', false), 500);
            }
            else if (type === 'award') {
                addMessage('What are the prize details?', true);
                setTimeout(() => addMessage('🏅 Gold: PKR 100,000<br>🥈 Silver: PKR 70,000<br>🥉 Bronze: PKR 50,000', false), 500);
            }
            else if (type === 'gallery') {
                addMessage('Tell me about the gallery', true);
                setTimeout(() => addMessage('🎨 Browse award-winning artworks from talented students. Participate in competitions to get featured!', false), 500);
            }
        }

        function botReply(message) {
            const lowerMsg = message.toLowerCase();
            if (lowerMsg.includes('program') || lowerMsg.includes('course')) {
                addMessage('🎨 <strong>Programs:</strong><br>• BFA<br>• Diploma in Digital Art<br>• Certificate in Animation<br>• Short Courses', false);
            }
            else if (lowerMsg.includes('competition')) {
                addMessage('🏆 Login to Student Account → Competitions → Select → Submit Artwork', false);
            }
            else if (lowerMsg.includes('exhibition')) {
                addMessage('🖼️ Login → Exhibitions → Submit Painting → Set Price → Wait for Selection', false);
            }
            else if (lowerMsg.includes('register')) {
                addMessage('📝 Click Register button on top right. Free registration!', false);
            }
            else if (lowerMsg.includes('hello') || lowerMsg.includes('hi')) {
                addMessage('🎨 Hello! Welcome to ARTISTIC! Ask me about programs, competitions, exhibitions, or registration.', false);
                addMessage('<div class="quick-buttons"><button class="quick-btn" onclick="quickQuestion(\'programs\')">📚 Programs</button><button class="quick-btn" onclick="quickQuestion(\'competition\')">🏆 Competitions</button><button class="quick-btn" onclick="quickQuestion(\'exhibition\')">🖼️ Exhibitions</button></div>', false);
            }
            else {
                addMessage('🎨 Ask me about programs, competitions, exhibitions, or registration!', false);
            }
        }

        if (sendChat) {
            sendChat.onclick = () => {
                const msg = chatInput ? chatInput.value.trim() : '';
                if (!msg) return;
                addMessage(msg, true);
                if (chatInput) chatInput.value = '';
                setTimeout(() => botReply(msg), 500);
            };
        }
        if (chatInput) {
            chatInput.addEventListener('keypress', (e) => { if (e.key === 'Enter' && sendChat) sendChat.click(); });
        }

        // ---------- ESCAPE KEY ----------
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                if (chatbotWindow && chatbotWindow.style.display === 'flex') chatbotWindow.style.display = 'none';
                closeLoginModal();
                closeRegisterModal();
                closeCompetitionModal();
                closeArtworkModal();
            }
        });

        // ---------- BUTTON EVENT LISTENERS ----------
        document.addEventListener("DOMContentLoaded", function () {
            const loginBtn = document.getElementById("loginBtn");
            const registerBtn = document.getElementById("registerBtn");

            if (loginBtn) {
                loginBtn.addEventListener("click", function () {
                    openLoginModal("Student");
                });
            }
            if (registerBtn) {
                registerBtn.addEventListener("click", function () {
                    openRegisterModal();
                });
            }
        });
    </script>

</body>
</html>