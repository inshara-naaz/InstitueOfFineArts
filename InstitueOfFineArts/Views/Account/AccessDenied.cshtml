@{
    ViewData["Title"] = "Access Denied";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Access Denied | ARTISTIC Institute</title>

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800;900&family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #0A0A0A 0%, #1A1A2E 100%);
            color: #FFFFFF;
            overflow-x: hidden;
            position: relative;
        }

            body.light-mode {
                background: linear-gradient(135deg, #F5F5F5 0%, #E8E8E8 100%);
                color: #1A1A1A;
            }

        .particles-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }

        .container-custom {
            position: relative;
            z-index: 2;
            padding: 2rem;
        }

        .error-card {
            background: rgba(26, 26, 46, 0.85);
            backdrop-filter: blur(10px);
            border-radius: 30px;
            padding: 3rem;
            text-align: center;
            border: 1px solid rgba(197, 160, 89, 0.3);
            max-width: 500px;
            margin: 0 auto;
            animation: fadeInUp 0.6s ease;
        }

        body.light-mode .error-card {
            background: rgba(255, 255, 255, 0.95);
            border: 1px solid rgba(197, 160, 89, 0.3);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }

        @@keyframes fadeInUp {
            from

        {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .error-icon {
            width: 100px;
            height: 100px;
            background: linear-gradient(135deg, rgba(197, 160, 89, 0.2), rgba(197, 160, 89, 0.05));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
            border: 2px solid #C5A059;
        }

            .error-icon i {
                font-size: 3rem;
                color: #C5A059;
            }

        h1 {
            font-family: 'Playfair Display', serif;
            font-size: 4rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
            background: linear-gradient(135deg, #C5A059 0%, #E8C87A 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        h2 {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 1rem;
            color: #C5A059;
        }

        p {
            color: var(--gray);
            margin-bottom: 2rem;
            font-size: 1rem;
            line-height: 1.6;
        }

        body.light-mode p {
            color: #666;
        }

        .btn-gold {
            background: linear-gradient(135deg, #C5A059, #E8C87A);
            color: #000;
            border: none;
            padding: 0.8rem 2rem;
            border-radius: 50px;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

            .btn-gold:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(197, 160, 89, 0.3);
            }

        .btn-outline {
            background: transparent;
            border: 2px solid #C5A059;
            color: #C5A059;
            padding: 0.8rem 2rem;
            border-radius: 50px;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            transition: all 0.3s ease;
            margin-left: 1rem;
        }

            .btn-outline:hover {
                background: #C5A059;
                color: #000;
                transform: translateY(-2px);
            }

        .button-group {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
        }

        .theme-toggle {
            position: fixed;
            top: 20px;
            right: 20px;
            width: 40px;
            height: 40px;
            background: rgba(197, 160, 89, 0.15);
            border: 1px solid #C5A059;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            z-index: 100;
        }

            .theme-toggle i {
                font-size: 1.2rem;
                color: #C5A059;
            }

            .theme-toggle:hover {
                background: #C5A059;
                transform: rotate(15deg);
            }

                .theme-toggle:hover i {
                    color: #000;
                }

        @@media (max-width: 768px) {
            .error-card {
                padding: 2rem;
                margin: 1rem;
            }

            h1 {
                font-size: 2.5rem;
            }

            h2 {
                font-size: 1.2rem;
            }

            .button-group {
                flex-direction: column;
            }

            .btn-outline {
                margin-left: 0;
            }
        }
    </style>
</head>
<body>

    <div class="particles-bg" id="particles-js"></div>

    <div class="theme-toggle" id="themeToggle">
        <i class="fas fa-sun" id="themeIcon"></i>
    </div>

    <div class="container-custom">
        <div class="error-card" data-aos="fade-up">
            <div class="error-icon">
                <i class="fas fa-lock"></i>
            </div>
            <h1>403</h1>
            <h2>Access Denied</h2>
            <p><i class="fas fa-exclamation-triangle me-2" style="color: #C5A059;"></i> You are not allowed to access this page. Please login with the correct role or contact the administrator.</p>
            <div class="button-group">
                <a asp-controller="Account" asp-action="Login" class="btn-gold">
                    <i class="fas fa-sign-in-alt"></i> Back to Login
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn-outline">
                    <i class="fas fa-home"></i> Go to Home
                </a>
            </div>
        </div>
    </div>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="https://cdn.jsdelivr.net/particles.js/2.0.0/particles.min.js"></script>

    <script>
        AOS.init({ duration: 800, once: true });

        // Dark/Light Mode Toggle
        const themeToggle = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');
        const body = document.body;

        if (localStorage.getItem('theme') === 'light') {
            body.classList.add('light-mode');
            themeIcon.classList.remove('fa-sun');
            themeIcon.classList.add('fa-moon');
        } else {
            themeIcon.classList.remove('fa-moon');
            themeIcon.classList.add('fa-sun');
        }

        themeToggle.addEventListener('click', () => {
            body.classList.toggle('light-mode');
            if (body.classList.contains('light-mode')) {
                localStorage.setItem('theme', 'light');
                themeIcon.classList.remove('fa-sun');
                themeIcon.classList.add('fa-moon');
            } else {
                localStorage.setItem('theme', 'dark');
                themeIcon.classList.remove('fa-moon');
                themeIcon.classList.add('fa-sun');
            }
        });

        // Particles Background
        particlesJS('particles-js', {
            particles: {
                number: { value: 60, density: { enable: true, value_area: 800 } },
                color: { value: '#C5A059' },
                opacity: { value: 0.25, random: true },
                size: { value: 2, random: true },
                line_linked: { enable: true, distance: 150, color: '#C5A059', opacity: 0.1, width: 1 },
                move: { enable: true, speed: 1.5, direction: 'none', random: true, straight: false, out_mode: 'out' }
            },
            interactivity: {
                detect_on: 'canvas',
                events: {
                    onhover: { enable: true, mode: 'repulse' },
                    onclick: { enable: true, mode: 'push' }
                }
            },
            retina_detect: true
        });
    </script>
</body>
</html>