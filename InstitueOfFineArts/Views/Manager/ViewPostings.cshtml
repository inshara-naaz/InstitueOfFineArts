@model IEnumerable<InstituteOfFineArts.Models.Submission>
@using InstituteOfFineArts.Models

@{
    ViewData["Title"] = "Manager View Postings";

    var submissions = Model ?? Enumerable.Empty<Submission>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>View Postings | Manager | ARTISTIC Institute</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;400;500;600;700;800&family=Playfair+Display:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body.dark-mode {
            background: #0A0A0A;
            color: #FFFFFF;
        }

        body.light-mode {
            background: #F0F2F5;
            color: #1A1A1A;
        }

        .app-wrapper {
            display: flex;
            min-height: 100vh;
            position: relative;
        }

        .sidebar {
            position: fixed;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            width: 70px;
            border-radius: 40px;
            transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
            z-index: 1000;
            overflow: hidden;
            backdrop-filter: blur(12px);
        }

            .sidebar:hover {
                width: 260px;
                border-radius: 28px;
            }

        body.dark-mode .sidebar {
            background: rgba(20, 20, 30, 0.9);
            border: 1px solid rgba(197, 160, 89, 0.15);
            box-shadow: 0 20px 40px rgba(0,0,0,0.3);
        }

        body.light-mode .sidebar {
            background: rgba(255, 255, 255, 0.95);
            border: 1px solid rgba(0,0,0,0.08);
            box-shadow: 0 20px 40px rgba(0,0,0,0.08);
        }

        @@media (max-width: 992px) {
            .sidebar {
                left: -70px;
                top: 50%;
                transform: translateY(-50%);
            }

                .sidebar.active {
                    left: 20px;
                }

            .menu-toggle {
                display: block !important;
            }

            .main-content {
                margin-left: 0 !important;
                width: 100%;
                padding: 16px !important;
            }
        }

        .sidebar-inner {
            padding: 24px 0;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        .sidebar-profile {
            width: 100%;
            text-align: center;
            padding: 0 0 20px 0;
            margin-bottom: 20px;
            border-bottom: 1px solid;
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .sidebar-profile:hover {
                opacity: 0.8;
            }

        body.dark-mode .sidebar-profile {
            border-color: rgba(255,255,255,0.08);
        }

        body.light-mode .sidebar-profile {
            border-color: rgba(0,0,0,0.06);
        }

        .profile-avatar {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg, #C5A059, #E8C87A);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            color: #000;
            transition: all 0.3s ease;
        }

        .sidebar:hover .profile-avatar {
            width: 50px;
            height: 50px;
            font-size: 1.4rem;
        }

        .profile-name {
            margin-top: 10px;
            font-size: 0;
            opacity: 0;
            transition: all 0.3s ease;
            white-space: nowrap;
        }

        .sidebar:hover .profile-name {
            font-size: 0.85rem;
            opacity: 1;
            margin-top: 12px;
        }

        .profile-role {
            font-size: 0;
            opacity: 0;
            transition: all 0.3s ease;
            white-space: nowrap;
        }

        .sidebar:hover .profile-role {
            font-size: 0.65rem;
            opacity: 0.6;
            margin-top: 4px;
        }

        .nav-menu {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 6px;
            padding: 0 12px;
        }

        .nav-item {
            width: 100%;
            border-radius: 30px;
            transition: all 0.25s ease;
        }

            .nav-item a {
                display: flex;
                align-items: center;
                gap: 16px;
                padding: 12px;
                text-decoration: none;
                border-radius: 30px;
                transition: all 0.25s ease;
                font-weight: 500;
                white-space: nowrap;
            }

                .nav-item a i {
                    width: 28px;
                    height: 28px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 1.1rem;
                    color: #C5A059;
                    flex-shrink: 0;
                }

        .nav-text {
            font-size: 0;
            opacity: 0;
            transition: all 0.3s ease;
            overflow: hidden;
        }

        .sidebar:hover .nav-text {
            font-size: 0.85rem;
            opacity: 1;
        }

        body.dark-mode .nav-item a {
            color: rgba(255,255,255,0.7);
        }

        body.light-mode .nav-item a {
            color: #4A5568;
        }

        .nav-item:hover a {
            transform: translateX(4px);
        }

        body.dark-mode .nav-item:hover a {
            background: rgba(197, 160, 89, 0.12);
            color: #C5A059;
        }

        body.light-mode .nav-item:hover a {
            background: rgba(197, 160, 89, 0.08);
            color: #C5A059;
        }

        body.dark-mode .nav-item.active a {
            background: rgba(197,160,89,0.18);
            color: #C5A059;
        }

        body.light-mode .nav-item.active a {
            background: rgba(197,160,89,0.12);
            color: #C5A059;
        }

        .nav-footer {
            width: 100%;
            margin-top: 30px;
            padding: 20px 12px 0;
            border-top: 1px solid;
        }

        body.dark-mode .nav-footer {
            border-color: rgba(255,255,255,0.08);
        }

        body.light-mode .nav-footer {
            border-color: rgba(0,0,0,0.06);
        }

        .logout-item {
            width: 100%;
            border-radius: 30px;
        }

            .logout-item a {
                display: flex;
                align-items: center;
                gap: 16px;
                padding: 12px;
                text-decoration: none;
                border-radius: 30px;
                transition: all 0.25s ease;
                white-space: nowrap;
            }

                .logout-item a i {
                    width: 28px;
                    font-size: 1.1rem;
                    flex-shrink: 0;
                    color: #E53E3E;
                }

        body.dark-mode .logout-item a {
            color: rgba(255,255,255,0.7);
        }

        body.light-mode .logout-item a {
            color: #E53E3E;
        }

        .logout-text {
            font-size: 0;
            opacity: 0;
            transition: all 0.3s ease;
        }

        .sidebar:hover .logout-text {
            font-size: 0.85rem;
            opacity: 1;
        }

        .logout-item:hover a {
            transform: translateX(4px);
        }

        .main-content {
            flex: 1;
            margin-left: 100px;
            padding: 24px 32px;
            overflow-x: hidden;
            transition: all 0.3s ease;
        }

        @@media (max-width: 992px) {
            .main-content {
                margin-left: 0;
            }
        }

        .top-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            padding: 12px 24px;
            border-radius: 24px;
            margin-bottom: 28px;
        }

        body.dark-mode .top-header {
            background: rgba(20, 20, 20, 0.7);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.05);
        }

        body.light-mode .top-header {
            background: #FFFFFF;
            border: 1px solid #E8ECEF;
            box-shadow: 0 2px 8px rgba(0,0,0,0.02);
        }

        .menu-toggle {
            display: none;
            background: transparent;
            border: none;
            font-size: 1.4rem;
            cursor: pointer;
            padding: 8px 12px;
            border-radius: 12px;
        }

        body.dark-mode .menu-toggle {
            color: white;
        }

        body.light-mode .menu-toggle {
            color: #333;
        }

        .page-title h2 {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            font-weight: 700;
        }

        .page-title p {
            font-size: 0.8rem;
            opacity: 0.7;
        }

        .theme-toggle {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        body.dark-mode .theme-toggle {
            background: rgba(255,255,255,0.08);
            color: #FFD700;
        }

        body.light-mode .theme-toggle {
            background: #F0F2F5;
            color: #C5A059;
        }

        .theme-toggle:hover {
            transform: rotate(15deg);
        }

        .user-dropdown {
            position: relative;
            cursor: pointer;
        }

        .user-avatar {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg, #C5A059, #E8C87A);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            color: #000;
        }

        .dropdown-menu-custom {
            position: absolute;
            top: 50px;
            right: 0;
            min-width: 160px;
            border-radius: 16px;
            padding: 8px;
            display: none;
            z-index: 100;
        }

        body.dark-mode .dropdown-menu-custom {
            background: #1A1A2E;
            border: 1px solid rgba(197,160,89,0.2);
        }

        body.light-mode .dropdown-menu-custom {
            background: white;
            border: 1px solid #E8ECEF;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        .user-dropdown:hover .dropdown-menu-custom {
            display: block;
        }

        .dropdown-item {
            padding: 10px 14px;
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            border-radius: 12px;
            transition: 0.2s;
        }

        body.dark-mode .dropdown-item {
            color: white;
        }

        body.light-mode .dropdown-item {
            color: #333;
        }

        .dropdown-item:hover {
            background: rgba(197, 160, 89, 0.15);
        }

        .chart-card, .recent-table {
            border-radius: 24px;
            padding: 1.5rem;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            height: 100%;
        }

        body.dark-mode .chart-card, body.dark-mode .recent-table {
            background: rgba(20, 20, 20, 0.7);
            border: 1px solid rgba(255,255,255,0.05);
            box-shadow: 0 8px 32px rgba(0,0,0,0.3), inset 0 1px 0 rgba(255,255,255,0.05);
        }

        body.light-mode .chart-card, body.light-mode .recent-table {
            background: #FFFFFF;
            border: 1px solid #E8ECEF;
            box-shadow: 0 4px 20px rgba(0,0,0,0.06), inset 0 1px 0 rgba(255,255,255,0.8);
        }

        .chart-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 40px rgba(197,160,89,0.12);
        }

        .chart-title {
            font-weight: 600;
            margin-bottom: 1.2rem;
            color: #C5A059;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 1.1rem;
        }

        .filter-bar {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 24px;
            align-items: center;
        }

        .filter-select, .filter-input {
            padding: 8px 16px;
            border-radius: 30px;
            border: 1px solid;
            background: transparent;
        }

        body.dark-mode .filter-select, body.dark-mode .filter-input {
            border-color: rgba(255,255,255,0.2);
            color: white;
        }

        body.light-mode .filter-select, body.light-mode .filter-input {
            border-color: #CED4DA;
            color: #333;
            background: white;
        }

        .filter-select:focus, .filter-input:focus {
            outline: none;
            border-color: #C5A059;
        }

        .table-custom {
            width: 100%;
            border-collapse: collapse;
        }

            .table-custom th, .table-custom td {
                padding: 0.8rem 0.5rem;
                text-align: left;
                border-bottom: 1px solid;
            }

        body.dark-mode .table-custom th, body.dark-mode .table-custom td {
            border-color: rgba(255,255,255,0.06);
        }

        body.light-mode .table-custom th, body.light-mode .table-custom td {
            border-color: #E8ECEF;
        }

        .table-custom th {
            color: #C5A059;
            font-weight: 600;
        }

        .table-custom tbody tr {
            transition: all 0.2s ease;
            cursor: pointer;
        }

            .table-custom tbody tr:hover {
                background: rgba(197,160,89,0.05);
                transform: scale(1.005);
            }

        .badge-status {
            padding: 0.2rem 0.7rem;
            border-radius: 30px;
            font-size: 0.7rem;
            font-weight: 600;
            display: inline-block;
        }

        .badge-pending {
            background: #ffc107;
            color: #000;
        }

        .badge-approved {
            background: #28a745;
            color: white;
        }

        .badge-rejected {
            background: #dc3545;
            color: white;
        }

        .btn-sm {
            background: linear-gradient(135deg, #C5A059, #E8C87A);
            border: none;
            padding: 0.25rem 0.8rem;
            border-radius: 20px;
            color: #000;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            margin: 0 0.2rem;
        }

        .btn-sm-outline {
            background: transparent;
            border: 1px solid #C5A059;
            color: #C5A059;
            padding: 0.25rem 0.8rem;
            border-radius: 20px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .btn-sm:hover, .btn-sm-outline:hover {
                transform: scale(1.05);
                box-shadow: 0 4px 12px rgba(197,160,89,0.3);
            }

        .footer {
            padding: 1rem;
            margin-top: 2rem;
            text-align: center;
            border-radius: 20px;
            font-size: 0.7rem;
        }

        body.dark-mode .footer {
            background: rgba(20, 20, 20, 0.5);
            color: rgba(255,255,255,0.4);
        }

        body.light-mode .footer {
            background: #FFFFFF;
            color: #8A8A8A;
            border: 1px solid #E8ECEF;
        }

        .scroll-top {
            position: fixed;
            bottom: 20px;
            right: 20px;
            width: 45px;
            height: 45px;
            background: linear-gradient(135deg, #C5A059, #E8C87A);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
            border: none;
            z-index: 999;
        }

            .scroll-top.show {
                opacity: 1;
                visibility: visible;
            }

            .scroll-top:hover {
                transform: scale(1.1) translateY(-3px);
                box-shadow: 0 8px 20px rgba(197,160,89,0.4);
            }

        .modal-custom {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.7);
            backdrop-filter: blur(8px);
            z-index: 2000;
            align-items: center;
            justify-content: center;
        }

            .modal-custom.active {
                display: flex;
            }

        .modal-content-custom {
            width: 90%;
            max-width: 600px;
            border-radius: 28px;
            padding: 2rem;
            position: relative;
        }

        body.dark-mode .modal-content-custom {
            background: #1A1A2E;
            border: 1px solid rgba(197,160,89,0.2);
        }

        body.light-mode .modal-content-custom {
            background: white;
            border: 1px solid #E8ECEF;
        }

        .modal-close {
            position: absolute;
            top: 15px;
            right: 20px;
            font-size: 1.5rem;
            cursor: pointer;
            background: none;
            border: none;
        }

        body.dark-mode .modal-close {
            color: white;
        }

        body.light-mode .modal-close {
            color: #1A1A1A;
        }

        .btn-gold {
            background: linear-gradient(135deg, #C5A059, #E8C87A);
            color: #000;
            border: none;
            padding: 0.6rem 1.5rem;
            border-radius: 50px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .btn-gold:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(197,160,89,0.3);
            }

        /* Light Mode Text Fixes */
        body.light-mode .table-custom td {
            color: #1A1A1A !important;
        }

        body.light-mode .page-title h2,
        body.light-mode .page-title p {
            color: #1A1A1A !important;
        }
    </style>
</head>
<body class="dark-mode">

    <div class="app-wrapper">
        <div class="sidebar">
            <div class="sidebar-inner">
                <div class="sidebar-profile" onclick="goToDashboard()">
                    <div class="profile-avatar"><i class="fas fa-chalkboard-user"></i></div>
                    <div class="profile-name">ARTISTIC</div>
                    <div class="profile-role">Manager Panel</div>
                </div>
                <div class="nav-menu">
                    <div class="nav-item">
                        <a href="@Url.Action("Dashboard", "Manager")">
                            <i class="fas fa-home"></i>
                            <span class="nav-text">Dashboard</span>
                        </a>
                    </div>
                    <div class="nav-item active">
                        <a href="@Url.Action("ViewPostings", "Manager")">
                            <i class="fas fa-eye"></i>
                            <span class="nav-text">View Postings</span>
                        </a>
                    </div>
                    <div class="nav-item">
                        <a href="@Url.Action("Reports", "Manager")">
                            <i class="fas fa-chart-simple"></i>
                            <span class="nav-text">Reports</span>
                        </a>
                    </div>
                </div>
                <div class="nav-footer">
                    <div class="logout-item">
                        <a href="#" onclick="logout()">
                            <i class="fas fa-sign-out-alt"></i>
                            <span class="logout-text">Logout</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="main-content">
            <div class="top-header">
                <button class="menu-toggle" id="menuToggle"><i class="fas fa-bars"></i></button>
                <div class="page-title">
                    <h2>View Postings</h2>
                    <p>Review, filter, and manage all student submissions.</p>
                </div>
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <div class="theme-toggle" id="themeToggle">
                        <i class="fas fa-sun" id="themeIcon"></i>
                    </div>
                    <div class="user-dropdown">
                        <div class="user-avatar"><i class="fas fa-user-tie"></i></div>
                        <div class="dropdown-menu-custom">
                            <a href="#" class="dropdown-item" onclick="logout()"><i class="fas fa-sign-out-alt"></i> Logout</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="container-fluid mt-4">
                <div class="chart-card">
                    <div class="chart-title"><i class="fas fa-filter"></i> Filter Submissions</div>
                    <div class="filter-bar">
                        <select id="statusFilter" class="filter-select">
                            <option value="all">All Status</option>
                            <option value="Pending">Pending</option>
                            <option value="Approved">Approved</option>
                            <option value="Rejected">Rejected</option>
                        </select>
                        <select id="categoryFilter" class="filter-select">
                            <option value="all">All Competitions</option>
                            @foreach (var competition in submissions.Where(x => x.Competition != null).Select(x => x.Competition!.Title).Distinct())
                            {
                                <option value="@competition">@competition</option>
                            }
                        </select>
                        <input type="text" id="searchStudent" class="filter-input" placeholder="Search by student name...">
                        <button class="btn-sm" onclick="filterTable()">Apply Filters</button>
                        <button class="btn-sm-outline" onclick="resetFilters()">Reset</button>
                    </div>

                    <div class="table-responsive">
                        <table class="table-custom" id="postingsTable">
                            <thead>
                                <tr>
                                    <th>Student</th>
                                    <th>Artwork Title</th>
                                    <th>Category</th>
                                    <th>Submitted On</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="tableBody">
                                @if (submissions.Any())
                                {
                                    foreach (var item in submissions)
                                    {
                                        var studentName = item.Student != null ? (item.Student.FirstName + " " + item.Student.LastName) : "Unknown";
                                        var competitionTitle = item.Competition != null ? item.Competition.Title : "N/A";
                                        var displayStatus = item.Grade == SubmissionGrade.Pending ? "Pending"
                                        : item.Grade == SubmissionGrade.Disqualified ? "Rejected"
                                        : "Approved";
                                        var badgeClass = displayStatus == "Pending" ? "badge-pending"
                                        : displayStatus == "Rejected" ? "badge-rejected"
                                        : "badge-approved";

                                        <tr data-status="@displayStatus" data-category="@competitionTitle" onclick="openModal('postingModal_@item.SubmissionId')" style="cursor:pointer">
                                            <td>@studentName</td>
                                            <td>@item.PaintingTitle</td>
                                            <td>@competitionTitle</td>
                                            <td>@item.SubmittedAt.ToString("MMM dd, yyyy")</td>
                                            <td><span class="badge-status @badgeClass">@displayStatus</span></td>
                                            <td onclick="event.stopPropagation()">
                                                <button type="button" class="btn-sm" onclick="openModal('postingModal_@item.SubmissionId')">View</button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" style="text-align:center; padding:2rem;">No postings/submissions found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="footer">
                <p>© 2025 ARTISTIC - Institute of Fine Arts. Manager Control Hub.</p>
            </div>
        </div>
    </div>

    @if (submissions.Any())
    {
        foreach (var item in submissions)
        {
            var studentName = item.Student != null ? (item.Student.FirstName + " " + item.Student.LastName) : "Unknown";
            var competitionTitle = item.Competition != null ? item.Competition.Title : "N/A";

            <div class="modal-custom" id="postingModal_@item.SubmissionId">
                <div class="modal-content-custom">
                    <button class="modal-close" onclick="closeModal('postingModal_@item.SubmissionId')">&times;</button>
                    <h3 style="color:#C5A059; margin-bottom: 1rem;">Posting Details</h3>
                    <p><strong>Student:</strong> @studentName</p>
                    <p><strong>Competition:</strong> @competitionTitle</p>
                    <p><strong>Artwork Title:</strong> @item.PaintingTitle</p>
                    <p><strong>Submitted On:</strong> @item.SubmittedAt.ToString("MMM dd, yyyy hh:mm tt")</p>
                    <p><strong>Status/Grade:</strong> @item.Grade</p>
                    @if (!string.IsNullOrWhiteSpace(item.AccompanyingText))
                    {
                        <p><strong>Text:</strong> @item.AccompanyingText</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.CreativeDescription))
                    {
                        <p><strong>Description:</strong> @item.CreativeDescription</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.ImageFilePath))
                    {
                        <div style="margin-top: 1rem;">
                            <img src="@item.ImageFilePath" alt="@item.PaintingTitle" style="max-width:100%; border-radius:16px;" />
                        </div>
                    }
                    <div style="margin-top: 1.5rem;">
                        <button type="button" class="btn-gold" onclick="closeModal('postingModal_@item.SubmissionId')">Close</button>
                    </div>
                </div>
            </div>
        }
    }

    <button class="scroll-top" id="scrollTop"><i class="fas fa-arrow-up"></i></button>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // ===== DARK/LIGHT MODE TOGGLE =====
        const themeToggle = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');
        const body = document.body;

        if (localStorage.getItem('managerTheme') === 'light') {
            body.classList.remove('dark-mode');
            body.classList.add('light-mode');
            if (themeIcon) themeIcon.classList.replace('fa-sun', 'fa-moon');
        }

        if (themeToggle) {
            themeToggle.addEventListener('click', () => {
                if (body.classList.contains('dark-mode')) {
                    body.classList.replace('dark-mode', 'light-mode');
                    localStorage.setItem('managerTheme', 'light');
                    if (themeIcon) themeIcon.classList.replace('fa-sun', 'fa-moon');
                } else {
                    body.classList.replace('light-mode', 'dark-mode');
                    localStorage.setItem('managerTheme', 'dark');
                    if (themeIcon) themeIcon.classList.replace('fa-moon', 'fa-sun');
                }
            });
        }

        // Menu Toggle
        const menuToggle = document.getElementById('menuToggle');
        if (menuToggle) {
            menuToggle.addEventListener('click', () => {
                document.querySelector('.sidebar').classList.toggle('active');
            });
        }

        // Scroll to top
        const scrollBtn = document.getElementById('scrollTop');
        if (scrollBtn) {
            window.addEventListener('scroll', () => {
                scrollBtn.classList.toggle('show', window.scrollY > 300);
            });
            scrollBtn.addEventListener('click', () => {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        }

        // Filter Functions
        function filterTable() {
            const status = document.getElementById('statusFilter')?.value || 'all';
            const category = document.getElementById('categoryFilter')?.value || 'all';
            const search = (document.getElementById('searchStudent')?.value || '').toLowerCase();

            document.querySelectorAll('#postingsTable tbody tr').forEach(row => {
                const cells = row.querySelectorAll('td');
                if (cells.length < 5) return;

                const student = (cells[0].innerText || '').toLowerCase();
                const rowStatus = row.getAttribute('data-status') || cells[4].innerText.trim();
                const rowCategory = row.getAttribute('data-category') || cells[2].innerText.trim();

                const statusOk = status === 'all' || rowStatus === status;
                const categoryOk = category === 'all' || rowCategory === category;
                const searchOk = student.includes(search);

                row.style.display = (statusOk && categoryOk && searchOk) ? '' : 'none';
            });
        }

        function resetFilters() {
            if (document.getElementById('statusFilter')) document.getElementById('statusFilter').value = 'all';
            if (document.getElementById('categoryFilter')) document.getElementById('categoryFilter').value = 'all';
            if (document.getElementById('searchStudent')) document.getElementById('searchStudent').value = '';
            filterTable();
        }

        function openModal(id) {
            const modal = document.getElementById(id);
            if (modal) modal.classList.add('active');
        }

        function closeModal(id) {
            const modal = document.getElementById(id);
            if (modal) modal.classList.remove('active');
        }

        function goToDashboard() {
            window.location.href = '@Url.Action("Dashboard", "Manager")';
        }

        function logout() {
            window.location.href = '@Url.Action("Login", "Account")';
        }
    </script>
</body>
</html>